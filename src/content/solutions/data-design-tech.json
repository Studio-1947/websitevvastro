{
 "title": "Data, Design & Tech Solutions | Studio 1947",
 "description": "Data analysis, BI dashboards, AI/ML workflows, cloud and DevOps, web and app development, UI/UX and design systems from Studio 1947.",
 "ogTitle": "Data, Design & Tech Solutions | Studio 1947",
 "ogDescription": "From evidence to interfaces to shipped products, twelve data, design and technology capabilities from Darjeeling.",
 "ogType": "website",
 "bodyClass": "page-solcat",
 "styles": "",
 "html": "<main>\n    <!-- Hero -->\n    <section class=\"cat-hero container\" data-stagger>\n      <p class=\"cat-hero__eyebrow\" data-i18n=\"global.dd.solutions.dataDesignTech\">Data, Design &amp; Tech</p>\n      <h1>From evidence to interfaces to shipped products.</h1>\n      <p class=\"cat-hero__sub\" data-i18n=\"solutions.ddt.heroSub\">Twelve services across data, design and engineering. We help organisations turn raw information into decisions, and decisions into products people actually use.</p>\n      <div class=\"cat-hero__cta\">\n        <a class=\"btn-hello btn-primary\" href=\"/sayhello/\"><span data-i18n=\"solutions.shared.bookCall\">Book a conversation</span> <span class=\"arrow\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></a>\n        <a class=\"btn-hello\" href=\"/our-work/\"><span data-i18n=\"solutions.shared.seeWork\">See our work</span> <span class=\"arrow\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></a>\n      </div>\n    </section>\n\n    <!-- Capabilities -->\n    <section class=\"section container\">\n      <div class=\"cat-section__head\">\n        <p class=\"cat-section__eyebrow reveal\" data-i18n=\"solutions.shared.whatWeDo\">What we do</p>\n        <h2 class=\"cat-section__title reveal\" data-i18n=\"solutions.shared.capabilities\">Capabilities</h2>\n        <p class=\"cat-section__sub reveal\">Everything from data to finished product, delivered by one team working alongside you.</p>\n      </div>\n      <div class=\"cat-grid\" data-stagger>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_ee896efcbb994252881ec513e5a02b91.webp\" alt=\"Data Analysis illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc1.t\">Data Analysis</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc1.d\">Make decisions based on insights from your data.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_52aa1927b0d2463199de48ed613da642.webp\" alt=\"BI Dashboards illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc2.t\">BI Dashboards</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc2.d\">See your metrics clearly on interactive dashboards.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_424fffb6d6764e1cb54c6cd89a7a8a05.webp\" alt=\"Data Cleaning illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc3.t\">Data Cleaning</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc3.d\">Tidy datasets so analysis is accurate and reliable.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_ff6925ff181b494f864384ade3b80723.webp\" alt=\"Data Collections illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc4.t\">Data Collections</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc4.d\">Gather the data you need to reach your goals.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_5a3d80dcbd9047e1998998185dff05d9.webp\" alt=\"AI/ML Workflows illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc5.t\">AI/ML Workflows</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc5.d\">Automate workflows and open up new possibilities with AI.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_8a26b7967f1b4e7487ab650f979f28a9.webp\" alt=\"Recommender illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc6.t\">Recommender</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc6.d\">Personalise what users see using predictive models.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_19fd84b8487248e7ae3b72c18417364d.webp\" alt=\"Database Design illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc7.t\">Database Design</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc7.d\">Build secure databases that grow with you and perform reliably.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_8be98116aa3c4dfeacf0e018e272ff08.webp\" alt=\"Cloud &amp; Devops illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc8.t\">Cloud &amp; Devops</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc8.d\">Set up cloud infrastructure that runs smoothly and grows with you.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_f1e79bdc65b64d30a17c1392dd978266.webp\" alt=\"Web/App Development illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc9.t\">Web/App Development</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc9.d\">Build responsive web apps that feel smooth to use.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_cd93dd7bfb014566a9505503dc90e68e.webp\" alt=\"UI/UX Design illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc10.t\">UI/UX Design</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc10.d\">Design user journeys that feel natural and get results.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_e0e141966a2a441aa9fcd252664138bb.webp\" alt=\"Design Systems illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc11.t\">Design Systems</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc11.d\">Set shared standards so product design stays consistent as you grow.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/8292e9_2b5ddafa93f444448ac2b06c15e05012.webp\" alt=\"Service Blueprints illustration\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.ddt.svc12.t\">Service Blueprints</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.ddt.svc12.d\">Improve how a service works end to end so people stay engaged.</p></div>\n          </article>\n      </div>\n    </section>\n\n    <!-- Process -->\n    <section class=\"section container\" style=\"padding-top:0\">\n      <div class=\"cat-section__head\">\n        <p class=\"cat-section__eyebrow reveal\" data-i18n=\"solutions.shared.howWeWork\">How we work</p>\n        <h2 class=\"cat-section__title reveal\" data-i18n=\"solutions.shared.ourApproach\">Our approach</h2>\n        <p class=\"cat-section__sub reveal\">There's no fixed order: these four steps connect in every direction. Start wherever you are, and we move through the rest as the work needs.</p>\n        <span class=\"cat-cycle__badge reveal\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12a9 9 0 1 1 3 6.7\"/><path d=\"M3 21v-5h5\"/></svg> <span data-i18n=\"solutions.shared.loopBadge\">Start anywhere: it&rsquo;s a loop</span></span>\n      </div>\n      <div class=\"cat-cycle reveal\">\n        <div class=\"cat-cycle__node\">\n          <span class=\"cat-cycle__ico\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m21 21-4.3-4.3\"/></svg></span>\n          <h3 data-i18n=\"solutions.stepA.understand.title\">Understand</h3>\n          <p data-i18n=\"solutions.ddt.step.understand\">We find out what's really behind a challenge through research, data collection, monitoring and evaluation, GIS mapping and analytics.</p>\n        </div>\n        <span class=\"cat-cycle__link\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 8l-4 4 4 4\"/><path d=\"M17 8l4 4-4 4\"/><path d=\"M3 12h18\"/></svg></span>\n        <div class=\"cat-cycle__node\">\n          <span class=\"cat-cycle__ico\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z\"/></svg></span>\n          <h3 data-i18n=\"solutions.stepA.design.title\">Design</h3>\n          <p data-i18n=\"solutions.ddt.step.design\">Insights become clear data models, dashboards and interfaces, designed for the people who actually use them.</p>\n        </div>\n        <span class=\"cat-cycle__link\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 8l-4 4 4 4\"/><path d=\"M17 8l4 4-4 4\"/><path d=\"M3 12h18\"/></svg></span>\n        <div class=\"cat-cycle__node\">\n          <span class=\"cat-cycle__ico\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><path d=\"M3.3 7 12 12l8.7-5M12 22V12\"/></svg></span>\n          <h3 data-i18n=\"solutions.stepA.build.title\">Build</h3>\n          <p data-i18n=\"solutions.ddt.step.build\">We build the websites, dashboards, data pipelines and AI-integrated products that make the plan real.</p>\n        </div>\n        <span class=\"cat-cycle__link\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 8l-4 4 4 4\"/><path d=\"M17 8l4 4-4 4\"/><path d=\"M3 12h18\"/></svg></span>\n        <div class=\"cat-cycle__node\">\n          <span class=\"cat-cycle__ico\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 17l6-6 4 4 8-8\"/><path d=\"M17 7h4v4\"/></svg></span>\n          <h3 data-i18n=\"solutions.stepA.grow.title\">Grow</h3>\n          <p data-i18n=\"solutions.ddt.step.grow\">We measure outcomes and keep improving, turning a working platform into lasting, measurable impact.</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- Selected work -->\n    <section class=\"section container\" style=\"padding-top:0\">\n      <div class=\"cat-section__head\">\n        <p class=\"cat-section__eyebrow reveal\" data-i18n=\"solutions.shared.proof\">Proof</p>\n        <h2 class=\"cat-section__title reveal\" data-i18n=\"solutions.shared.selectedWork\">Selected work</h2>\n      </div>\n      <div class=\"cat-workgrid\" data-stagger>\n          <!-- HIDDEN: awaiting real card artwork (radha-madhav). Restore by removing this comment wrapper.\n<a class=\"cat-work\" href=\"/work/radha-madhav/\">\n            <div class=\"cat-work__media\"><img src=\"/assets/img/our-work/cae547e4969f4e97ad4bc0472fd64435.webp\" alt=\"Radha Madhav: Studio 1947 project\" loading=\"lazy\"></div>\n            <h3 class=\"cat-work__title\">Radha Madhav</h3>\n            <p class=\"cat-work__desc\">Offline-first inventory dashboard for a medical shop</p>\n            <span class=\"cat-work__link\">View project\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n-->\n          <!-- HIDDEN: awaiting real card artwork (healix). Restore by removing this comment wrapper.\n<a class=\"cat-work\" href=\"/work/healix/\">\n            <div class=\"cat-work__media\"><img src=\"/assets/img/our-work/cae547e4969f4e97ad4bc0472fd64435.webp\" alt=\"Healix: Studio 1947 project\" loading=\"lazy\"></div>\n            <h3 class=\"cat-work__title\">Healix</h3>\n            <p class=\"cat-work__desc\">Brand and identity for rural healthcare</p>\n            <span class=\"cat-work__link\">View project\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n-->\n          <a class=\"cat-work\" href=\"/work/mirik-college/\">\n            <div class=\"cat-work__media\"><img src=\"/assets/img/our-work/40ad50_1c7d55c88a3f421f9bff620f20028e04.webp\" alt=\"Mirik College: Studio 1947 project\" loading=\"lazy\"></div>\n            <h3 class=\"cat-work__title\">Mirik College</h3>\n            <p class=\"cat-work__desc\">Field research and survey collaboration</p>\n            <span class=\"cat-work__link\">View project\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n          <a class=\"cat-work\" href=\"/work/rajkamal-prakashan/\">\n            <div class=\"cat-work__media\"><img src=\"/assets/img/our-work/40ad50_3a43f4736c594efd9b398587d935615f.webp\" alt=\"Rajkamal Prakashan: Studio 1947 project\" loading=\"lazy\"></div>\n            <h3 class=\"cat-work__title\">Rajkamal Prakashan</h3>\n            <p class=\"cat-work__desc\">Brand rules, digital product and events for India's largest Hindi publisher</p>\n            <span class=\"cat-work__link\">View project\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n          <a class=\"cat-work\" href=\"/work/elegant-sip/\">\n            <div class=\"cat-work__media\"><img src=\"/assets/img/our-work/elegant-sip-thumb.webp\" alt=\"Elegant Sip: Studio 1947 project\" loading=\"lazy\"></div>\n            <h3 class=\"cat-work__title\">Elegant Sip</h3>\n            <p class=\"cat-work__desc\">D2C store, packaging and online growth for a Darjeeling tea brand</p>\n            <span class=\"cat-work__link\">View project\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n          <a class=\"cat-work\" href=\"/work/prokritir-group/\">\n            <div class=\"cat-work__media\"><img src=\"/assets/img/our-work/prokritir-group-thumb.webp\" alt=\"Prokritir Group: Studio 1947 project\" loading=\"lazy\"></div>\n            <h3 class=\"cat-work__title\">Prokritir Group</h3>\n            <p class=\"cat-work__desc\">Brand, packaging and technology for a water and spices group</p>\n            <span class=\"cat-work__link\">View project\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n      </div>\n    </section>\n\n    <!-- Related -->\n    <section class=\"section container\" style=\"padding-top:0\">\n      <div class=\"cat-section__head\">\n        <p class=\"cat-section__eyebrow reveal\" data-i18n=\"solutions.shared.keepExploring\">Keep exploring</p>\n        <h2 class=\"cat-section__title reveal\" data-i18n=\"solutions.shared.relatedSolutions\">Related solutions</h2>\n      </div>\n      <div class=\"cat-related reveal\">\n          <a class=\"cat-related__item\" href=\"/solutions/communication-campaign/\">Communication &amp; Campaign<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n          <a class=\"cat-related__item\" href=\"/solutions/research-survey/\">Research &amp; Survey<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width