{
 "title": "Communication & Campaign Solutions | Studio 1947",
 "description": "Brand strategy, social media storytelling, marketing and awareness campaigns, lead generation, graphic design and more, by Studio 1947.",
 "ogTitle": "Communication & Campaign Solutions | Studio 1947",
 "ogDescription": "Brand strategy, storytelling and campaigns that turn attention into engagement, community and measurable growth.",
 "ogType": "website",
 "bodyClass": "page-solcat",
 "styles": "",
 "html": "<main>\n    <section class=\"cat-hero container\" data-stagger>\n      <p class=\"cat-hero__eyebrow\" data-i18n=\"global.dd.solutions.commCampaign\">Communication &amp; Campaign</p>\n      <h1>Stories that move people to act.</h1>\n      <p class=\"cat-hero__sub\" data-i18n=\"solutions.cc.heroSub\">Brand strategy, storytelling and campaigns that turn attention into engagement, community and measurable growth.</p>\n      <div class=\"cat-hero__cta\">\n        <a class=\"btn-hello btn-primary\" href=\"/sayhello/\" data-contact-open><span data-i18n=\"solutions.shared.bookCall\">Book a conversation</span> <span class=\"arrow\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></a>\n        <a class=\"btn-hello\" href=\"/our-work/\"><span data-i18n=\"solutions.shared.seeWork\">See our work</span> <span class=\"arrow\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></a>\n      </div>\n    </section>\n\n    <section class=\"section container\">\n      <div class=\"cat-section__head\">\n        <p class=\"cat-section__eyebrow reveal\" data-i18n=\"solutions.shared.whatWeDo\">What we do</p>\n        <h2 class=\"cat-section__title reveal\" data-i18n=\"solutions.shared.capabilities\">Capabilities</h2>\n        <p class=\"cat-section__sub reveal\">Eight things we do across brand, content and campaigns, with one team from planning to delivery.</p>\n      </div>\n      <div class=\"cat-grid\" data-stagger>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/310ca6_d32fa4aa65d84cd4b8d166bdbc632e9d.webp\" alt=\"Brand strategy woodcut icon\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.cc.svc1.t\">Brand Strategy</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.cc.svc1.d\">Set a clear direction for where your brand stands.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/310ca6_1f1dec7962024c908341cb765110697d.webp\" alt=\"Social media storytelling woodcut icon\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.cc.svc2.t\">Social Media Storytelling</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.cc.svc2.d\">Tell stories that build community and reach.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/310ca6_9a422f2038c240c982b63afaf7c5f962.webp\" alt=\"Marketing campaigns woodcut icon\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.cc.svc3.t\">Marketing Campaigns</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.cc.svc3.d\">Run targeted campaigns that bring measurable results.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/310ca6_cc27a6725e9c4b61bba470cfd4bbd99b.webp\" alt=\"Awareness campaigns woodcut icon\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.cc.svc4.t\">Awareness Campaigns</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.cc.svc4.d\">Get your message out to inform people and move them to act.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/310ca6_f257f9b9f73444a8b02b334df83493fa.webp\" alt=\"Leads generation woodcut icon\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.cc.svc5.t\">Leads Generation</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.cc.svc5.d\">Attract the right prospects, using data to guide growth.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/40ad50_ffa072516648469db1757c9a8f4fd600.webp\" alt=\"Social listening woodcut icon\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.cc.svc6.t\">Social Listening</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.cc.svc6.d\">Follow online conversations to learn what people think of your brand.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/310ca6_c452e9bd2e0e40e197701b03e5f015f7.webp\" alt=\"Graphic design woodcut icon\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.cc.svc7.t\">Graphic Design</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.cc.svc7.d\">Create visuals that make your brand identity stronger.</p></div>\n          </article>\n          <article class=\"cat-svc\">\n            <div class=\"cat-svc__media\"><img src=\"/assets/img/solutions/310ca6_bc262947b8974682a9f18da8beb9e64c.webp\" alt=\"Push notifications woodcut icon\" loading=\"lazy\"></div>\n            <div class=\"cat-svc__body\"><h3 class=\"cat-svc__title\" data-i18n=\"solutions.cc.svc8.t\">Push Notifications</h3><p class=\"cat-svc__desc\" data-i18n=\"solutions.cc.svc8.d\">Send personalised messages that keep people engaged and coming back.</p></div>\n          </article>\n      </div>\n    </section>\n\n    <section class=\"section container\" style=\"padding-top:0\">\n      <div class=\"cat-section__head\">\n        <p class=\"cat-section__eyebrow reveal\" data-i18n=\"solutions.shared.howWeWork\">How we work</p>\n        <h2 class=\"cat-section__title reveal\" data-i18n=\"solutions.shared.ourApproach\">Our approach</h2>\n        <p class=\"cat-section__sub reveal\">There's no fixed order: these four steps connect in every direction. Start wherever you are, and we move through the rest as the work needs.</p>\n        <span class=\"cat-cycle__badge reveal\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12a9 9 0 1 1 3 6.7\"/><path d=\"M3 21v-5h5\"/></svg> <span data-i18n=\"solutions.shared.loopBadge\">Start anywhere: it&rsquo;s a loop</span></span>\n      </div>\n      <div class=\"cat-cycle reveal\">\n        <div class=\"cat-cycle__node\">\n          <span class=\"cat-cycle__ico\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m21 21-4.3-4.3\"/></svg></span>\n          <h3 data-i18n=\"solutions.stepB.understand.title\">Understand</h3>\n          <p data-i18n=\"solutions.stepB.understand.desc\">We start with the people and the context: research, listening and evidence before anything else.</p>\n        </div>\n        <span class=\"cat-cycle__link\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 8l-4 4 4 4\"/><path d=\"M17 8l4 4-4 4\"/><path d=\"M3 12h18\"/></svg></span>\n        <div class=\"cat-cycle__node\">\n          <span class=\"cat-cycle__ico\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z\"/></svg></span>\n          <h3 data-i18n=\"solutions.stepB.design.title\">Design</h3>\n          <p data-i18n=\"solutions.stepB.design.desc\">Insights become a clear plan: a strategy, story, research tool or curriculum shaped for the people it's for.</p>\n        </div>\n        <span class=\"cat-cycle__link\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 8l-4 4 4 4\"/><path d=\"M17 8l4 4-4 4\"/><path d=\"M3 12h18\"/></svg></span>\n        <div class=\"cat-cycle__node\">\n          <span class=\"cat-cycle__ico\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><path d=\"M3.3 7 12 12l8.7-5M12 22V12\"/></svg></span>\n          <h3 data-i18n=\"solutions.stepB.deliver.title\">Deliver</h3>\n          <p data-i18n=\"solutions.stepB.deliver.desc\">We produce and run it in the real world: assets, campaigns, studies or sessions.</p>\n        </div>\n        <span class=\"cat-cycle__link\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 8l-4 4 4 4\"/><path d=\"M17 8l4 4-4 4\"/><path d=\"M3 12h18\"/></svg></span>\n        <div class=\"cat-cycle__node\">\n          <span class=\"cat-cycle__ico\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 17l6-6 4 4 8-8\"/><path d=\"M17 7h4v4\"/></svg></span>\n          <h3 data-i18n=\"solutions.stepB.grow.title\">Grow</h3>\n          <p data-i18n=\"solutions.stepB.grow.desc\">We measure what happened and improve on it, so a one-off turns into impact that keeps growing.</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section container\" style=\"padding-top:0\">\n      <div class=\"cat-section__head\">\n        <p class=\"cat-section__eyebrow reveal\" data-i18n=\"solutions.shared.proof\">Proof</p>\n        <h2 class=\"cat-section__title reveal\" data-i18n=\"solutions.shared.selectedWork\">Selected work</h2>\n      </div>\n      <div class=\"cat-workgrid\" data-stagger>\n          <a class=\"cat-work\" href=\"/work/awch/\">\n            <div class=\"cat-work__media\"><img src=\"/assets/img/our-work/40ad50_079b8d8cf4ca4a1b9e0bdc5d98ee4eb5.webp\" alt=\"Avishkar Women & Children Hospital: Studio 1947 project\" loading=\"lazy\"></div>\n            <h3 class=\"cat-work__title\">Avishkar Women &amp; Children Hospital</h3>\n            <p class=\"cat-work__desc\">Branding and campaign creatives for a women & children hospital</p>\n            <span class=\"cat-work__link\">View project\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n          <a class=\"cat-work\" href=\"/work/rajkamal-prakashan/\">\n            <div class=\"cat-work__media\"><img src=\"/assets/img/our-work/40ad50_3a43f4736c594efd9b398587d935615f.webp\" alt=\"Rajkamal Prakashan: Studio 1947 project\" loading=\"lazy\"></div>\n            <h3 class=\"cat-work__title\">Rajkamal Prakashan</h3>\n            <p class=\"cat-work__desc\">Event branding and campaign for a landmark publisher</p>\n            <span class=\"cat-work__link\">View project\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n          <!-- HIDDEN: awaiting real card artwork (mohuna-media). Restore by removing this comment wrapper.\n<a class=\"cat-work\" href=\"/work/mohuna-media/\">\n            <div class=\"cat-work__media\"><img src=\"/assets/img/our-work/cae547e4969f4e97ad4bc0472fd64435.webp\" alt=\"Mohuna Media: Studio 1947 project\" loading=\"lazy\"></div>\n            <h3 class=\"cat-work__title\">Mohuna Media</h3>\n            <p class=\"cat-work__desc\">Brand identity for an Assam journalism initiative</p>\n            <span class=\"cat-work__link\">View project\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n-->\n      </div>\n    </section>\n\n    <section class=\"section container\" style=\"padding-top:0\">\n      <div class=\"cat-section__head\">\n        <p class=\"cat-section__eyebrow reveal\" data-i18n=\"solutions.shared.keepExploring\">Keep exploring</p>\n        <h2 class=\"cat-section__title reveal\" data-i18n=\"solutions.shared.relatedSolutions\">Related solutions</h2>\n      </div>\n      <div class=\"cat-related reveal\">\n          <a class=\"cat-related__item\" href=\"/solutions/data-design-tech/\">Data, Design &amp; Tech<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n          <a class=\"cat-related__item\" href=\"/solutions/research-survey/\">Research &amp; Survey<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n          <a class=\"cat-related__item\" href=\"/solutions/capacity-building/\">Capacity Building<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n      </div>\n    </section>\n  </main>"
