{
  "title": "Aangan | Studio 1947",
  "description": "Aangan by Studio 1947: a web and mobile app that brings together Darjeeling's homestays, trusted local drivers, offbeat locations, culture and biodiversity in one place for travellers.",
  "ogTitle": "Aangan | Studio 1947",
  "ogDescription": "Aangan by Studio 1947: book Darjeeling homestays, hire trusted local drivers and discover offbeat trails, culture and biodiversity, all in one app.",
  "ogType": "website",
  "bodyClass": "pdp pdp-aangan",
  "styles": ".pdp-aangan .pdp-hero__inner { grid-template-columns: 1fr; justify-items: center; text-align: center; } .pdp-aangan .pdp-hero__inner > div:first-child { max-width: 700px; } .pdp-aangan .pdp-hero__sub { margin-inline: auto; } .pdp-aangan .pdp-cta-row { justify-content: center; } .pdp-aangan .pdp-hero__inner > div:last-child { width: 100%; max-width: 760px; }",
  "html": "<main>\n    <!-- Hero -->\n    <section class=\"pdp-hero\">\n      <div class=\"pdp-hero__bg\"></div>\n      <div class=\"container\">\n        <nav class=\"pdp-crumb\" aria-label=\"Breadcrumb\"><a href=\"/products/\">Products</a> <span aria-hidden=\"true\">/</span> <span>Aangan</span></nav>\n        <div class=\"pdp-hero__inner\" data-stagger>\n          <div>\n            <span class=\"pdp-eyebrow\"><span class=\"dot\"></span>Travel &amp; Tourism</span>\n            <h1>Aangan</h1>\n            <p class=\"pdp-hero__sub\">One app for the Darjeeling hills: book verified homestays, hire trusted local drivers, and discover offbeat locations, culture and biodiversity, all in one place.</p>\n            <div class=\"pdp-cta-row\">\n              <a class=\"pdp-btn pdp-btn--primary\" href=\"https://aanganerp.in\" target=\"_blank\" rel=\"noopener\">Visit Aangan <span class=\"a\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17 17 7\"/><path d=\"M8 7h9v9\"/></svg></span></a>\n              <a class=\"pdp-btn pdp-btn--ghost\" href=\"#features\">See features <span class=\"a\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></a>\n            </div>\n            <p class=\"pdp-hero__note\">Already live: book homestays and drivers in Darjeeling &amp; Mirik today.</p>\n          </div>\n          <div><div class=\"pdp-frame\"><img src=\"/assets/img/products/aangan/hero-screenshot.webp\" alt=\"The Aangan homepage: a homestay search bar over a hero photo, with live Darjeeling weather and Kanchenjunga sunrise visibility\" loading=\"lazy\" /></div></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Stats -->\n    <section class=\"section container\" style=\"padding-top:0\">\n      <div class=\"pdp-stats\" data-stagger>\n        <div class=\"pdp-stat\">\n          <div class=\"pdp-stat__num\">7</div>\n          <div class=\"pdp-stat__label\">Categories in one app</div>\n        </div>\n        <div class=\"pdp-stat\">\n          <div class=\"pdp-stat__num\">2</div>\n          <div class=\"pdp-stat__label\">Hill towns covered, and growing</div>\n        </div>\n        <div class=\"pdp-stat\">\n          <div class=\"pdp-stat__num\">Live</div>\n          <div class=\"pdp-stat__label\">Booking homestays &amp; drivers now</div>\n        </div>\n        <div class=\"pdp-stat\">\n          <div class=\"pdp-stat__num\">24/7</div>\n          <div class=\"pdp-stat__label\">On-trip support</div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Features -->\n    <section class=\"section container\" id=\"features\">\n      <div class=\"pdp-head reveal\">\n        <p class=\"k\">Features</p>\n        <h2>Darjeeling, in one app</h2>\n        <p>Everything a traveller needs to explore the hills, and everything a host or driver needs to be found.</p>\n      </div>\n      <div class=\"pdp-features\" data-stagger>\n        <article class=\"pdp-feature\">\n          <span class=\"pdp-feature__ico\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M3 9h18M9 21V9\"/></svg></span>\n          <h3>Homestay booking</h3>\n          <p>Browse and book verified homestays across the Darjeeling hills, with real-time availability and honest host details.</p>\n        </article>\n        <article class=\"pdp-feature\">\n          <span class=\"pdp-feature__ico\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2 2 7l10 5 10-5-10-5Z\"/><path d=\"M2 17l10 5 10-5M2 12l10 5 10-5\"/></svg></span>\n          <h3>Trusted local drivers</h3>\n          <p>Connect with vetted drivers who know every mountain road, from town transfers to full-day treks.</p>\n        </article>\n        <article class=\"pdp-feature\">\n          <span class=\"pdp-feature__ico\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg></span>\n          <h3>Offbeat location guide</h3>\n          <p>Discover lesser-known viewpoints, trails and villages, curated by the people who actually live there.</p>\n        </article>\n        <article class=\"pdp-feature\">\n          <span class=\"pdp-feature__ico\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20h16\"/><path d=\"M7 20V10M12 20V4M17 20v-8\"/></svg></span>\n          <h3>Culture &amp; biodiversity stories</h3>\n          <p>Short, local stories on festivals, crafts, flora and fauna, so you know what you're looking at before you set out.</p>\n        </article>\n        <article class=\"pdp-feature\">\n          <span class=\"pdp-feature__ico\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 11v2a1 1 0 0 0 1 1h3l4.5 4V6L7 10H4a1 1 0 0 0-1 1Z\"/><path d=\"M15.5 8.5a4 4 0 0 1 0 7\"/></svg></span>\n          <h3>One trip itinerary</h3>\n          <p>Homestay stays, driver pickups and detours in a single itinerary that updates as your plans change.</p>\n        </article>\n        <article class=\"pdp-feature\">\n          <span class=\"pdp-feature__ico\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8\"/></svg></span>\n          <h3>Community-first pricing</h3>\n          <p>Fair, transparent pricing that puts more of every booking directly into the hands of hosts and drivers.</p>\n        </article>\n      </div>\n    </section>\n\n    <!-- Deep-dive rows -->\n    <section class=\"section container\" style=\"padding-top:0\">\n      <div class=\"pdp-row reveal\">\n        <div class=\"pdp-row__media\"><div class=\"pdp-frame\"><img src=\"/assets/img/products/aangan/homestays-screenshot.webp\" alt=\"Aangan's homestays listing: Mist &amp; Pine Homestay, Kanchenjunga View Retreat and other verified stays with prices per head\" loading=\"lazy\" /></div></div>\n        <div class=\"pdp-row__body\">\n          <p class=\"k\">For travellers</p>\n          <h3>Everything you need before you set foot in the hills</h3>\n          <p>Aangan puts verified homestays, trusted drivers and curated offbeat trails in one place, so planning a Darjeeling trip stops meaning a dozen unreliable phone numbers and word-of-mouth guesses.</p>\n          <ul class=\"pdp-checks\">\n            <li><span class=\"c\" aria-hidden=\"true\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></span>Verified homestays, not listings copy-pasted from elsewhere</li>\n            <li><span class=\"c\" aria-hidden=\"true\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></span>Drivers who know the roads, weather and detours</li>\n            <li><span class=\"c\" aria-hidden=\"true\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></span>Offbeat spots you won't find on a typical itinerary</li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"pdp-row pdp-row--flip reveal\">\n        <div class=\"pdp-row__media\"><div class=\"pdp-frame\"><img src=\"/assets/img/products/aangan/drivers-screenshot.webp\" alt=\"Aangan's Himalayan Route &amp; Driver Fare Guide: pickup and drop location pickers, distance, travel time and a reference fare range\" loading=\"lazy\" /></div></div>\n        <div class=\"pdp-row__body\">\n          <p class=\"k\">For hosts &amp; drivers</p>\n          <h3>A direct line to travellers who want the real Darjeeling</h3>\n          <p>Homestay owners and drivers list themselves, manage their own bookings and get paid directly, without handing over a cut to a string of middlemen along the way.</p>\n          <ul class=\"pdp-checks\">\n            <li><span class=\"c\" aria-hidden=\"true\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></span>Simple listing, no technical setup required</li>\n            <li><span class=\"c\" aria-hidden=\"true\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></span>Fair commission, paid out directly</li>\n            <li><span class=\"c\" aria-hidden=\"true\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></span>Bookings and messages in one inbox</li>\n          </ul>\n        </div>\n      </div>\n    </section>\n\n    <!-- How it works -->\n    <section class=\"section container\" style=\"padding-top:0\">\n      <div class=\"pdp-head reveal\">\n        <p class=\"k\">How it works</p>\n        <h2>Get started in four steps</h2>\n      </div>\n      <div class=\"pdp-steps\" data-stagger>\n        <div class=\"pdp-step\">\n          <div class=\"pdp-step__n\">01</div>\n          <h3>Explore</h3>\n          <p>Browse homestays, drivers and offbeat spots by region on the web or mobile app.</p>\n        </div>\n        <div class=\"pdp-step\">\n          <div class=\"pdp-step__n\">02</div>\n          <h3>Book</h3>\n          <p>Reserve your stay and driver together in one flow, with clear pricing upfront.</p>\n        </div>\n        <div class=\"pdp-step\">\n          <div class=\"pdp-step__n\">03</div>\n          <h3>Travel</h3>\n          <p>Get on-trip support and local recommendations for culture, food and biodiversity as you go.</p>\n        </div>\n        <div class=\"pdp-step\">\n          <div class=\"pdp-step__n\">04</div>\n          <h3>Share</h3>\n          <p>Leave reviews and stories that help the next traveller, and keep hosts and drivers in view.</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- FAQ -->\n    <section class=\"section container\" style=\"padding-top:0\">\n      <div class=\"pdp-head reveal\"><p class=\"k\">FAQ</p><h2>Questions, answered</h2></div>\n      <div style=\"max-width:820px;margin:0 auto\">\n          <div class=\"faq__item\">\n            <button class=\"faq__q\">What is Aangan?<span class=\"ico\" aria-hidden=\"true\"></span></button>\n            <div class=\"faq__a\"><div class=\"faq__a-inner\"><p>Aangan is a web and mobile app that brings together Darjeeling's homestays, trusted local drivers, offbeat locations, culture and biodiversity in one place for travellers.</p></div></div>\n          </div>\n          <div class=\"faq__item\">\n            <button class=\"faq__q\">Which areas does Aangan cover?<span class=\"ico\" aria-hidden=\"true\"></span></button>\n            <div class=\"faq__a\"><div class=\"faq__a-inner\"><p>We're starting with Mirik, Darjeeling town and the surrounding villages, and expanding across the hills as more homestays and drivers join.</p></div></div>\n          </div>\n          <div class=\"faq__item\">\n            <button class=\"faq__q\">How are homestays and drivers verified?<span class=\"ico\" aria-hidden=\"true\"></span></button>\n            <div class=\"faq__a\"><div class=\"faq__a-inner\"><p>Our local team visits and verifies every listing in person before it goes live on Aangan.</p></div></div>\n          </div>\n          <div class=\"faq__item\">\n            <button class=\"faq__q\">Is Aangan available yet?<span class=\"ico\" aria-hidden=\"true\"></span></button>\n            <div class=\"faq__a\"><div class=\"faq__a-inner\"><p>Yes. Aangan is live at <a href=\"https://aanganerp.in\" target=\"_blank\" rel=\"noopener\">aanganerp.in</a>, already covering Darjeeling town, Mirik and the surrounding villages, with homestays and drivers you can book today. We're still adding more hosts, drivers and offbeat spots as we expand.</p></div></div>\n          </div>\n      </div>\n    </section>\n\n    <!-- Pre-footer CTA -->\n    <section class=\"section container\" style=\"padding-top:0\">\n      <div class=\"pdp-cta reveal\">\n        <h2>See Aangan in action</h2>\n        <p>Visit the live app, or book a walkthrough with our product team to see how Aangan connects travellers with the Darjeeling hills.</p>\n        <div class=\"pdp-cta-row\">\n          <a class=\"pdp-btn pdp-btn--primary\" href=\"https://aanganerp.in\" target=\"_blank\" rel=\"noopener\">Visit Aangan <span class=\"a\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17 17 7\"/><path d=\"M8 7h9v9\"/></svg></span></a>\n          <a class=\"pdp-btn pdp-btn--ghost\" href=\"/sayhello/\" data-contact-open>Book a demo <span class=\"a\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></a>\n        </div>\n      </div>\n    </section>\n  </main>",
  "noindex": false
}
