 "html": "<main class=\"page-products\">\n    <!-- ===== Hero ===== -->\n    <section class=\"prod-hero container\" data-stagger>\n      <p class=\"eyebrow\" style=\"margin-bottom:18px\">For Medical</p>\n      <h1 class=\"prod-hero__title\">Pharma ERP</h1>\n      <p class=\"prod-hero__sub\">Built for pharmaceutical and healthcare businesses</p>\n    </section>\n\n    <section class=\"container\" style=\"padding-bottom: clamp(48px, 6vw, 96px)\">\n      <div class=\"prod-hero__media reveal\">\n        <img src=\"/assets/img/products/40ad50_904851d0999941e9ad00e025071d6af6.webp\" alt=\"Pharma ERP dashboard: daily sales, invoices, low-stock and expiry alerts, revenue trend and quick actions\">\n      </div>\n    </section>\n\n    <!-- ===== Features ===== -->\n    <section class=\"section container\" style=\"padding-top: 0\">\n      <div class=\"prod-head reveal\">\n        <h2>Pharma ERP</h2>\n        <p>Track inventory, sales, procurement and distribution across your healthcare business from one platform.</p>\n      </div>\n\n      <div class=\"feat-grid\" data-stagger>\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2 21 7v10l-9 5-9-5V7Z\"/><path d=\"M12 12 21 7M12 12v10M12 12 3 7\"/></svg>\n          </span>\n          <div>\n            <h3>Inventory &amp; Batch Tracking</h3>\n            <p>Watch stock levels, expiry dates and batch movement in real time.</p>\n          </div>\n        </article>\n\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 17l6-6 4 4 8-8\"/><path d=\"M17 7h4v4\"/></svg>\n          </span>\n          <div>\n            <h3>Sales &amp; Distribution Analytics</h3>\n            <p>Track orders, revenue, product performance and regional demand.</p>\n          </div>\n        </article>\n\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 6h12v10H2z\"/><path d=\"M14 9h4l3 3v4h-7z\"/><circle cx=\"6\" cy=\"18\" r=\"1.6\"/><circle cx=\"17.5\" cy=\"18\" r=\"1.6\"/></svg>\n          </span>\n          <div>\n            <h3>Procurement &amp; Supply Chain Control</h3>\n            <p>Manage vendors, purchase orders, restocking cycles and delivery status.</p>\n          </div>\n        </article>\n      </div>\n\n      <div class=\"preview\">\n        <div class=\"reveal\">\n          <p class=\"eyebrow\">Product Preview</p>\n          <h3 class=\"preview__title\">Pharma ERP</h3>\n        </div>\n        <div class=\"preview__frame reveal\">\n          <img src=\"/assets/img/products/40ad50_904851d0999941e9ad00e025071d6af6.webp\" alt=\"Pharma ERP dashboard: daily sales, invoices, low-stock and expiry alerts, revenue trend and quick actions\" loading=\"lazy\">\n        </div>\n      </div>\n\n      <!-- Means -->\n      <div class=\"means reveal\">\n        <div>\n          <h3>Pharma ERP Means</h3>\n          <a class=\"btn-hello\" href=\"/sayhello/\">\n            Know More\n            <span class=\"arrow\" aria-hidden=\"true\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n        </div>\n        <ul class=\"means__list\">\n          <li>Full visibility.</li>\n          <li>Zero stockouts.</li>\n          <li>Easy procurement.</li>\n          <li>Vendor management.</li>\n        </ul>\n      </div>\n    </section>\n\n    <!-- ===== Connect with Product Managers ===== -->\n    <section class=\"section container\">\n      <div class=\"pm\">\n        <div class=\"pm__media reveal\">\n          <img src=\"/assets/img/products/8292e9_6ac6db98a2a64c6d99875dd1952a012e.webp\" alt=\"Two members of the Studio 1947 product team in the Darjeeling hills\" loading=\"lazy\" width=\"1600\" height=\"1200\">\n        </div>\n        <div class=\"reveal\">\n          <h2>Connect with our <span>Product Managers</span></h2>\n          <p>Talk directly with our product managers about planning and delivery.</p>\n          <a class=\"btn-hello\" href=\"/sayhello/\">\n            Say Hello\n            <span class=\"arrow\" aria-hidden=\"true\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n        </div>\n      </div>\n    </section>\n  </main>"
