 "html": "<main class=\"page-products\">\n    <!-- ===== Hero ===== -->\n    <section class=\"prod-hero container\" data-stagger>\n      <p class=\"eyebrow\" style=\"margin-bottom:18px\">For NGOs</p>\n      <h1 class=\"prod-hero__title\">Doptor<br>NGO Manager</h1>\n      <p class=\"prod-hero__sub\">Track projects, teams, funds and field activities from one dashboard</p>\n    </section>\n\n    <section class=\"container\" style=\"padding-bottom: clamp(48px, 6vw, 96px)\">\n      <div class=\"prod-hero__media reveal\">\n        <img src=\"/assets/img/products/40ad50_56771850c43a4b92b4470777ae3d3944.webp\" alt=\"NGO Impact Dashboard: villages covered, beneficiaries, SDG progress, impact map and fund utilisation\">\n      </div>\n    </section>\n\n    <!-- ===== Features ===== -->\n    <section class=\"section container\" style=\"padding-top: 0\">\n      <div class=\"prod-head reveal\">\n        <h2>Doptor NGO Manager</h2>\n        <p>Track projects, teams, funds and field activities from one dashboard.</p>\n      </div>\n\n      <div class=\"feat-grid\" data-stagger>\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"4.5\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/></svg>\n          </span>\n          <div>\n            <h3>Project Monitoring</h3>\n            <p>Track milestones, timelines, locations and progress in real time.</p>\n          </div>\n        </article>\n\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z\"/><path d=\"M9 4v14M15 6v14\"/></svg>\n          </span>\n          <div>\n            <h3>Field Activity Tracking</h3>\n            <p>Keep track of surveys, site visits, beneficiary outreach and on-the-ground work across regions.</p>\n          </div>\n        </article>\n\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20h16\"/><path d=\"M6 20v-6M11 20V8M16 20v-9M21 20V5\" transform=\"translate(-1 0)\"/></svg>\n          </span>\n          <div>\n            <h3>Impact &amp; Resource Analytics</h3>\n            <p>Measure outcomes, fund use, team performance and programme effectiveness, with insights you can act on.</p>\n          </div>\n        </article>\n      </div>\n\n      <div class=\"preview\">\n        <div class=\"reveal\">\n          <p class=\"eyebrow\">Product Preview</p>\n          <h3 class=\"preview__title\">NGO&rsquo;s Dashboard</h3>\n        </div>\n        <div class=\"preview__frame reveal\">\n          <img src=\"/assets/img/products/40ad50_56771850c43a4b92b4470777ae3d3944.webp\" alt=\"NGO Impact Dashboard: villages covered, beneficiaries, SDG progress, impact map and fund utilisation\" loading=\"lazy\">\n        </div>\n      </div>\n\n      <!-- Means -->\n      <div class=\"means reveal\">\n        <div>\n          <h3>Doptor NGO Manager Means</h3>\n          <a class=\"btn-hello\" href=\"/sayhello/\">\n            Know More\n            <span class=\"arrow\" aria-hidden=\"true\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n        </div>\n        <ul class=\"means__list\">\n          <li>Impact command centre.</li>\n          <li>Outcome tracking.</li>\n          <li>Live progress.</li>\n          <li>Fund transparency.</li>\n        </ul>\n      </div>\n    </section>\n\n    <!-- ===== Connect with Product Managers ===== -->\n    <section class=\"section container\">\n      <div class=\"pm\">\n        <div class=\"pm__media reveal\">\n          <img src=\"/assets/img/products/8292e9_6ac6db98a2a64c6d99875dd1952a012e.webp\" alt=\"Two members of the Studio 1947 product team in the Darjeeling hills\" loading=\"lazy\" width=\"1600\" height=\"1200\">\n        </div>\n        <div class=\"reveal\">\n          <h2>Connect with our <span>Product Managers</span></h2>\n          <p>Talk directly with our product managers about planning and delivery.</p>\n          <a class=\"btn-hello\" href=\"/sayhello/\">\n            Say Hello\n            <span class=\"arrow\" aria-hidden=\"true\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n        </div>\n      </div>\n    </section>\n  </main>"
