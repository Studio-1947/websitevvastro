 "html": "<main class=\"page-products\">\n    <!-- ===== Hero ===== -->\n    <section class=\"prod-hero container\" data-stagger>\n      <p class=\"eyebrow\" style=\"margin-bottom:18px\">For Campuses, Offices &amp; NGOs</p>\n      <h1 class=\"prod-hero__title\">Doptor<br>ERP</h1>\n      <p class=\"prod-hero__sub\">One platform, three dedicated modules: Campus, Office and NGO management</p>\n    </section>\n\n    <section class=\"container\" style=\"padding-bottom: clamp(48px, 6vw, 96px)\">\n      <div class=\"prod-hero__media reveal\">\n        <img src=\"/assets/img/products/40ad50_1f0332366a794de2ae97f6b1f678c91a.webp\" alt=\"Doptor ERP shown across mobile app screens, dashboard, examinations and analytics\">\n      </div>\n    </section>\n\n    <!-- ===== Modules ===== -->\n    <section class=\"section container\" style=\"padding-top: 0\">\n      <div class=\"prod-head reveal\">\n        <h2>Doptor ERP</h2>\n        <p>Pick the module built for how you work, campus administration, office operations or NGO impact tracking, all inside one platform.</p>\n      </div>\n\n      <div class=\"feat-grid\" data-stagger>\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 10 12 5 2 10l10 5 10-5Z\"/><path d=\"M6 12v5c0 1 2.7 2 6 2s6-1 6-2v-5\"/><path d=\"M22 10v6\"/></svg>\n          </span>\n          <div>\n            <h3>Campus Manager</h3>\n            <p>Admissions, departments, faculty, student records, examinations and results, all from one campus workspace.</p>\n          </div>\n        </article>\n\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"7\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"/><path d=\"M3 12h18\"/></svg>\n          </span>\n          <div>\n            <h3>Office Manager</h3>\n            <p>A simple hub for daily admin: centralised operations, shared task views and real-time oversight for your team.</p>\n          </div>\n        </article>\n\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"4.5\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/></svg>\n          </span>\n          <div>\n            <h3>NGO Manager</h3>\n            <p>Track projects, teams, funds and field activities from one impact dashboard.</p>\n          </div>\n        </article>\n      </div>\n\n      <div class=\"preview\">\n        <div class=\"reveal\">\n          <p class=\"eyebrow\">Product Preview</p>\n          <h3 class=\"preview__title\">A glimpse of Doptor ERP</h3>\n        </div>\n        <div class=\"preview__frame reveal\">\n          <img src=\"/assets/img/products/40ad50_5fec1502f04149279fab96242339eceb.webp\" alt=\"Doptor ERP web dashboard: institution overview with trends, insights and upcoming events\" loading=\"lazy\">\n        </div>\n      </div>\n\n      <!-- Means -->\n      <div class=\"means reveal\">\n        <div>\n          <h3>Doptor ERP Means</h3>\n          <a class=\"btn-hello\" href=\"/sayhello/\">\n            Know More\n            <span class=\"arrow\" aria-hidden=\"true\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n        </div>\n        <ul class=\"means__list\">\n          <li>All-in-one workspace.</li>\n          <li>Nothing scattered.</li>\n          <li>Smoother delivery.</li>\n          <li>Real-time oversight.</li>\n        </ul>\n      </div>\n    </section>\n\n    <!-- ===== Connect with Product Managers ===== -->\n    <section class=\"section container\">\n      <div class=\"pm\">\n        <div class=\"pm__media reveal\">\n          <img src=\"/assets/img/products/8292e9_6ac6db98a2a64c6d99875dd1952a012e.webp\" alt=\"Two members of the Studio 1947 product team in the Darjeeling hills\" loading=\"lazy\" width=\"1600\" height=\"1200\">\n        </div>\n        <div class=\"reveal\">\n          <h2>Connect with our <span>Product Managers</span></h2>\n          <p>Talk directly with our product managers about planning and delivery.</p>\n          <a class=\"btn-hello\" href=\"/sayhello/\">\n            Say Hello\n            <span class=\"arrow\" aria-hidden=\"true\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n        </div>\n      </div>\n    </section>\n  </main>"
