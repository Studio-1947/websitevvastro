 "html": "<main class=\"page-products\">\n    <!-- ===== Hero ===== -->\n    <section class=\"prod-hero container\" data-stagger>\n      <p class=\"eyebrow\" style=\"margin-bottom:18px\">For Office Management</p>\n      <h1 class=\"prod-hero__title\">Doptor<br>Office Manager</h1>\n      <p class=\"prod-hero__sub\">Built for offices and admin teams</p>\n    </section>\n\n    <section class=\"container\" style=\"padding-bottom: clamp(48px, 6vw, 96px)\">\n      <div class=\"prod-hero__media reveal\">\n        <img src=\"/assets/img/products/40ad50_1f0332366a794de2ae97f6b1f678c91a.webp\" alt=\"Doptor Office Manager shown across mobile app screens\">\n      </div>\n    </section>\n\n    <!-- ===== Features ===== -->\n    <section class=\"section container\" style=\"padding-top: 0\">\n      <div class=\"prod-head reveal\">\n        <h2>Doptor Office Manager</h2>\n        <p>One simple hub for daily admin that brings your operations together and helps your team get more done.</p>\n      </div>\n\n      <div class=\"feat-grid\" data-stagger>\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"7\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"/><path d=\"M3 12h18\"/></svg>\n          </span>\n          <div>\n            <h3>Centralised Operations</h3>\n            <p>Run day-to-day administration from one hub instead of a patchwork of tools and inboxes.</p>\n          </div>\n        </article>\n\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"4.5\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/></svg>\n          </span>\n          <div>\n            <h3>Workplace Productivity</h3>\n            <p>Give teams a shared view of tasks and responsibilities so work moves without chasing updates.</p>\n          </div>\n        </article>\n\n        <article class=\"feat-card\">\n          <span class=\"feat-card__ico\" aria-hidden=\"true\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20h16\"/><path d=\"M6 20v-6M11 20V8M16 20v-9M21 20V5\"/></svg>\n          </span>\n          <div>\n            <h3>Real-Time Oversight</h3>\n            <p>See operations, workloads and progress live, across the whole organisation.</p>\n          </div>\n        </article>\n      </div>\n\n      <div class=\"preview\">\n        <div class=\"reveal\">\n          <p class=\"eyebrow\">Product Preview</p>\n          <h3 class=\"preview__title\">A glimpse of Doptor Office Manager</h3>\n        </div>\n        <div class=\"preview__frame reveal\">\n          <img src=\"/assets/img/products/40ad50_5fec1502f04149279fab96242339eceb.webp\" alt=\"Doptor Office Manager dashboard\" loading=\"lazy\">\n        </div>\n      </div>\n\n      <!-- Means -->\n      <div class=\"means reveal\">\n        <div>\n          <h3>Doptor Office Manager Means</h3>\n          <a class=\"btn-hello\" href=\"/sayhello/\">\n            Know More\n            <span class=\"arrow\" aria-hidden=\"true\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n        </div>\n        <ul class=\"means__list\">\n          <li>All-in-one workspace.</li>\n          <li>Nothing scattered.</li>\n          <li>Smoother delivery.</li>\n          <li>Real-time oversight.</li>\n        </ul>\n      </div>\n    </section>\n\n    <!-- ===== Connect with Product Managers ===== -->\n    <section class=\"section container\">\n      <div class=\"pm\">\n        <div class=\"pm__media reveal\">\n          <img src=\"/assets/img/products/8292e9_6ac6db98a2a64c6d99875dd1952a012e.webp\" alt=\"Two members of the Studio 1947 product team in the Darjeeling hills\" loading=\"lazy\" width=\"1600\" height=\"1200\">\n        </div>\n        <div class=\"reveal\">\n          <h2>Connect with our <span>Product Managers</span></h2>\n          <p>Talk directly with our product managers about planning and delivery.</p>\n          <a class=\"btn-hello\" href=\"/sayhello/\">\n            Say Hello\n            <span class=\"arrow\" aria-hidden=\"true\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n            </span>\n          </a>\n        </div>\n      </div>\n    </section>\n  </main>"
