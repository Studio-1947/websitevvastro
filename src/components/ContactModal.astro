---
/**
 * Contact popup: opened from the nav / footer "Say Hello" buttons and any
 * [data-contact-open] trigger. Behaviour wired in src/scripts/contactModal.ts.
 *
 * Two columns: a looping studio reel on the left, the note form on the right.
 * The reel is a silent 9:16 H.264 clip; it autoplays muted when the popup opens
 * and pauses when it closes (contactModal.ts), and it is skipped for
 * reduced-motion users. preload="metadata" keeps the 2.8 MB off the initial
 * page load: it only fetches once the popup is opened. It is decorative
 * (aria-hidden), so no captions or controls.
 *
 * The form posts to Web3Forms. `access_key` is Web3Forms' *public* key: it is
 * designed to sit in client-side HTML and identifies the destination inbox, so
 * the studio address itself never appears in the markup. Unlike the previous
 * FormSubmit endpoint there is no activation step, so submissions deliver from
 * the first one.
 */
---

<div class="contact-modal" id="contact-modal" role="dialog" aria-modal="true" aria-labelledby="cm-title" aria-hidden="true">
  <div class="contact-modal__backdrop" data-cm-close></div>
  {/* data-lenis-prevent: Lenis preventDefaults wheel events document-wide, which
      swallowed the wheel here and left the form unscrollable on short viewports.
      The attribute hands this subtree back to native scrolling. */}
  <div class="contact-modal__panel" tabindex="-1" data-lenis-prevent>
    <button class="contact-modal__close" type="button" aria-label="Close" data-cm-close>&times;</button>

    <div class="cm-media" aria-hidden="true">
      <video
        class="cm-media__video"
        data-cm-video
        muted
        loop
        playsinline
        preload="metadata"
        poster="/assets/img/say-hello-poster.jpg"
      >
        <source src="/assets/video/for_say_hello.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="cm-body">
      <p class="eyebrow">Say Hello to Studio 1947</p>
      <h2 class="contact-modal__title" id="cm-title">Send us a note.</h2>
      <p class="contact-modal__sub">We usually reply within a couple of working days.</p>
      <form action="https://api.web3forms.com/submit" method="POST" novalidate data-contact-form>
        <input type="hidden" name="access_key" value="5f7140d3-65d4-4366-bdd0-e326ec2b8483" />
        <input type="hidden" name="subject" value="New enquiry from Studio 1947 website" />
        <input type="hidden" name="from_name" value="Studio 1947 website" />
        {/* Web3Forms' honeypot: bots tick it, people never see it. */}
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="cm-row">
          <div class="cm-field">
            <label for="cm-name">Name <span class="cm-req" aria-hidden="true">*</span></label>
            <input type="text" id="cm-name" name="name" placeholder="Your name" autocomplete="name" required />
          </div>
          <div class="cm-field">
            <label for="cm-email">Email <span class="cm-req" aria-hidden="true">*</span></label>
            <input type="email" id="cm-email" name="email" placeholder="you@example.com" autocomplete="email" required />
          </div>
        </div>
        <div class="cm-field">
          <label for="cm-org">Organisation</label>
          <input type="text" id="cm-org" name="organisation" placeholder="Company or organisation (optional)" autocomplete="organization" />
        </div>
        <div class="cm-field">
          <label for="cm-msg">Message <span class="cm-req" aria-hidden="true">*</span></label>
          <textarea id="cm-msg" name="message" placeholder="Tell us about your challenge, goals and timeline…" required></textarea>
        </div>
        <button type="submit" class="cm-submit">
          Send message
          <span class="arrow" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </button>
        <p class="cm-note">Prefer email? Write to us at <a href="mailto:studio@1947.io" style="color:var(--red)">studio@1947.io</a>.</p>
      </form>
    </div>
  </div>
</div>
