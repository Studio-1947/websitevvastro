---
/** Archetype: map photo with caption list beside it. */
import Slot from '../Slot/index.astro';
import type { MapContent } from './content';

interface Props { content: MapContent }
const { content: c } = Astro.props;
---

<section class="map" aria-labelledby="aangan-map-title">
  <div class="map__inner">
    <figure class="map__figure" data-slot={c.slot.id}>
      <Slot image={c.slot} class="map__img" decorative eager />
    </figure>

    <div class="map__text">
      <h2 id="aangan-map-title" class="map__heading">{c.heading}</h2>
      <p class="map__body">{c.body}</p>
      <ul class="map__list">
        {c.pins.map((t) => (
          <li class:list={{ 'is-home': t.home, 'is-hq': t.hq }}>
            <strong>{t.name}</strong>
            {t.href ? <a href={t.href} target="_blank" rel="noopener">{t.status}</a> : <span>{t.status}</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="map__places">
    <h3 class="map__places-heading">{c.placesHeading}</h3>
    <ul class="map__grid">
      {c.places.map((p) => (
        <li class="map__place">
          <Slot image={p.image} class="map__place-img" />
          <p class="map__place-name">{p.name}</p>
          {p.credit && <p class="map__place-credit">{p.credit}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .map {
    --pad: clamp(56px, 8vw, 120px);
    padding: var(--pad) clamp(16px, 5vw, 72px);
    background: #F7F1E6;
  }
  .map__inner { max-width: 1320px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .map__figure { margin: 0; overflow: hidden; }
  .map__figure :global(.map__img) { display: block; }
  .map__figure :global(.map__img img) { border-radius: 0; }

  .map__heading { margin: 0 0 16px; font-size: clamp(30px, 3.4vw, 48px); }
  .map__body { margin: 0 0 24px; font-size: 17px; line-height: 1.6; color: #4A3B2F; }
  .map__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(154, 106, 58, .3); }
  .map__list li { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid rgba(154, 106, 58, .3); }
  .map__list strong { font-family: var(--a-font-display); font-weight: 400; font-size: 20px; }
  .map__list span, .map__list a { font-size: 14px; color: var(--a-tea); }
  .map__list a { text-decoration: underline; text-underline-offset: 3px; }
  .map__list .is-hq a, .map__list .is-hq span { color: var(--a-moss); font-weight: 600; }
  .map__list .is-home span { color: var(--a-accent); font-weight: 600; }

  .map__places { max-width: 1320px; margin: clamp(40px, 6vw, 88px) auto 0; }
  .map__places-heading { margin: 0 0 clamp(18px, 2.4vw, 32px); font-size: clamp(24px, 2.4vw, 34px); }
  .map__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(14px, 1.6vw, 24px); }
  .map__place :global(.map__place-img) { border-radius: var(--radius-lg); }
  .map__place-name { margin: 12px 0 0; font-family: var(--a-font-display); font-size: 20px; color: var(--a-ink); }
  .map__place-credit { margin: 2px 0 0; font-size: 12px; color: var(--a-tea); }

  @media (max-width: 860px) {
    .map__grid { grid-template-columns: repeat(2, 1fr); }
    .map__inner { grid-template-columns: 1fr; }
    .map__figure { max-width: 640px; margin-inline: auto; }
  }
</style>
