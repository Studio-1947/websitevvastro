---
/**
 * Image slot. Renders the slot's file when it has one, otherwise a labelled
 * placeholder at the right ratio. The slot ID stays on the figure as
 * data-slot, so the team can still find which file goes where.
 */
import type { ImageSlot } from '../types';

interface Props {
  /** Named `image`, not `slot`: `slot` is a reserved HTML attribute in Astro. */
  image: ImageSlot;
  class?: string;
  eager?: boolean;
  decorative?: boolean;
}
const { image, class: cls = '', eager = false, decorative = false } = Astro.props;
const [rw, rh] = image.ratio.split(':').map(Number);
---

<figure class:list={['slot', cls]} style={`aspect-ratio: ${rw} / ${rh}`} data-slot={image.id}>
  {image.src ? (
    <img
      src={image.src}
      alt={decorative ? '' : image.alt}
      aria-hidden={decorative ? 'true' : undefined}
      width={image.width ?? rw * 100}
      height={image.height ?? rh * 100}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <div class="slot__empty" role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : image.alt}>
      <strong>{image.id}</strong>
      <span>{image.ratio}</span>
      <em>{image.alt}</em>
    </div>
  )}
</figure>

<style>
  .slot { position: relative; margin: 0; overflow: hidden; background: #E6DCCB; }
  .slot img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .slot__empty {
    position: absolute; inset: 0; display: grid; place-content: center; gap: 4px; padding: 12px;
    text-align: center; font-size: 13px; color: #5B4A3C;
    background: repeating-linear-gradient(45deg, #EADFCB 0 12px, #E3D6BF 12px 24px);
    border: 1px dashed #9A6A3A;
  }
  .slot__empty strong { font-size: 15px; }
</style>
