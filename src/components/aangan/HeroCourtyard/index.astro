---
/** Archetype: full-bleed image, offset text block bottom-left. Motion: slow parallax. */
import Slot from '../Slot/index.astro';
import { ctaAttrs } from '../types';
import type { HeroContent } from './content';

interface Props { content: HeroContent }
const { content: c } = Astro.props;
---

<section class="ahero" aria-labelledby="aangan-hero-title">
  <div class="ahero__media" data-hero-parallax>
    {c.video ? (
      <video
        class="ahero__img ahero__video" autoplay muted loop playsinline preload="metadata"
        poster={c.video.poster} aria-hidden="true" data-hero-video
      >
        <source src={c.video.src} type={c.video.type} />
      </video>
    ) : (
      <Slot image={c.image} class="ahero__img" eager />
    )}
  </div>
  <div class="ahero__scrim" aria-hidden="true"></div>
  <div class="ahero__text">
    <p class="ahero__eyebrow">{c.eyebrow}</p>
    <h1 id="aangan-hero-title" class="ahero__title">
      <img class="ahero__logo" src={c.logo.src} alt={c.logo.alt} width={c.logo.width} height={c.logo.height} />
      <span>{c.headlineRest}</span>
    </h1>
    <p class="ahero__sub">{c.sub}</p>
    <div class="ahero__ctas">
      <a class="a-btn" {...ctaAttrs(c.primary)}>{c.primary.label}</a>
      <a class="a-btn a-btn--ghost ahero__ghost" {...ctaAttrs(c.secondary)}>{c.secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .ahero {
    --gap: clamp(20px, 3vw, 40px);
    position: relative; isolation: isolate;
    min-height: clamp(620px, 96vh, 980px);
    display: flex; align-items: flex-end;
    color: #FBF8F2; background: #3A2A1E;
  }
  .ahero__media { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .ahero__media :global(.ahero__img) { position: absolute; inset: -6% 0; aspect-ratio: auto !important; height: 112%; will-change: transform; }
  .ahero__video { display: block; width: 100%; object-fit: cover; }
  .ahero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(to top, rgba(42, 31, 23, .88) 0%, rgba(42, 31, 23, .45) 38%, rgba(42, 31, 23, 0) 70%),
      linear-gradient(to right, rgba(42, 31, 23, .55) 0%, rgba(42, 31, 23, 0) 60%);
  }
  @media (max-width: 640px) {
    .ahero__scrim { background: linear-gradient(to top, rgba(42, 31, 23, .92) 0%, rgba(42, 31, 23, .78) 55%, rgba(42, 31, 23, .25) 85%, rgba(42, 31, 23, 0) 100%); }
  }
  .ahero__text {
    width: min(620px, 100%);
    margin: 0 0 clamp(40px, 7vw, 96px) clamp(16px, 7vw, 120px);
    padding-right: 16px;
  }
  .ahero__eyebrow { margin: 0 0 14px; font-size: 14px; letter-spacing: .12em; text-transform: uppercase; opacity: .85; }
  .ahero__title { margin: 0; color: #FBF8F2; font-size: clamp(34px, 5vw, 64px); line-height: 1.05; }
  .ahero__logo { display: block; width: clamp(200px, 30vw, 380px); height: auto; margin-bottom: 10px; }
  .ahero__sub { margin: var(--gap) 0 0; max-width: 46ch; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.5; opacity: .92; }
  .ahero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: var(--gap); }
  .ahero__ghost { color: #FBF8F2; }

  /* Small screens: lift the text block toward the middle instead of hugging the bottom. */
  @media (max-width: 640px) {
    .ahero { align-items: center; }
    .ahero__text { margin: 88px 0 24px 24px; padding-right: 24px; }
  }
</style>

<script>
  const media = document.querySelector<HTMLElement>('[data-hero-parallax] .ahero__img');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reduced motion: hold on the poster frame. Otherwise pause while off screen.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    if (reduce) {
      video.removeAttribute('autoplay');
      video.pause();
    } else if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) video.play().catch(() => {});
        else video.pause();
      }).observe(video);
    }
  }
  if (media && !reduce) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = Math.min(window.scrollY, window.innerHeight);
      media.style.transform = `translate3d(0, ${y * 0.12}px, 0)`;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }
</script>
