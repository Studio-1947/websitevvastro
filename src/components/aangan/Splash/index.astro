---
/**
 * Opening splash: the aangan wordmark draws itself over a Darjeeling view, then
 * fades to reveal the page. Mirrors the loading screen of the aangan app
 * (aanganerp.in) so the product page opens the same way the product does.
 * Only shown when JS is active (html.js), since the script below removes it.
 * With reduced motion the wordmark does not draw itself: it shows still, briefly.
 */
import { LOGO } from '../logo';
---

<div class="asplash" id="aangan-splash" aria-hidden="true">
  <svg viewBox={`0 0 ${LOGO.width} ${LOGO.height}`} fill="none" xmlns="http://www.w3.org/2000/svg">
    {LOGO.paths.map((d) => <path pathLength="1" d={d} fill="currentColor" />)}
  </svg>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('aangan-splash');
    if (!el) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    setTimeout(function () {
      el.classList.add('is-hidden');
      setTimeout(function () { el.remove(); }, 300);
    }, reduce ? 900 : 1800);
  })();
</script>

<style>
  .asplash { display: none; }
  :global(html.js) .asplash {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: flex-start; justify-content: center;
    padding-top: 16vh;
    background: #2C5E3B url(/assets/img/products/aangan/splash.webp) center / cover no-repeat;
    color: #fff;
    transition: opacity .3s ease;
  }
  .asplash svg { width: 55vw; max-width: 280px; height: auto; }
  :global(html.js) .asplash.is-hidden { opacity: 0; pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .asplash svg { -webkit-clip-path: inset(0 100% 0 0); clip-path: inset(0 100% 0 0); animation: asplash-reveal 1.8s ease-out forwards; }
    .asplash svg path { stroke: currentColor; stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 1; animation: asplash-trace 1.8s ease-out forwards; }
  }
  @keyframes asplash-reveal { to { -webkit-clip-path: inset(0 0 0 0); clip-path: inset(0 0 0 0); } }
  @keyframes asplash-trace { to { stroke-dashoffset: 0; } }
</style>
