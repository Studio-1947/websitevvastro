---
/**
 * Archetype: a grid of equal square portrait cards. Clicking one opens that person's
 * full details (work area, bio, portfolio projects) in a dialog on this page. Each card is still a link to their profile on
 * /about-us/, which is where it goes without JS. Motion: stagger reveal.
 */
import type { TeamContent } from './content';
import { getCollection } from 'astro:content';
import { teamMemberHref, teamMemberKeyForCreditName } from '../../../lib/team';
import aboutHtml from '../../../generated/about-us/main.html?raw';

interface Props { content: TeamContent }
const { content: c } = Astro.props;

/**
 * Each person's details come from their card on the About page, so there is one
 * place to edit a bio. Keyed the same way as `member`: data-fullname, else the
 * card's name, lowercased.
 */
const text = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();
const profiles = new Map<string, { fullName: string; role: string; spec: string; bio: string }>();
for (const card of aboutHtml.match(/<article[\s\S]*?<\/article>/g) ?? []) {
  const name = /team-card__name">([^<]*)/.exec(card)?.[1];
  if (!name) continue;
  const fullName = text(/data-fullname="([^"]*)"/.exec(card)?.[1] ?? name);
  profiles.set(fullName.toLowerCase(), {
    fullName,
    role: text(/team-card__role"[^>]*>([\s\S]*?)<\/div>/.exec(card)?.[1] ?? ''),
    spec: text(/team-card__spec"[^>]*>([\s\S]*?)<\/div>/.exec(card)?.[1] ?? ''),
    bio: /<div class="team-bio" hidden>([\s\S]*?)<\/div>\s*<\/article>/.exec(card)?.[1] ?? '',
  });
}
/** Member → the portfolio projects they are credited on, as the About page lists them. */
const projects = new Map<string, { href: string; label: string }[]>();
for (const entry of await getCollection('work')) {
  const label = entry.data.client || entry.data.title.split('|')[0].trim();
  const href = `/work/${entry.id}/`;
  for (const credit of entry.data.credits) {
    for (const raw of credit.members.split(',')) {
      const member = teamMemberKeyForCreditName(raw);
      if (!member) continue;
      const list = projects.get(member) ?? [];
      if (!list.some((p) => p.href === href)) projects.set(member, [...list, { href, label }]);
    }
  }
}
const people = c.people.map((p) => ({
  ...p,
  profile: profiles.get(p.member),
  projects: (projects.get(p.member) ?? []).sort((a, b) => a.label.localeCompare(b.label)),
  hasProjects: projects.has(p.member),
}));
const ARROW = 'M5 12h14M13 6l6 6-6 6';
---

<section class="team" aria-labelledby="aangan-team-title" data-team>
  <div class="team__inner">
    <header class="team__head">
      <h2 id="aangan-team-title" class="team__heading">{c.heading}</h2>
      <p class="team__intro">{c.intro}</p>
    </header>
    <ul class="team__grid">
      {people.map((p, i) => (
        <li class="team__card" style={`--i: ${i}`}>
          <a class="team__link" href={teamMemberHref(p.member)} aria-label={`${p.name}, ${p.role}: view details`} data-team-open={p.profile ? i : undefined} aria-haspopup={p.profile ? 'dialog' : undefined}>
            <img
              class="team__photo"
              src={p.photo}
              alt=""
              loading="lazy"
              decoding="async"
              style={`--z: ${p.zoom ?? 1}; --x: ${p.x ?? 50}%; --y: ${p.y ?? 35}%`}
            />
            <span class="team__meta">
              <span class="team__role">{p.role}</span>
              <span class="team__name">{p.name}</span>
            </span>
            <span class="team__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d={ARROW} /></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  {/* One dialog; opening a card fills it with a copy of that person's details, kept below. */}
  <dialog class="team__dialog" aria-labelledby="team-dialog-name" data-team-dialog data-lenis-prevent>
    <button class="team__close" type="button" aria-label="Close" data-team-close>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <div class="team__panel" data-team-panel></div>
  </dialog>
  {people.map((p, i) => p.profile && (
    <div hidden data-team-profile={i}>
      <div class="team__person">
        <img class="team__portrait" src={p.photo} alt={`Portrait of ${p.name}`} style={`--x: ${p.x ?? 50}%; --y: ${p.y ?? 35}%`} />
        <div>
          <p class="team__person-role">{p.role}</p>
          <h3 class="team__person-name">{p.profile.fullName}</h3>
          <p class="team__person-at">{p.profile.role}, Studio 1947</p>
        </div>
      </div>
      {p.profile.spec && (
        <div class="team__block">
          <h4>Work area</h4>
          <p>{p.profile.spec}</p>
        </div>
      )}
      <div class="team__bio" set:html={p.profile.bio} />
      {p.hasProjects && (
        <div class="team__block">
          <h4>Portfolio</h4>
          <ul class="team__projects">
            {p.projects.map((pr) => <li><a href={pr.href}>{pr.label}</a></li>)}
          </ul>
        </div>
      )}
      <a class="team__more" href={teamMemberHref(p.member)}>Full profile on About us
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={ARROW} /></svg>
      </a>
    </div>
  ))}
</section>

<style>
  .team {
    padding: clamp(64px, 9vw, 130px) clamp(16px, 5vw, 72px);
  }
  .team__inner { max-width: 1320px; margin: 0 auto; }
  .team__head { max-width: 640px; margin-bottom: clamp(28px, 4vw, 56px); }
  .team__heading { margin: 0 0 14px; font-size: clamp(30px, 3.4vw, 48px); line-height: 1.1; }
  .team__intro { margin: 0; font-size: 17px; line-height: 1.55; color: #4A3B2F; }

  /* Everyone gets the same card: 5 columns for ten people, two even rows. */
  .team__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(10px, 1.2vw, 16px);
  }
  .team__card {
    aspect-ratio: 1;
    opacity: 0; transform: translateY(20px);
    transition: opacity .6s ease calc(var(--i) * .07s), transform .6s ease calc(var(--i) * .07s);
  }
  .team.is-in .team__card { opacity: 1; transform: none; }
  :global(html:not(.js)) .team__card { opacity: 1; transform: none; }

  .team__link {
    position: relative; display: block; width: 100%; height: 100%;
    border-radius: 14px; overflow: hidden;
    background: rgba(154, 106, 58, .14);
    color: var(--a-accent-ink); text-decoration: none;
    isolation: isolate;
  }
  .team__link:focus-visible { outline: 3px solid var(--a-ink); outline-offset: 3px; }
  .team__link::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to top, rgba(42, 31, 23, .78) 0%, rgba(42, 31, 23, .25) 32%, transparent 55%);
  }
  .team__photo {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: var(--x) var(--y);
    transform: scale(var(--z)); transform-origin: var(--x) var(--y);
    filter: grayscale(.2) sepia(.08);
    transition: transform .7s var(--ease, ease), filter .4s ease;
  }
  .team__link:hover .team__photo { transform: scale(calc(var(--z) * 1.05)); filter: none; }

  .team__meta {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
    display: flex; flex-direction: column; gap: 2px;
    padding: clamp(10px, 1.1vw, 16px);
  }
  .team__role {
    font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase;
    opacity: .85;
  }
  .team__name { font-family: var(--a-font-display); font-size: clamp(17px, 1.4vw, 21px); line-height: 1.15; }

  .team__arrow {
    position: absolute; top: 10px; right: 10px; z-index: 2;
    display: grid; place-items: center;
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--a-accent); color: var(--a-accent-ink);
    opacity: 0; transform: scale(.8);
    transition: opacity .25s ease, transform .25s ease;
  }
  .team__link:hover .team__arrow, .team__link:focus-visible .team__arrow { opacity: 1; transform: none; }

  /* The details dialog. */
  .team__dialog {
    width: min(760px, calc(100vw - 32px)); max-height: 92vh;
    /* The site's reset zeroes margins; a modal dialog centres on margin: auto. */
    margin: auto; padding: 0; border: 0; border-radius: 22px; overflow: hidden;
    background: #FBF8F2; color: var(--a-ink);
    box-shadow: 0 40px 100px rgba(28, 20, 14, .35);
  }
  .team__dialog[open] { display: flex; flex-direction: column; animation: team-pop .32s cubic-bezier(.2, .8, .2, 1); }
  .team__dialog::backdrop { background: rgba(28, 20, 14, .55); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  @keyframes team-pop { from { opacity: 0; transform: translateY(16px) scale(.98); } }
  .team__panel { overflow-y: auto; overscroll-behavior: contain; padding: clamp(22px, 4vw, 40px); }
  .team__close {
    all: unset; box-sizing: border-box; cursor: pointer;
    position: absolute; top: 14px; right: 14px; z-index: 1;
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%;
    /* Solid, so the bio scrolling underneath never shows through it. */
    background: #EDE5D6; color: var(--a-ink);
    transition: background .2s ease;
  }
  .team__close:hover { background: #E0D6C3; }
  .team__close:focus-visible, .team__more:focus-visible { outline: 3px solid var(--a-accent); outline-offset: 2px; }
  .team__person { display: flex; align-items: center; gap: clamp(16px, 3vw, 24px); margin: 0 44px clamp(18px, 3vw, 26px) 0; }
  .team__portrait { flex: none; width: clamp(84px, 18vw, 120px); aspect-ratio: 1; border-radius: 18px; object-fit: cover; object-position: var(--x) var(--y); background: rgba(154, 106, 58, .14); }
  .team__person-role { margin: 0 0 6px; font-size: 12px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--a-accent); }
  .team__person-name { margin: 0 0 6px; font-size: clamp(24px, 3.4vw, 34px); line-height: 1.1; }
  .team__person-at { margin: 0; font-size: 14.5px; line-height: 1.4; color: var(--a-tea); }
  .team__block { border-top: 1px solid rgba(154, 106, 58, .3); padding: clamp(14px, 2vw, 18px) 0; }
  .team__block h4 { margin: 0 0 6px; font-family: inherit; font-size: 12px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--a-tea); }
  .team__block p { margin: 0; font-size: 16px; line-height: 1.5; color: #3A2D22; }
  .team__projects { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .team__projects a { display: block; padding: 7px 14px; border-radius: 999px; font-size: 14px; line-height: 1.2; color: var(--a-ink); text-decoration: none; box-shadow: inset 0 0 0 1px rgba(154, 106, 58, .45); transition: background .2s ease; }
  .team__projects a:hover { background: rgba(154, 106, 58, .12); }
  .team__bio { border-top: 1px solid rgba(154, 106, 58, .3); padding: clamp(16px, 2.4vw, 22px) 0 4px; }
  /* More below: a soft fade at the foot of the panel until the end is reached. */
  .team__dialog::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 56px; pointer-events: none;
    background: linear-gradient(to top, #FBF8F2, rgba(251, 248, 242, 0)); opacity: 0; transition: opacity .25s ease;
  }
  .team__dialog.has-more::after { opacity: 1; }
  .team__bio :global(p) { margin: 0 0 .9em; font-size: 16px; line-height: 1.6; color: #3A2D22; }
  .team__bio :global(.team-bio__lead) { font-family: var(--a-font-display); font-size: 19px; line-height: 1.35; color: var(--a-ink); }
  .team__bio :global(a) { color: var(--a-accent); text-underline-offset: 3px; }
  .team__more { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 15px; line-height: 1; font-weight: 500; color: var(--a-accent); text-decoration: none; }
  .team__more:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Phone: 2 columns, five even rows. */
  @media (max-width: 720px) {
    .team__grid { grid-template-columns: repeat(2, 1fr); }
    .team__role { font-size: 10px; }
  }
  /* Nothing hovers on a touch screen, so the button is always there: frosted glass over the photo. */
  @media (hover: none), (max-width: 720px) {
    .team__arrow {
      opacity: 1; transform: none;
      background: rgba(255, 255, 255, .2); color: #fff;
      -webkit-backdrop-filter: blur(10px) saturate(1.5); backdrop-filter: blur(10px) saturate(1.5);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .5), 0 4px 14px rgba(28, 20, 14, .25);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .team__card, .team__photo, .team__arrow { transition: none; }
    .team__dialog[open] { animation: none; }
    .team__card { opacity: 1; transform: none; }
    .team__link:hover .team__photo { transform: scale(var(--z)); }
  }
</style>

<script>
  import { lockScroll, unlockScroll } from '../../../scripts/scrollLock';

  const root = document.querySelector<HTMLElement>('[data-team]');
  if (root) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { root.classList.add('is-in'); io.disconnect(); }
      }, { threshold: 0.15 });
      io.observe(root);
    } else {
      root.classList.add('is-in');
    }

    // Details open here, in a dialog. Without it (or held with a modifier key) the card is a plain link.
    const dialog = root.querySelector<HTMLDialogElement>('[data-team-dialog]');
    const panel = root.querySelector<HTMLElement>('[data-team-panel]');
    if (dialog && panel && typeof dialog.showModal === 'function') {
      root.querySelectorAll<HTMLAnchorElement>('[data-team-open]').forEach((link) => {
        link.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const source = root.querySelector<HTMLElement>(`[data-team-profile="${link.dataset.teamOpen}"]`);
          if (!source) return;
          e.preventDefault();
          panel.replaceChildren(...Array.from(source.children, (el) => el.cloneNode(true)));
          panel.querySelector('.team__person-name')?.setAttribute('id', 'team-dialog-name');
          dialog.showModal();
          panel.scrollTop = 0;
          more();
          lockScroll();
        });
      });
      const more = () => dialog.classList.toggle('has-more', panel.scrollHeight - panel.scrollTop - panel.clientHeight > 8);
      panel.addEventListener('scroll', more, { passive: true });
      window.addEventListener('resize', more);
      dialog.addEventListener('close', () => unlockScroll());
      root.querySelector('[data-team-close]')?.addEventListener('click', () => dialog.close());
      // A click on the backdrop lands on the dialog itself, outside its contents.
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    }
  }
</script>
