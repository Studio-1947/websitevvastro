---
/**
 * How it works on /products/pharma-erp/: three numbered cards (set up, sell,
 * restock), each with a small picture drawn in HTML on the red wash. Same
 * design as the S47 Vyapar steps (components/isd/Steps); the pictures are
 * this page's own and use the batch and order numbers from the feature rows.
 * Decorative: the text on each card says the same thing.
 */
import type { StepsContent } from '../../isd/content';

interface Props { content: StepsContent }
const { content: c } = Astro.props;
---

<section class="steps" aria-labelledby="pharma-steps-title">
  <header class="steps__head">
    <h2 id="pharma-steps-title" class="p-title">{c.title}</h2>
    <p class="p-lede">{c.lede}</p>
    <ol class="steps__track" aria-hidden="true">
      {c.steps.map((s, i) => <li><span>{i + 1}</span>{s.label}</li>)}
    </ol>
  </header>

  <ol class="steps__grid" data-stagger>
    {c.steps.map((s, i) => (
      <li class="step">
        <div class="step__art" aria-hidden="true" data-i18n-skip>
          {i === 0 && (
            <div class="art art--connect">
              <ul class="art__sources">
                {c.sources.map((x) => <li><i style={`--c: ${x.color}`}></i>{x.label}</li>)}
              </ul>
              <span class="art__wires"><i></i><i></i><i></i><i></i></span>
              <span class="art__hub">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                <b>Pharma ERP</b>
              </span>
            </div>
          )}
          {i === 1 && (
            <div class="art art--work">
              <div class="art__clock"><span><small>Bill #2291</small><b>₹183</b></span><i>Saved</i></div>
              <ul class="art__tasks">
                <li><i class="is-done"></i>Paracetamol 650 × 2<em class="t-amber">B-2291 · sell first</em></li>
                <li><i class="is-done"></i>ORS sachets × 4<em class="t-blue">In stock</em></li>
                <li><i class="is-done"></i>Cetirizine 10 × 1<em class="t-blue">In stock</em></li>
              </ul>
            </div>
          )}
          {i === 2 && (
            <div class="art art--share">
              <div class="art__mail">
                <span class="art__from"><i>PO</i><span><b>Purchase order PO-0188</b><small>To: your supplier · ready to send</small></span></span>
                <span class="art__nums"><span><small>Low stock</small><b>19</b></span><span><small>Expiring</small><b>1</b></span><span><small>To order</small><b>12</b></span></span>
              </div>
              <div class="art__roles"><i>Owner · every branch</i><i>Counter · own branch</i></div>
            </div>
          )}
        </div>
        <p class="step__label"><span>{i + 1}</span>{s.label}</p>
        <h3 class="step__title">{s.title}</h3>
        <p class="step__body">{s.body}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .steps { max-width: 1280px; margin: 0 auto; padding: clamp(56px, 7vw, 110px) clamp(16px, 5vw, 72px) clamp(24px, 3vw, 40px); }
  .steps__head { text-align: center; margin-bottom: clamp(32px, 4vw, 52px); }
  .steps__track {
    list-style: none; margin: 26px auto 0; padding: 0;
    display: flex; justify-content: center; align-items: center; gap: 12px; flex-wrap: wrap;
    font-size: 15px; font-weight: 500;
  }
  .steps__track li { display: flex; align-items: center; gap: 8px; }
  .steps__track li + li::before { content: ''; width: clamp(24px, 5vw, 64px); height: 1px; margin-right: 4px; background: var(--p-line); }
  .steps__track span, .step__label span {
    display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%;
    background: var(--p-ink); color: #fff; font-size: 13px;
  }

  .steps__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .step { display: flex; flex-direction: column; padding: 12px 12px 26px; border-radius: 16px; background: var(--p-card); }
  .step__art { display: grid; place-items: center; height: clamp(220px, 20vw, 260px); margin-bottom: 22px; padding: 18px; border-radius: 12px; background: var(--p-wash); }
  .step__label { display: flex; align-items: center; gap: 10px; margin: 0 12px 10px; font-size: 14px; font-weight: 600; color: var(--p-muted); text-transform: uppercase; letter-spacing: .08em; }
  .step__title { margin: 0 12px 8px; font-size: clamp(22px, 1.9vw, 26px); line-height: 1.2; }
  .step__body { margin: 0 12px; font-size: 15.5px; line-height: 1.55; color: var(--p-muted); }

  /* ----- The pictures: small white cards on the wash ----- */
  .art { width: 100%; max-width: 330px; font-size: 12px; color: var(--p-ink); }
  .art :where(i, em) { font-style: normal; }

  .art--connect { display: grid; grid-template-columns: 1fr 44px auto; align-items: center; }
  .art__sources { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .art__sources li {
    display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 10px; background: #fff;
    box-shadow: 0 8px 18px -12px rgba(14, 56, 50, .45); font-weight: 500;
  }
  .art__sources i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .art__wires { display: grid; gap: 22px; padding: 6px 0; }
  .art__wires i { height: 2px; border-radius: 1px; background: repeating-linear-gradient(90deg, rgba(13, 13, 13, .35) 0 5px, transparent 5px 9px); }
  /* Pharma ERP's own green, as in the live demo above. */
  .art__hub {
    display: grid; place-items: center; gap: 4px; width: 84px; height: 84px; border-radius: 22px;
    background: #0F9D74; color: #fff; box-shadow: 0 14px 28px -14px rgba(15, 157, 116, .8);
  }
  .art__hub b { font-size: 11px; font-weight: 600; }

  .art--work { display: grid; gap: 8px; padding: 12px; border-radius: 14px; background: #fff; box-shadow: 0 18px 36px -20px rgba(14, 56, 50, .45); }
  .art__clock { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; border-radius: 10px; background: #F4F6F8; }
  .art__clock span { display: grid; }
  .art__clock small { font-size: 9.5px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--p-muted); }
  .art__clock b { font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .art__clock i { padding: 3px 8px; border-radius: 999px; background: var(--p-green-soft); color: var(--p-green); font-size: 10.5px; font-weight: 600; }
  .art__tasks { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .art__tasks li { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 8px; border: 1px solid #EEF0F4; font-weight: 500; }
  .art__tasks li > i { flex: none; width: 13px; height: 13px; border-radius: 4px; border: 1.5px solid #B9C0CC; }
  .art__tasks li > i.is-done { border-color: #0F9D74; background: #0F9D74; }
  .art__tasks em { margin-left: auto; padding: 2px 7px; border-radius: 999px; font-size: 10px; font-weight: 600; white-space: nowrap; }
  .t-green { background: var(--p-green-soft); color: var(--p-green); }
  .t-amber { background: var(--p-amber-soft); color: #B8730C; }
  .t-blue { background: #E1EEFA; color: #2B76B9; }

  .art--share { display: grid; gap: 10px; }
  .art__mail { display: grid; gap: 10px; padding: 14px; border-radius: 14px; background: #fff; box-shadow: 0 18px 36px -20px rgba(14, 56, 50, .45); }
  .art__from { display: flex; align-items: center; gap: 10px; }
  .art__from i { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: #0F9D74; color: #fff; font-size: 12px; font-weight: 700; }
  .art__from span { display: grid; line-height: 1.25; }
  .art__from b { font-size: 13px; }
  .art__from small { font-size: 10.5px; color: var(--p-muted); }
  .art__nums { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .art__nums span { display: grid; padding: 6px 8px; border-radius: 8px; background: #F4F6F8; }
  .art__nums small { font-size: 9px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--p-muted); }
  .art__nums b { font-size: 15px; font-weight: 600; }
  .art__roles { display: flex; flex-wrap: wrap; gap: 6px; }
  .art__roles i { padding: 5px 10px; border-radius: 999px; background: #fff; box-shadow: 0 6px 14px -10px rgba(14, 56, 50, .5); font-size: 11px; font-weight: 500; }

  @media (max-width: 900px) {
    .steps__grid { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
  }
</style>
