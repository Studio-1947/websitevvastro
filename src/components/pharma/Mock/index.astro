---
/** A small piece of product UI, drawn in HTML. Decorative: the text beside it says the same thing. */
import type { Mock } from '../types';

interface Props { mock: Mock }
const { mock: m } = Astro.props;
const cols = (m.head ?? m.rows[0].cells).length;
---

<div class="mock" aria-hidden="true">
  <div class="mock__top">
    <span class="mock__title">{m.title}</span>
    <span class="mock__tag" data-tone={m.tagTone}>{m.tag}</span>
  </div>
  <div class="mock__table" style={`--rest: ${cols - 1}`}>
    {m.head && <div class="mock__row mock__row--head">{m.head.map((h) => <span>{h}</span>)}</div>}
    {m.rows.map((r) => (
      <div class="mock__row" data-tone={r.tone}>
        {r.cells.map((cell) => <span>{cell}</span>)}
        {r.note && <em class="mock__note">{r.note}</em>}
      </div>
    ))}
  </div>
  {m.foot && <p class="mock__foot">{m.foot}</p>}
</div>

<style>
  .mock {
    --tone: var(--p-muted); --tone-soft: #EEF2F0;
    background: var(--p-surface); border-radius: 16px;
    box-shadow: 0 0 0 1px rgba(13, 13, 13, .05), 0 24px 48px -24px rgba(14, 56, 50, .35);
    padding: clamp(18px, 2vw, 24px);
    font-size: 14px; color: var(--p-ink);
    font-variant-numeric: tabular-nums;
  }
  [data-tone='green'] { --tone: var(--p-green); --tone-soft: var(--p-green-soft); }
  [data-tone='amber'] { --tone: #B86F00; --tone-soft: var(--p-amber-soft); }
  [data-tone='red'] { --tone: var(--p-red); --tone-soft: var(--p-red-soft); }
  [data-tone='pine'] { --tone: var(--p-pine); --tone-soft: #DCE6E3; }

  .mock__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .mock__title { font-weight: 600; font-size: 16px; }
  .mock__tag {
    flex: none; padding: 5px 10px; border-radius: 999px;
    background: var(--tone-soft); color: var(--tone); font-size: 12px; font-weight: 600;
  }

  .mock__table { display: grid; gap: 6px; }
  .mock__row {
    position: relative;
    display: grid; grid-template-columns: 1.6fr repeat(var(--rest), 1fr); gap: 8px; align-items: center;
    padding: 11px 12px; border-radius: 10px; background: #F6F8F7;
  }
  .mock__row[data-tone] { background: var(--tone-soft); }
  .mock__row[data-tone] > span:first-child { font-weight: 600; }
  .mock__row > span:not(:first-child) { text-align: right; white-space: nowrap; }
  .mock__row--head { background: none; padding-block: 0 4px; color: var(--p-muted); font-size: 12px; }
  .mock__note {
    position: absolute; right: 10px; top: -9px;
    padding: 2px 8px; border-radius: 999px;
    background: var(--tone); color: #fff; font-style: normal; font-size: 11px; font-weight: 600;
  }
  .mock__row:not([data-tone]) .mock__note { background: var(--p-amber); }

  .mock__foot { margin: 14px 0 0; font-size: 13px; color: var(--p-muted); }

  @media (max-width: 420px) {
    .mock { font-size: 13px; }
    .mock__row { padding: 10px; gap: 6px; }
  }
</style>
