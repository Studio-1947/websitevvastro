---
/**
 * Everything that is included: a centred heading over plain cards, each with
 * its icon on the red wash (same design as the BI Dashboards page's toolkit).
 * Four across, two on tablets and phones (compact there).
 */
import type { ToolkitContent } from './content';

interface Props { content: ToolkitContent }
const { content: c } = Astro.props;
---

<section class="kit" aria-labelledby="pharma-kit-title">
  <header class="kit__head">
    <h2 id="pharma-kit-title" class="p-title">{c.title}</h2>
    <p class="p-lede">{c.lede}</p>
  </header>
  <ul class="kit__grid" data-stagger>
    {c.tools.map((t) => (
      <li class="kit__card">
        <span class="kit__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
        </span>
        <h3 class="kit__title">{t.title}</h3>
        <p class="kit__body">{t.body}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .kit { max-width: 1280px; margin: 0 auto; padding: clamp(40px, 6vw, 96px) clamp(16px, 5vw, 72px) clamp(72px, 9vw, 140px); }
  .kit__head { text-align: center; margin-bottom: clamp(36px, 4.4vw, 56px); }
  .kit__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px;
  }
  .kit__card { display: flex; flex-direction: column; gap: 8px; padding: 14px 14px 22px; border-radius: 16px; background: var(--p-card); }
  .kit__icon {
    display: grid; place-items: center; width: 64px; height: 64px; margin-bottom: 18px; border-radius: 14px;
    background: var(--p-wash); color: var(--p-ink);
  }
  .kit__title { margin: 0; padding: 0 4px; font-size: 20px; line-height: 1.2; }
  .kit__body { margin: 0; padding: 0 4px; font-size: 15px; line-height: 1.5; color: var(--p-muted); }

  @media (max-width: 960px) { .kit__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) {
    .kit__grid { gap: 10px; }
    .kit__card { gap: 6px; padding: 10px 10px 16px; border-radius: 14px; }
    .kit__icon { width: 44px; height: 44px; margin-bottom: 8px; border-radius: 12px; }
    .kit__icon svg { width: 20px; height: 20px; }
    .kit__title { font-size: 17px; }
    .kit__body { font-size: 13.5px; }
  }
</style>
