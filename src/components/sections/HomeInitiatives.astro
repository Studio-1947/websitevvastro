---
/**
 * Home teaser for the Studio 1947 Initiative pages (Local Design,
 * Workshops), sitting above the FAQ. Each card links straight
 * through; the initiatives gate (scripts/initiativesGate.ts) shows the
 * "Coming soon" popup on the live host until a page is released.
 */
const CARDS = [
  {
    href: '/local-design/',
    image: '/assets/img/local-design/hero-banner.webp',
    icon: '<path d="M12 3 3 8l9 5 9-5-9-5Z" /><path d="M3 12l9 5 9-5M3 16l9 5 9-5" />',
    title: 'Local Design',
    body: 'Discovering young creators, preserving local design knowledge, and running free design-thinking workshops across rural India.',
  },
  {
    href: '/workshops/',
    image: '/assets/img/workshops/hero-banner.webp',
    icon: '<rect x="5" y="2" width="14" height="20" rx="2" /><path d="M9 18h6" />',
    title: 'Community Workshops',
    body: 'Free workshops on digital literacy, marketing, design thinking and AI, run for the community they take place in.',
  },
];
---

<section class="section container">
  <p class="eyebrow hi__eyebrow reveal" data-i18n="home.initiatives.eyebrow">Our Initiatives</p>
  <h2 class="hi__title reveal" data-i18n="home.initiatives.title">Giving back to the community</h2>
  <div class="hi__grid reveal">
    {CARDS.map((c) => (
      <a class="hi-card" href={c.href}>
        <span class="hi-card__media">
          <img src={c.image} alt={c.title} loading="lazy" />
        </span>
        <span class="hi-card__body-wrap">
          <span class="hi-card__ico" aria-hidden="true" set:html={`<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${c.icon}</svg>`} />
          <h3 class="hi-card__title">{c.title}</h3>
          <p class="hi-card__body">{c.body}</p>
          <span class="hi-card__link">
            Learn more
            <span class="arrow" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg></span>
          </span>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .hi__eyebrow { color: var(--red); }
  .hi__title { margin-top: 12px; font-size: clamp(30px, 3.6vw, 52px); line-height: 1.05; color: var(--grey-900); letter-spacing: -0.02em; }
  .hi__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(20px, 2.4vw, 34px); margin-top: clamp(28px, 3.4vw, 48px); max-width: 920px; }
  .hi-card {
    display: flex; flex-direction: column; overflow: hidden; text-decoration: none;
    border: 1px solid var(--line); border-radius: var(--radius-lg);
    transition: box-shadow .4s var(--ease), transform .4s var(--ease);
  }
  .hi-card:hover { box-shadow: 0 20px 50px rgba(0,0,0,.07); transform: translateY(-4px); }
  .hi-card__media { display: block; aspect-ratio: 16 / 10; overflow: hidden; }
  .hi-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .hi-card:hover .hi-card__media img { transform: scale(1.05); }
  .hi-card__body-wrap { display: flex; flex-direction: column; flex: 1; padding: clamp(24px, 2.4vw, 36px); }
  .hi-card__ico {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--bg-alt); color: var(--red);
    margin-bottom: clamp(14px, 1.6vw, 20px);
  }
  .hi-card__title { font-size: clamp(19px, 1.5vw, 23px); color: var(--grey-900); line-height: 1.2; }
  .hi-card__body { margin-top: 10px; font-size: clamp(14px, 1vw, 16px); color: var(--grey-700); line-height: 1.55; }
  .hi-card__link {
    margin-top: auto; padding-top: clamp(18px, 2vw, 26px); align-self: flex-start;
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 14px; font-weight: 600; color: var(--red);
  }
  .hi-card__link .arrow {
    display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--red); color: var(--red);
    transition: background .3s var(--ease), color .3s var(--ease), transform .3s var(--ease);
  }
  .hi-card:hover .hi-card__link .arrow { background: var(--red); color: #fff; transform: translateX(2px); }

  @media (max-width: 900px) {
    .hi__grid { grid-template-columns: 1fr; }
  }
</style>
