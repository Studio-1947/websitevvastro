---
/** Home FAQ accordion + Mirik photo. */
import { Image } from 'astro:assets';
import faqMirik from '../../assets/img/faq-mirik.jpg';
---

<section class="section container">
  <p class="eyebrow reveal" style="margin-bottom:28px" data-i18n="home.faq.eyebrow">Frequently Asked Questions</p>
  <div class="faq reveal">
    <div class="faq__media">
      {/* The one remaining JPEG on the page (332KB); astro:assets re-encodes it
          to WebP and drops the widths the 0.85fr column never needs. */}
      <Image
        src={faqMirik}
        sizes="(max-width: 1024px) 100vw, 42vw"
        quality={85} widths={[480, 720, 960, 1200]}
        alt="Sunset over Mirik lake and the Darjeeling hills, with the footbridge and hillside homes"
        loading="lazy"
      />
    </div>
    <div class="faq__list">
      <div class="faq__item">
        <button class="faq__q"><span data-i18n="home.faq.q1">What we do?</span> <span class="ico" aria-hidden="true"></span></button>
        <div class="faq__a"><div class="faq__a-inner">
          <p class="lead" data-i18n="home.faq.a1.lead">We design solutions that create impact.</p>
          <p data-i18n="home.faq.a1.body">We work where Data, Design, Technology, Communication and Research meet, to make the biggest possible difference for our clients and partners. That runs from evidence and strategy through to brand, product and growth.</p>
        </div></div>
      </div>
      <div class="faq__item">
        <button class="faq__q"><span data-i18n="home.faq.q2">Why Darjeeling</span> <span class="ico" aria-hidden="true"></span></button>
        <div class="faq__a"><div class="faq__a-inner">
          <p class="lead" data-i18n="home.faq.a2.lead">Local wisdom for global impact</p>
          <p data-i18n="home.faq.a2.body">We chose Darjeeling because creativity thrives where culture, nature and people meet. By building from the hills, we show that top-quality research, design, technology and communication can come from regional India.</p>
        </div></div>
      </div>
      <div class="faq__item">
        <button class="faq__q"><span data-i18n="home.faq.q3">Who is the Founder?</span> <span class="ico" aria-hidden="true"></span></button>
        <div class="faq__a"><div class="faq__a-inner">
          <p class="lead" data-i18n="home.faq.a3.lead">Farmer . Designer . Storyteller</p>
          <p data-i18n="home.faq.a3.body"><strong>Rabi</strong> / Rabiul Islam comes from a farming family in rural Bengal. He believes great ideas should not be held back by where you are or what you have. Through Studio 1947, he works where Data and Design meet.</p>
        </div></div>
      </div>
      <div class="faq__item">
        <button class="faq__q"><span data-i18n="home.faq.q4">Our Vision</span> <span class="ico" aria-hidden="true"></span></button>
        <div class="faq__a"><div class="faq__a-inner">
          <p class="lead" data-i18n="home.faq.a4.lead">Democratise innovation</p>
          <p data-i18n="home.faq.a4.body">We want Data, Design and Technology to be within reach, affordable and useful for every organisation: from grassroots communities and small local enterprises to governments, NGOs and global institutions.</p>
        </div></div>
      </div>
      <div class="faq__item">
        <button class="faq__q"><span data-i18n="home.faq.q5">How do we get started?</span> <span class="ico" aria-hidden="true"></span></button>
        <div class="faq__a"><div class="faq__a-inner">
          <p class="lead" data-i18n="home.faq.a5.lead">Simpler than you think</p>
          <p data-i18n="home.faq.a5.body">Tell us your challenge and we'll map out the solution. From the first conversation to a working platform, we guide every step.</p>
        </div></div>
      </div>
      <div class="faq__item">
        <button class="faq__q"><span data-i18n="home.faq.q6">Do you work with international clients?</span> <span class="ico" aria-hidden="true"></span></button>
        <div class="faq__a"><div class="faq__a-inner">
          <p class="lead" data-i18n="home.faq.a6.lead">From Darjeeling to the World</p>
          <p data-i18n="home.faq.a6.body">Yes. We work with organisations across the US, Europe and beyond, and deliver the same standards from our base in the hills.</p>
        </div></div>
      </div>
    </div>
  </div>
</section>
