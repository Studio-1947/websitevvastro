---
/** Home "Our Commitment" carousel + team photo. */
import { Image } from 'astro:assets';

// team-photo.webp, team-photo-2.webp, team-photo-3.webp, ... — every photo
// in the set is picked up automatically, sorted numerically so adding a new
// one is just dropping the file in and running the image script.
const teamPhotoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/img/team-photo*.webp',
  { eager: true },
);
const teamPhotos = Object.keys(teamPhotoModules)
  .sort((a, b) => {
    const numA = Number(a.match(/-(\d+)\.webp$/)?.[1] ?? 1);
    const numB = Number(b.match(/-(\d+)\.webp$/)?.[1] ?? 1);
    return numA - numB;
  })
  .map((key) => teamPhotoModules[key].default);
---

<section class="section container">
  <div class="commit reveal" data-commit>
    <div class="commit__col">
      <div class="commit__intro">
        <h2 class="commit__heading" data-i18n="home.commit.heading">Our Commitment</h2>
        <p class="commit__lead" data-i18n="home.commit.lead">We work where Data, Design, Technology, Communication and Research meet, to make the biggest possible difference for our clients and partners.</p>
        <a class="btn-hello commit__cta" href="/solutions/">
          <span data-i18n="home.commit.cta">Explore Solutions</span>
          <span class="arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
      </div>

      <div class="commit__card">
        <div class="commit__slides">
          <div class="commit__slide is-active">
            <h3 class="commit__title" data-i18n="home.commit.slideTitle">The People Behind the Work</h3>
            <p class="commit__body" data-i18n="home.commit.slideBody">A studio isn't a list of skills and job titles. It's the people who show up for each other, the field trips and late nights, the small wins we celebrate, and the memories that come with all of it.</p>
            <a class="btn-hello commit__team" href="/about-us/#team">
              <span data-i18n="home.commit.teamCta">Our Team</span>
              <span class="arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="commit__media" data-commit-photos>
      {teamPhotos.map((photo, i) => (
        <Image
          class:list={['commit__photo', i === 0 && 'is-active']}
          src={photo}
          sizes="(max-width: 760px) 100vw, 50vw"
          quality={85} widths={[640, 960, 1280, 1600]}
          alt="The Studio 1947 team"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))}
    </div>
  </div>
</section>
