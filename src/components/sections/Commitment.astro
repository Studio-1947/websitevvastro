---
/** Home "Our Commitment" carousel + team photo. */
---

<section class="section container">
  <div class="commit reveal" data-commit>
    <div class="commit__col">
      <div class="commit__intro">
        <h2 class="commit__heading">Our Commitment</h2>
        <p class="commit__lead">We innovate and create at the intersections of Data, Design, Technology, Communication and Research to achieve the best possible impact for our clients and partners.</p>
        <a class="btn-hello commit__cta" href="/solutions/">
          Explore Solutions
          <span class="arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
      </div>

      <div class="commit__card">
        <div class="commit__nav">
          <button data-commit-prev aria-label="Previous">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          </button>
          <button data-commit-next aria-label="Next">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
        <div class="commit__slides">
          <div class="commit__slide is-active">
            <h3 class="commit__title">Experienced Professionals</h3>
            <p class="commit__body">A multidisciplinary team of designers, technologists, researchers and communicators, working shoulder-to-shoulder with the communities and organisations we serve.</p>
          </div>
        </div>
      </div>
    </div>
    <div class="commit__media">
      <img src="/assets/img/team-photo.webp" alt="The Studio 1947 team" loading="lazy" />
    </div>
  </div>
</section>
