---
/** Home "Our Commitment" carousel + team photo. */
import { Image } from 'astro:assets';
import teamPhoto from '../../assets/img/team-photo.webp';
import teamPhoto2 from '../../assets/img/team-photo-2.webp';
import teamPhoto3 from '../../assets/img/team-photo-3.webp';
import teamPhoto4 from '../../assets/img/team-photo-4.webp';
import teamPhoto5 from '../../assets/img/team-photo-5.webp';
import teamPhoto6 from '../../assets/img/team-photo-6.webp';
import teamPhoto7 from '../../assets/img/team-photo-7.webp';
import teamPhoto8 from '../../assets/img/team-photo-8.webp';

const teamPhotos = [teamPhoto, teamPhoto2, teamPhoto3, teamPhoto4, teamPhoto5, teamPhoto6, teamPhoto7, teamPhoto8];
---

<section class="section container">
  <div class="commit reveal" data-commit>
    <div class="commit__col">
      <div class="commit__intro">
        <h2 class="commit__heading" data-i18n="home.commit.heading">Our Commitment</h2>
        <p class="commit__lead" data-i18n="home.commit.lead">We work where Data, Design, Technology, Communication and Research meet, to make the biggest possible difference for our clients and partners.</p>
        <a class="btn-hello commit__cta" href="/solutions/">
          <span data-i18n="home.commit.cta">Explore Solutions</span>
          <span class="arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
      </div>

      <div class="commit__card">
        <div class="commit__slides">
          <div class="commit__slide is-active">
            <h3 class="commit__title" data-i18n="home.commit.slideTitle">Experienced Professionals</h3>
            <p class="commit__body" data-i18n="home.commit.slideBody">A team of designers, technologists, researchers and communicators, working side by side with the communities and organisations we serve.</p>
            <a class="btn-hello commit__team" href="/about-us/#team">
              <span data-i18n="home.commit.teamCta">Our Team</span>
              <span class="arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="commit__media" data-commit-photos>
      {teamPhotos.map((photo, i) => (
        <Image
          class:list={['commit__photo', i === 0 && 'is-active']}
          src={photo}
          sizes="(max-width: 760px) 100vw, 50vw"
          quality={85} widths={[640, 960, 1280, 1600]}
          alt="The Studio 1947 team"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))}
    </div>
  </div>
</section>
