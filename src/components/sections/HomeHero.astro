---
/**
 * Home hero region: the interactive aurora canvas spans the hero + featured
 * work (masked in CSS), with the logo marquee (left edge to the middle of
 * the page) and the "Featured Work" label on the right between
 * them. Markup ported verbatim from the original index.html.
 *
 * Images go through <Image> (astro:assets) rather than raw <img> pointing at
 * `public/`: that stamps intrinsic width/height on every tag (no reflow as the
 * lazy tiles resolve mid-scroll) and emits a `srcset` so a phone decodes a
 * ~400px bitmap instead of the 1600px original. Decoding a 1600×1600 source
 * costs ~10MB of main-thread work at the exact moment it scrolls into view,
 * and Lenis drives scroll from the main thread, so that decode was landing as
 * visible scroll stutter.
 *
 * <Image> (not <Picture>) on purpose: <Picture> emits a <picture> wrapper, and
 * `.work-gallery .tile img { width:100%; height:100% }` resolves against that
 * inline wrapper instead of the fixed-height `.tile`, which collapses the
 * gallery.
 */
import { Image } from 'astro:assets';
import { clientLogos } from '../../assets/clientLogos';
import workShipflow from '../../assets/img/work-shipflow.webp';
import workAvishkar from '../../assets/img/work-avishkar.webp';
import workRajkamal from '../../assets/img/work-rajkamal.webp';
import workFes from '../../assets/img/work-fes.webp';
import workMirikSurvey from '../../assets/img/work-mirik-survey.webp';

// `.work-row` stacks below 760px; above it the tiles split the 1760px container
// on a 1 / 1.72 flex ratio, hence the two different desktop fractions.
const TILE_WIDE = '(max-width: 760px) 100vw, 63vw';
const TILE_NARROW = '(max-width: 760px) 100vw, 37vw';
const TILE_FULL = '100vw';

// `.marquee img` caps at `max-width: clamp(110px, 11vw, 152px)`, and the track
// is duplicated in JS for the seamless loop: so every logo is decoded twice.
// Describing the real display width matters more here than anywhere else on the
// page: a density srcset off the 641px source made these the single largest
// block of decoded pixels on a retina phone.
const LOGO_SIZES = '(max-width: 1024px) 110px, 152px';
const LOGO_WIDTHS = [160, 320, 480, 641];
---

<div class="hero-fx">
  <canvas class="hero-bg" data-hero-aurora aria-hidden="true"></canvas>

  <!-- ===== Hero ===== -->
  <section class="hero container" data-stagger>
    <h1 class="hero__title"><span data-i18n="home.hero.line1">We are Studio 1947.</span><br /><span data-i18n="home.hero.line2">Crafting and Co-Creating</span><br /><span class="hero__type" data-words="Data Solutions|Design Solutions|Tech Solutions|Communication Solutions|Marketing Solutions" data-words-i18n="home.hero.words">Data Solutions</span>.</h1>
  </section>

  <!-- ===== Logo marquee + Featured Work label on the right ===== -->
  <div class="fw-logos-row reveal">
    <div class="marquee" aria-label="Trusted by">
      <div class="marquee__track">
        {clientLogos.map((logo) => (
          <Image
            src={logo.src}
            class={logo.seal ? 'logo-seal': undefined}
            alt="Client logo"
            loading="lazy"
            quality={85}
            sizes={LOGO_SIZES}
            widths={LOGO_WIDTHS}
          />
        ))}
      </div>
    </div>
    <a class="hero__scroll fw-featured" href="#featured-work"><span class="hero__scroll-text" data-i18n="home.hero.featuredWork">Featured Work</span> <span class="down" aria-hidden="true"><i>&rsaquo;</i><i>&rsaquo;</i></span></a>
  </div>

  <!-- ===== Featured work ===== -->
  <section id="featured-work" class="section container" style="padding-top: clamp(8px, 1.2vw, 16px)">
    <div class="work-gallery reveal">
      <div class="work-row work-row--a">
        <a class="tile" href="/products/"><Image src={workShipflow} sizes={TILE_NARROW} quality={85} widths={[480, 720, 1080, 1440]} fetchpriority="high" alt="Analytics dashboard product design" loading="eager" /></a>
        <a class="tile" href="/work/awch/"><Image src={workAvishkar} sizes={TILE_WIDE} quality={85} widths={[640, 960, 1280, 1600]} fetchpriority="high" alt="Avishkar Women & Children Hospital brand & campaign design" loading="eager" /></a>
      </div>
      <div class="work-row work-row--b">
        <a class="tile" href="/work/rajkamal-prakashan/"><Image src={workRajkamal} sizes={TILE_WIDE} quality={85} widths={[640, 960, 1280, 1600]} alt="Rajkamal Prakashan campaign" loading="lazy" /></a>
        <a class="tile" href="/work/fes-india-publications/"><Image src={workFes} sizes={TILE_NARROW} quality={85} widths={[480, 720, 1080, 1401]} alt="Climate Justice in Action publication" loading="lazy" /></a>
      </div>
      <div class="work-row work-row--full">
        <a class="tile" href="/work/mirik-college/"><Image src={workMirikSurvey} sizes={TILE_FULL} quality={85} widths={[640, 960, 1280]} alt="Mirik College survey" loading="lazy" /></a>
      </div>
    </div>
  </section>
</div>

<script>
  // Typewriter for the hero heading: cycles through the solution areas.
  // Restartable via a `words-updated` event so a language switch (which
  // rewrites data-words, see ../../scripts/i18n.ts) picks up the new list
  // instead of finishing out the language it started in.
  const el = document.querySelector<HTMLElement>('.hero__type');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let gen = 0;
    const start = () => {
      const myGen = ++gen;
      const words = (el.dataset.words || '').split('|').filter(Boolean);
      if (!words.length) return;
      let w = 0, i = words[0].length, deleting = false;
      el.textContent = words[0];
      const tick = () => {
        if (myGen !== gen) return; // superseded by a newer language's word list
        const word = words[w];
        if (!deleting) {
          i++;
          el.textContent = word.slice(0, i);
          if (i >= word.length) { deleting = true; setTimeout(tick, 2200); return; }
          setTimeout(tick, 70);
        } else {
          i--;
          el.textContent = word.slice(0, i);
          if (i <= 0) { deleting = false; w = (w + 1) % words.length; setTimeout(tick, 350); return; }
          setTimeout(tick, 40);
        }
      };
      setTimeout(tick, 2200);
    };
    start();
    el.addEventListener('words-updated', start);
  }
</script>
