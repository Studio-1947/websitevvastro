---
/**
 * How it works: three numbered cards (connect, build, share), each with a
 * small picture of that step drawn in HTML on the red wash. Phones: stacked.
 * The pictures are decorative; the text on each card says the same thing.
 */
import type { StepsContent } from '../content';

interface Props { content: StepsContent }
const { content: c } = Astro.props;
---

<section class="steps" aria-labelledby="isd-steps-title">
  <header class="steps__head">
    <h2 id="isd-steps-title" class="p-title">{c.title}</h2>
    <p class="p-lede">{c.lede}</p>
    <ol class="steps__track" aria-hidden="true">
      {c.steps.map((s, i) => <li><span>{i + 1}</span>{s.label}</li>)}
    </ol>
  </header>

  <ol class="steps__grid" data-stagger>
    {c.steps.map((s, i) => (
      <li class="step">
        <div class="step__art" aria-hidden="true">
          {i === 0 && (
            <div class="art art--connect">
              <ul class="art__sources">
                {c.sources.map((x) => <li><i style={`--c: ${x.color}`}></i>{x.label}</li>)}
              </ul>
              <span class="art__wires"><i></i><i></i><i></i><i></i></span>
              <span class="art__hub">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M5 19v-6M12 19V5M19 19v-9" /></svg>
                <b>Synced</b>
              </span>
            </div>
          )}
          {i === 1 && (
            <div class="art art--build">
              <div class="art__kpis"><span><small>Net revenue</small><b>₹5.53 Cr</b></span><span><small>Units</small><b>2,63,818</b></span></div>
              <div class="art__chart">
                <svg viewBox="0 0 200 60" preserveAspectRatio="none"><path d="M0 46 C25 40 40 22 65 26 S105 44 130 30 S175 10 200 14" /></svg>
              </div>
              <div class="art__chips"><i class="is-on">Snapshot</i><i>Momentum</i><i>Stock Health</i></div>
            </div>
          )}
          {i === 2 && (
            <div class="art art--share">
              <div class="art__mail">
                <span class="art__from"><i>YB</i><span><b>Monday sales report</b><small>To: store managers · 8:00 am</small></span></span>
                <span class="art__line"></span><span class="art__line art__line--short"></span>
              </div>
              <div class="art__roles"><i>Owner · all channels</i><i>Store manager · own store</i></div>
            </div>
          )}
        </div>
        <p class="step__label"><span>{i + 1}</span>{s.label}</p>
        <h3 class="step__title">{s.title}</h3>
        <p class="step__body">{s.body}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .steps { max-width: 1280px; margin: 0 auto; padding: clamp(56px, 7vw, 110px) clamp(16px, 5vw, 72px) clamp(24px, 3vw, 40px); }
  .steps__head { text-align: center; margin-bottom: clamp(32px, 4vw, 52px); }
  .steps__track {
    list-style: none; margin: 26px auto 0; padding: 0;
    display: flex; justify-content: center; align-items: center; gap: 12px; flex-wrap: wrap;
    font-size: 15px; font-weight: 500;
  }
  .steps__track li { display: flex; align-items: center; gap: 8px; }
  .steps__track li + li::before { content: ''; width: clamp(24px, 5vw, 64px); height: 1px; margin-right: 4px; background: var(--p-line); }
  .steps__track span, .step__label span {
    display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%;
    background: var(--p-ink); color: #fff; font-size: 13px;
  }

  .steps__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .step { display: flex; flex-direction: column; padding: 12px 12px 26px; border-radius: 16px; background: var(--p-card); }
  .step__art { display: grid; place-items: center; height: clamp(220px, 20vw, 260px); margin-bottom: 22px; padding: 18px; border-radius: 12px; background: var(--p-wash); }
  .step__label { display: flex; align-items: center; gap: 10px; margin: 0 12px 10px; font-size: 14px; font-weight: 600; color: var(--p-muted); text-transform: uppercase; letter-spacing: .08em; }
  .step__title { margin: 0 12px 8px; font-size: clamp(22px, 1.9vw, 26px); line-height: 1.2; }
  .step__body { margin: 0 12px; font-size: 15.5px; line-height: 1.55; color: var(--p-muted); }

  /* ----- The pictures: small white cards on the wash ----- */
  .art { width: 100%; max-width: 330px; font-size: 12px; color: var(--p-ink); }
  .art :where(i) { font-style: normal; }

  .art--connect { display: grid; grid-template-columns: 1fr 44px auto; align-items: center; }
  .art__sources { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .art__sources li {
    display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 10px; background: #fff;
    box-shadow: 0 8px 18px -12px rgba(14, 56, 50, .45); font-weight: 500;
  }
  .art__sources i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .art__wires { display: grid; gap: 22px; padding: 6px 0; }
  .art__wires i { height: 2px; border-radius: 1px; background: repeating-linear-gradient(90deg, rgba(13, 13, 13, .35) 0 5px, transparent 5px 9px); }
  .art__hub {
    display: grid; place-items: center; gap: 4px; width: 84px; height: 84px; border-radius: 22px;
    background: #0B3A6B; color: #fff; box-shadow: 0 14px 28px -14px rgba(11, 58, 107, .8);
  }
  .art__hub b { font-size: 11px; font-weight: 600; }

  .art--build { display: grid; gap: 8px; padding: 12px; border-radius: 14px; background: #fff; box-shadow: 0 18px 36px -20px rgba(14, 56, 50, .45); }
  .art__kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .art__kpis span { display: grid; padding: 8px 10px; border-radius: 10px; background: #F4F6F8; }
  .art__kpis small { font-size: 9.5px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--p-muted); }
  .art__kpis b { font-size: 15px; font-weight: 500; }
  .art__chart { height: 64px; padding: 6px 0; border-radius: 10px; background: linear-gradient(180deg, rgba(37, 99, 235, .1), transparent); }
  .art__chart svg { width: 100%; height: 100%; }
  .art__chart path { fill: none; stroke: #2563EB; stroke-width: 2.5; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .art__chips { display: flex; gap: 6px; }
  .art__chips i { padding: 4px 9px; border-radius: 0 0 7px 7px; background: #E3E8EF; color: #5B6B82; font-size: 10.5px; font-weight: 500; }
  .art__chips i.is-on { background: #1565C0; color: #fff; }

  .art--share { display: grid; gap: 10px; }
  .art__mail { display: grid; gap: 8px; padding: 14px; border-radius: 14px; background: #fff; box-shadow: 0 18px 36px -20px rgba(14, 56, 50, .45); }
  .art__from { display: flex; align-items: center; gap: 10px; }
  .art__from i { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: #E5E7EB; color: #6B7280; font-size: 11px; font-weight: 700; }
  .art__from span { display: grid; line-height: 1.25; }
  .art__from b { font-size: 13px; }
  .art__from small { font-size: 10.5px; color: var(--p-muted); }
  .art__line { height: 7px; border-radius: 4px; background: #EEF0F4; }
  .art__line--short { width: 62%; }
  .art__roles { display: flex; flex-wrap: wrap; gap: 6px; }
  .art__roles i { padding: 5px 10px; border-radius: 999px; background: #fff; box-shadow: 0 6px 14px -10px rgba(14, 56, 50, .5); font-size: 11px; font-weight: 500; }

  @media (max-width: 900px) {
    .steps__grid { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
  }
</style>
