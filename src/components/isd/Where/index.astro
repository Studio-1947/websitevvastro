---
/**
 * Location section: what the Geo Insights screen does, told with a large map
 * of India. Text, a Statewise / PINcodewise toggle and a ranked list on one
 * side, the map (with state borders) on a flat light red panel on the other. Phones:
 * text, toggle, list, then map.
 *
 * Statewise ranks states and puts a pin on each; PINcodewise ranks delivery
 * areas and pins each one. Pins are sized and shaded by share (deeper red =
 * bigger share). The page renders the statewise view, so it reads the same
 * without JavaScript; the script below redraws on toggle.
 */
import IndiaMap from '../Map/IndiaMap.astro';
import { shade } from '../Map/shade';
import type { WhereContent, Place } from '../content';

interface Props { content: WhereContent }
const { content: c } = Astro.props;

/** States ranked by revenue, with a revenue-weighted centre for the pin. */
function byState(places: Place[]) {
  const m = new Map<string, { label: string; revenue: number; lon: number; lat: number }>();
  for (const p of places) {
    const e = m.get(p.state) ?? { label: p.state, revenue: 0, lon: 0, lat: 0 };
    e.lon = (e.lon * e.revenue + p.lon * p.revenue) / (e.revenue + p.revenue);
    e.lat = (e.lat * e.revenue + p.lat * p.revenue) / (e.revenue + p.revenue);
    e.revenue += p.revenue;
    m.set(p.state, e);
  }
  return [...m.values()].sort((a, b) => b.revenue - a.revenue);
}
const SHOWN = 7;
const total = c.places.reduce((n, p) => n + p.revenue, 0);
const states = byState(c.places).slice(0, SHOWN).map((x) => ({ ...x, share: x.revenue / total }));
const top = states[0].share;
const crore = (lakh: number) => `₹${(lakh / 100).toFixed(2)} Cr`;
---

<section class="where" aria-labelledby="isd-where-title" data-where data-places={JSON.stringify(c.places)}>
  <div class="where__copy">
    <h2 id="isd-where-title" class="where__title">{c.title}</h2>
    <p class="where__body">{c.body}</p>

    <div class="where__seg" role="group" aria-label="Group by">
      <button type="button" data-mode="state" aria-pressed="true">Statewise</button>
      <button type="button" data-mode="pincode" aria-pressed="false">PINcodewise</button>
    </div>

    <p class="where__sum">
      <span class="where__sumName">All of India</span>
      <b>{crore(total)}</b>
    </p>

    <ol class="where__list" data-where-list data-stagger aria-live="polite">
      {states.map((x, i) => (
        <li>
          <span class="where__rank">{i + 1}</span>
          <span class="where__city">{x.label}</span>
          <span class="where__bar"><i style={`width: ${(x.share / top) * 100}%`}></i></span>
          <b>{Math.round(x.share * 100)}%</b>
        </li>
      ))}
    </ol>
    <p class="where__foot">{c.foot}</p>
  </div>
  <div class="where__panel reveal">
    <div class="where__map"><IndiaMap pins={states} size={26} /></div>
    <div class="where__legend" aria-hidden="true">
      <span>Smaller share</span>
      <span class="where__steps">{[0, 0.33, 0.67, 1].map((t) => <i style={`background: ${shade(t)}`}></i>)}</span>
      <span>Bigger share</span>
    </div>
  </div>
</section>

<script>
  import { project, INDIA } from '../Map/india';
  import { shade } from '../Map/shade';
  import type { Place } from '../content';

  interface Row { key: string; label: string; pin: string; revenue: number; lon: number; lat: number }

  const SVG = 'http://www.w3.org/2000/svg';
  const SHOWN = 7;

  function init(root: HTMLElement): void {
    const places: Place[] = JSON.parse(root.dataset.places || '[]');
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const list = root.querySelector<HTMLOListElement>('[data-where-list]')!;
    const svg = root.querySelector<SVGSVGElement>('[data-imap]')!;
    const pinsLayer = svg.querySelector<SVGGElement>('[data-pins]')!;
    const total = places.reduce((n, p) => n + p.revenue, 0);

    const pct = (x: number) => (x >= 0.1 ? `${Math.round(x * 100)}%` : `${(x * 100).toFixed(1)}%`);

    function stateRows(): Row[] {
      const m = new Map<string, Row>();
      for (const p of places) {
        const e = m.get(p.state) ?? { key: p.state, label: p.state, pin: p.state, revenue: 0, lon: 0, lat: 0 };
        e.lon = (e.lon * e.revenue + p.lon * p.revenue) / (e.revenue + p.revenue);
        e.lat = (e.lat * e.revenue + p.lat * p.revenue) / (e.revenue + p.revenue);
        e.revenue += p.revenue;
        m.set(p.state, e);
      }
      return [...m.values()].sort((a, b) => b.revenue - a.revenue);
    }

    function pincodeRows(): Row[] {
      return places
        .map((p) => ({ key: p.pincode, label: `${p.pincode} · ${p.area}`, pin: p.pincode, revenue: p.revenue, lon: p.lon, lat: p.lat }))
        .sort((a, b) => b.revenue - a.revenue);
    }

    /** Every place gets a pin; the top few get a label, unless it would sit on one already placed. */
    function drawPins(rows: Row[]): void {
      pinsLayer.replaceChildren();
      const most = rows[0].revenue;
      const least = rows[rows.length - 1].revenue;
      const placed: [number, number][] = [];
      const labelled = new Set<string>();
      rows.slice(0, SHOWN).forEach((r) => {
        const [x, y] = project(r.lon, r.lat);
        if (placed.some(([px, py]) => Math.abs(py - y) < 18 && Math.abs(px - x) < 130)) return;
        placed.push([x, y]);
        labelled.add(r.key);
      });
      // Smallest first, so big pins sit on top.
      [...rows].reverse().forEach((r, i) => {
        const [x, y] = project(r.lon, r.lat);
        const rel = most === least ? 1 : (r.revenue - least) / (most - least);
        const rad = Math.max(5, 26 * Math.sqrt(r.revenue / most));
        const g = document.createElementNS(SVG, 'g');
        g.setAttribute('class', 'imap__pin');
        g.style.setProperty('--pin', shade(rel));
        g.style.setProperty('--d', `${Math.min(rows.length - 1 - i, 12) * 40}ms`);
        const dot = document.createElementNS(SVG, 'circle');
        dot.setAttribute('class', 'imap__dot');
        dot.setAttribute('cx', x.toFixed(1));
        dot.setAttribute('cy', y.toFixed(1));
        dot.setAttribute('r', rad.toFixed(1));
        g.append(dot);
        if (labelled.has(r.key)) {
          const left = x > INDIA.w * 0.62;
          const text = document.createElementNS(SVG, 'text');
          text.setAttribute('class', 'imap__label');
          text.setAttribute('x', (x + (left ? -rad - 6 : rad + 6)).toFixed(1));
          text.setAttribute('y', (y + 5).toFixed(1));
          text.setAttribute('text-anchor', left ? 'end' : 'start');
          text.textContent = r.pin;
          g.append(text);
        }
        pinsLayer.append(g);
      });
    }

    function drawList(rows: Row[]): void {
      const shown = rows.slice(0, SHOWN);
      const most = shown[0].revenue;
      list.replaceChildren(
        ...shown.map((r, i) => {
          const li = document.createElement('li');
          li.innerHTML =
            `<span class="where__rank">${i + 1}</span>` +
            `<span class="where__city"></span>` +
            `<span class="where__bar"><i style="width: ${(r.revenue / most) * 100}%"></i></span>` +
            `<b>${pct(r.revenue / total)}</b>`;
          li.querySelector('.where__city')!.textContent = r.label;
          return li;
        })
      );
    }

    function show(mode: string): void {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
      const rows = mode === 'pincode' ? pincodeRows() : stateRows();
      drawPins(rows);
      drawList(rows);
    }

    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.mode || 'state')));
    show('state');
  }

  document.querySelectorAll<HTMLElement>('[data-where]').forEach(init);
</script>

<style>
  .where {
    max-width: 1280px; margin: 0 auto;
    padding: clamp(56px, 7vw, 110px) clamp(16px, 5vw, 72px);
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 100px); align-items: center;
  }
  .where__title { margin: 0 0 18px; font-size: clamp(30px, 3vw, 44px); line-height: 1.1; }
  .where__body { margin: 0 0 24px; max-width: 42ch; font-size: clamp(16px, 1.2vw, 18px); line-height: 1.6; }

  /* Two-way toggle, one pill with the active side filled. */
  .where__seg {
    display: inline-flex; gap: 4px; padding: 4px; margin-bottom: 22px;
    border-radius: 999px; background: var(--p-card);
  }
  .where__seg button {
    font: inherit; font-size: 15px; line-height: 1; color: var(--p-ink);
    padding: 11px 20px; border: 0; border-radius: 999px; background: transparent; cursor: pointer;
    transition: background .25s ease, color .25s ease;
  }
  .where__seg button:hover { color: #b30000; }
  .where__seg button[aria-pressed='true'] { background: #e60000; color: #fff; }
  .where__seg button:focus-visible { outline: 3px solid rgba(230, 0, 0, .35); outline-offset: 2px; }

  .where__sum { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin: 0 0 16px; font-size: 15px; }
  .where__sumName { font-weight: 600; }
  .where__sum > b { font-size: 20px; font-weight: 600; color: #b30000; }

  .where__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .where__list :global(li) { display: grid; grid-template-columns: 26px minmax(0, 200px) 1fr 48px; align-items: center; gap: 12px; font-size: 15px; }
  .where__list :global(.where__rank) { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--p-card); font-size: 12px; font-weight: 600; }
  .where__list :global(.where__city) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .where__list :global(.where__bar) { height: 8px; border-radius: 999px; background: var(--p-card); overflow: hidden; }
  .where__list :global(.where__bar i) { display: block; height: 100%; border-radius: inherit; background: #e60000; opacity: .8; }
  .where__list :global(b) { text-align: right; font-weight: 500; }
  .where__foot { margin: 22px 0 0; font-size: 14px; color: var(--p-muted); }

  .where__panel {
    display: grid; justify-items: center; gap: 16px;
    padding: clamp(24px, 4vw, 56px);
    /* A flat light red, not the gradient --p-wash. */
    border-radius: 16px; background: #FFECE9;
  }
  .where__map {
    width: 100%; max-width: 520px; aspect-ratio: 543 / 612;
    --map-land: rgba(255, 255, 255, .92); --map-edge: rgba(13, 13, 13, .22);
    --map-state: rgba(13, 13, 13, .14); --map-label: var(--p-ink);
  }

  .where__legend { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--p-muted); }
  /* Flat steps of the pin colours, smallest to biggest share. */
  .where__steps { display: flex; gap: 3px; }
  .where__steps i { display: block; width: 22px; height: 10px; border-radius: 3px; }

  @media (max-width: 860px) {
    .where { grid-template-columns: 1fr; }
    .where__panel { padding: 20px 14px; }
  }
  @media (max-width: 420px) {
    .where__seg { display: flex; }
    .where__seg button { flex: 1; padding: 11px 12px; }
    .where__list :global(li) { grid-template-columns: 26px minmax(0, 1fr) 70px 44px; gap: 10px; font-size: 14px; }
  }
</style>
