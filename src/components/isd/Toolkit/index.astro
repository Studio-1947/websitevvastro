---
/**
 * Everything that is included: a centred heading over plain cards, each with
 * its icon on the red wash. Four across, two on tablets and phones (compact there).
 */
import type { ToolkitContent } from '../content';

interface Props { content: ToolkitContent }
const { content: c } = Astro.props;
---

<section class="tk" aria-labelledby="isd-tk-title">
  <header class="tk__head">
    <h2 id="isd-tk-title" class="p-title">{c.title}</h2>
    <p class="p-lede">{c.lede}</p>
  </header>
  <ul class="tk__grid" data-stagger>
    {c.tools.map((t) => (
      <li class="tk__card">
        <span class="tk__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
        </span>
        <h3 class="tk__title">{t.title}</h3>
        <p class="tk__body">{t.body}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .tk { max-width: 1280px; margin: 0 auto; padding: clamp(56px, 7vw, 110px) clamp(16px, 5vw, 72px) clamp(72px, 9vw, 140px); }
  .tk__head { text-align: center; margin-bottom: clamp(36px, 4.4vw, 56px); }
  .tk__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }

  .tk__card { display: flex; flex-direction: column; gap: 8px; padding: 14px 14px 22px; border-radius: 16px; background: var(--p-card); }
  .tk__icon {
    display: grid; place-items: center; width: 64px; height: 64px; margin-bottom: 18px; border-radius: 14px;
    background: var(--p-wash); color: var(--p-ink);
  }
  .tk__title { margin: 0; padding: 0 4px; font-size: 20px; line-height: 1.2; }
  .tk__body { margin: 0; padding: 0 4px; font-size: 15px; line-height: 1.5; color: var(--p-muted); }

  @media (max-width: 960px) { .tk__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) {
    .tk__grid { gap: 10px; }
    .tk__card { gap: 6px; padding: 10px 10px 16px; border-radius: 14px; }
    .tk__icon { width: 44px; height: 44px; margin-bottom: 8px; border-radius: 12px; }
    .tk__icon svg { width: 20px; height: 20px; }
    .tk__title { font-size: 17px; }
    .tk__body { font-size: 13.5px; }
  }
</style>
