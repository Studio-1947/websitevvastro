---
/**
 * "More work" rail that closes every case study: three project cards at a
 * time, styled like the /our-work/ cards, with arrows that page through the
 * rest. It replaces the old closing
 * pitch block, so the page ends by handing the reader somewhere else to go
 * rather than by asking them for something.
 */
import { otherWork, workCardsLinked } from '../../lib/otherWork';

interface Props {
  /** Slug of the case being read, so it is left out of its own rail. */
  current?: string;
  title?: string;
}
const { current, title = 'More work' } = Astro.props;
const cards = otherWork(current);
// Cards link through under `astro dev` only, matching /our-work/, while the
// case studies are reworked.
const Card = workCardsLinked ? 'a' : 'div';
---

{
  cards.length > 0 && (
    <section class="more-work" data-work-rail>
      <div class="more-work__head">
        <h2 class="more-work__title">{title}</h2>
        <div class="more-work__nav">
          <button
            class="more-work__arrow"
            type="button"
            aria-label="Previous projects"
            data-rail-prev
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5M11 6l-6 6 6 6" />
            </svg>
          </button>
          <button
            class="more-work__arrow"
            type="button"
            aria-label="More projects"
            data-rail-next
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </button>
        </div>
      </div>

      <div class="more-work__track" data-rail-track>
        {cards.map((c, i) => (
          <Card
            class:list={['more-work__card', !workCardsLinked && 'more-work__card--soon']}
            href={workCardsLinked ? c.href : undefined}
            aria-disabled={workCardsLinked ? undefined : 'true'}
          >
            <div class="more-work__media">
              {/* The first page of the rail is on screen as soon as the reader
                  reaches it, so those four load eagerly rather than flashing
                  as empty frames. */}
              <img src={c.img} alt={c.alt} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
            </div>
            <div class="more-work__body">
              {c.tags.length > 0 && (
                <div class="more-work__tags">
                  {c.tags.slice(0, 3).map((t) => (
                    <span class="more-work__tag">{t}</span>
                  ))}
                </div>
              )}
              <h3 class="more-work__name">{c.title}</h3>
              {c.meta.length > 0 && (
                <p class="more-work__meta">
                  {c.meta.map((m) => (
                    <span set:html={m} />
                  ))}
                </p>
              )}
            </div>
          </Card>
        ))}
      </div>

      <a class="more-work__all" href="/our-work/">
        View all work
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </section>
  )
}
