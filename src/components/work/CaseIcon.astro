---
/**
 * The small line icons a case card can carry. Drawn inline as stroked paths on
 * a 24px grid so they inherit the brand colour and stay crisp at any size, and
 * kept to one shared set so cards across cases look like one family.
 */
interface Props {
  name: string;
  /** Class on the <svg>, so the same set works in cards and in labels. */
  class?: string;
  size?: number;
}
const { name, class: cls = 'case-card__icon', size = 26 } = Astro.props;

const PATHS: Record<string, string> = {
  // one identity across every surface
  layers: 'M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5M3 18l9 5 9-5',
  star: 'M12 3.5l2.6 5.4 5.9.8-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.7l5.9-.8L12 3.5Z',
  leaf: 'M20 4c0 9-5.5 13-11 13a5 5 0 0 1-5-5C4 6.5 12 4 20 4ZM4 20c3-6 7-9 12-11',
  growth: 'M3 20h18M6 20v-6M11 20V9M16 20v-9M21 6l-5.5 5.5-3-3L7 14',
  users: 'M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 20v-2a4 4 0 0 0-3-3.9M16 2.1a4 4 0 0 1 0 7.8',
  shield: 'M12 22s8-3.2 8-9.6V5.4L12 2.4 4 5.4v7C4 18.8 12 22 12 22Z',
  clock: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20ZM12 6.5V12l3.5 2.2',
  map: 'M9 3 3 5.5v15L9 18l6 3 6-2.5v-15L15 6 9 3Zm0 0v15m6-12v15',
  phone: 'M7 2h10a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1Zm3 17h4',
  chart: 'M3 3v18h18M7 15l4-5 3 3 5-7',
  heart: 'M12 20.5S3.5 15.3 3.5 9.3A4.8 4.8 0 0 1 12 6.4a4.8 4.8 0 0 1 8.5 2.9c0 6-8.5 11.2-8.5 11.2Z',
  spark: 'M12 3v5M12 16v5M3 12h5M16 12h5M6.3 6.3l3.5 3.5M14.2 14.2l3.5 3.5M17.7 6.3l-3.5 3.5M9.8 14.2l-3.5 3.5',
  boat: 'M4 18h16l-2 3H6l-2-3ZM12 3v12M12 15 5 13l7-8 7 8-7 2Z',
  book: 'M4 4h7a2 2 0 0 1 2 2v14a2 2 0 0 0-2-2H4V4Zm16 0h-7a2 2 0 0 0-2 2v14a2 2 0 0 1 2-2h7V4Z',
};
const d = PATHS[name] ?? PATHS.spark;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>
