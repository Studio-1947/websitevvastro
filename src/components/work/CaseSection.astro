---
/**
 * One case-study block: optional heading + brand pill + prose + media grid.
 * Supports split layout (text left, media right).
 */
import CaseFigure from './CaseFigure.astro';
import CaseAudio from './CaseAudio.astro';
import CaseStats from './CaseStats.astro';
import CaseIcon from './CaseIcon.astro';
import CaseCardArt from './CaseCardArt.astro';

interface AudioTrack {
  title: string;
  artist?: string;
  origin?: string;
  genre?: string;
  duration?: string;
  src: string;
}

interface Media {
  src: string;
  alt: string;
  caption?: string;
  zoom?: boolean;
  pad?: boolean;
  ratio?: string;
  maxWidth?: number;
  loop?: boolean;
  full?: string;
}
interface Card {
  num?: string;
  /** Line icon drawn above the title (see CaseIcon for the set). */
  icon?: string;
  title: string;
  body?: string;
}
interface Stat {
  value: number;
  prefix?: string;
  suffix?: string;
  decimals?: number;
  group?: 'in' | 'en';
  label: string;
  note?: string;
}
interface Swatch {
  hex: string;
  name: string;
  role?: string;
  note?: string;
}
interface Props {
  heading?: string;
  subheading?: string;
  label?: string;
  body?: string[];
  list?: string[];
  swatches?: Swatch[];
  /** Headline figures, counted up on scroll, growth cases lead with these. */
  stats?: Stat[];
  statsCaption?: string;
  cards?: Card[];
  media?: Media[];
  embed?: { src: string; title: string };
  /** Same-origin iframe for a locally shipped motion piece. */
  localEmbed?: { src: string; title: string; bleed?: boolean };
  /** Playable field recordings (Sundargaan): rendered as a track-list player. */
  audio?: AudioTrack[];
  layout?: 'stack' | 'split' | 'grid-2' | 'grid-3' | 'row';
  /** 'none' butts the section's figures together with no gap between them. */
  gap?: 'default' | 'none' | string;
  /** Opt-in: full-bleed background colour for this section (light type). */
  band?: string;
  /** Opt-in: image floated huge and soft behind the section's content. */
  backdrop?: string;
  /** Mark drawn inside the section label (see CaseIcon for the set). */
  labelIcon?: string;
  /** Photograph shown behind the swatch grid: where the palette came from. */
  swatchBackdrop?: string;
  divider?: boolean;
  /** First section after the hero: its media loads eagerly. */
  first?: boolean;
  /** `work.<slug>.s<index>` prefix for this section's structural data-i18n
      keys (heading, subheading, label, card titles, stat/swatch labels).
      Narrative prose (body, list, card bodies) is intentionally excluded. */
  i18nKey?: string;
  /** Opt-in: run this section's media edge-to-edge even on a
      `mediaStyle: 'contained'` case. */
  bleed?: boolean;
  boxed?: boolean;
}

function swatchInk(hex: string): string {
  const v = (i: number) => {
    const c = parseInt(hex.slice(1 + i * 2, 3 + i * 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92: ((c + 0.055) / 1.055) ** 2.4;
  };
  const L = 0.2126 * v(0) + 0.7152 * v(1) + 0.0722 * v(2);
  return L > 0.223 ? '#10240f': '#ffffff';
}

const {
  heading,
  subheading,
  label,
  body = [],
  list = [],
  swatches = [],
  stats = [],
  statsCaption,
  cards = [],
  media = [],
  embed,
  localEmbed,
  audio = [],
  layout = 'stack',
  gap = 'default',
  band,
  backdrop,
  labelIcon,
  swatchBackdrop,
  divider = true,
  first = false,
  bleed = false,
  boxed = false,
  i18nKey,
} = Astro.props;

const SubheadingTag = subheading ? (heading ? 'h3': 'h2'): null;
const CardTitleTag = subheading ? (heading ? 'h4': 'h3'): heading ? 'h3': 'h2';
const isSplit = layout === 'split';
const isScroller = layout === 'scroller';
// The scroller reads as two rails: the first half of the figures on top, the
// rest beneath, so the set keeps its authored order left to right, row by row.
const scrollerRows = isScroller
  ? [media.slice(0, Math.ceil(media.length / 2)), media.slice(Math.ceil(media.length / 2))].filter(
      (r) => r.length > 0,
    )
  : [];
---

<section
  class:list={[
    'case-section',
    divider && 'case-section--divided',
    first && 'case-section--first',
    isSplit && 'case-section--split',
    band && 'case-section--band',
    backdrop && 'case-section--backdrop',
    bleed && 'case-section--bleed',
    boxed && 'case-section--boxed',
  ]}
  style={band ? `--band: ${band}`: undefined}
>
  {backdrop && (
    <img class="case-section__backdrop" src={backdrop} alt="" aria-hidden="true" loading="lazy" />
  )}
  {
    isSplit ? (
      <div class="case-split case-shell">
        <div class="case-split__content">
          {label && (
            <span class="case-label">
              <CaseIcon name={labelIcon ?? 'spark'} class="case-label__icon" size={15} />
              <span data-i18n={i18nKey && `${i18nKey}.label`}>{label}</span>
            </span>
          )}
          {heading && <h2 class="case-section__heading" data-i18n={i18nKey && `${i18nKey}.heading`}>{heading}</h2>}
          {SubheadingTag && <SubheadingTag class="case-section__subheading" data-i18n={i18nKey && `${i18nKey}.subheading`}>{subheading}</SubheadingTag>}

          {body.length > 0 && (
            <div class="case-prose">
              {body.map((p) => (
                <p set:html={p} />
              ))}
            </div>
          )}

          {list.length > 0 && (
            <ul class="case-list">
              {list.map((item) => (
                <li set:html={item} />
              ))}
            </ul>
          )}
        </div>

        {media.length > 0 && (
          <div class="case-split__media">
            {media.map((m) => (
              <CaseFigure {...m} eager={first} />
            ))}
          </div>
        )}
      </div>
    ): (
      <>
        <div class="case-shell">
        {heading && <h2 class="case-section__heading" data-i18n={i18nKey && `${i18nKey}.heading`}>{heading}</h2>}
        {SubheadingTag && <SubheadingTag class="case-section__subheading" data-i18n={i18nKey && `${i18nKey}.subheading`}>{subheading}</SubheadingTag>}
        {label && (
          <span class="case-label">
            <CaseIcon name={labelIcon ?? 'spark'} class="case-label__icon" size={15} />
            <span data-i18n={i18nKey && `${i18nKey}.label`}>{label}</span>
          </span>
        )}

        {body.length > 0 && (
          <div class="case-prose">
            {body.map((p) => (
              <p set:html={p} />
            ))}
          </div>
        )}

        {list.length > 0 && (
          <ul class="case-list">
            {list.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        )}

        {/* Two lines at most in a swatch: the role it plays and what it is
            called. The longer note rides along as the block's title, so the
            grid reads as colour rather than as copy. */}
        {swatches.length > 0 && (
          <div
            class:list={['case-swatches', swatchBackdrop && 'case-swatches--backdrop']}
            style={swatchBackdrop ? `--swatch-bg: url('${swatchBackdrop}')` : undefined}
          >
            {swatches.map((s, i) => (
              <div
                class="case-swatch"
                style={`--sw: ${s.hex}; --sw-ink: ${swatchInk(s.hex)}`}
                title={s.note}
              >
                <div class="case-swatch__head">
                  {s.role && <span class="case-swatch__role" data-i18n={i18nKey && `${i18nKey}.swatch${i}.role`}>{s.role}</span>}
                  <span class="case-swatch__name" data-i18n={i18nKey && `${i18nKey}.swatch${i}.name`}>{s.name}</span>
                </div>
                <div class="case-swatch__foot">
                  <span class="case-swatch__num">{i + 1}</span>
                  <span class="case-swatch__hex">{s.hex.toUpperCase()}</span>
                </div>
              </div>
            ))}
          </div>
        )}

        {stats.length > 0 && <CaseStats stats={stats} caption={statsCaption} i18nKey={i18nKey} />}

        {cards.length > 0 && (
          <div class:list={['case-cards', `case-cards--${layout === 'stack' ? 'grid-3': layout}`]}>
            {cards.map((c, i) => (
              <div class:list={['case-card', c.icon && 'case-card--icon']} data-spotlight>
                {/* A card carries either a mark of its own or the house line
                    motif; never both, and never nothing. */}
                {c.icon ? <CaseIcon name={c.icon} /> : <CaseCardArt index={i} />}
                {c.num && <div class="case-card__num">{c.num}</div>}
                <CardTitleTag class="case-card__title" data-i18n={i18nKey && `${i18nKey}.card${i}.title`}>{c.title}</CardTitleTag>
                {c.body && <p class="case-card__body" set:html={c.body} />}
              </div>
            ))}
          </div>
        )}

        </div>

        {media.length > 0 && (
          isScroller ? (
            /* Two horizontally scrolling rows, arrows paging both together.
               Opt-in per section (`layout: 'scroller'`) for a large uniform
               set of pieces that would stack into an endless column. */
            <div class="case-scroller" data-case-scroller>
              {scrollerRows.map((row, r) => (
                <div class="case-scroller__row" data-scroller-track data-scroller-dir={r % 2 === 0 ? '1': '-1'}>
                  {/* The set is laid down twice so the drift can wrap at the
                      halfway mark and read as one endless rail. The second
                      pass is decorative: same pictures, hidden from readers. */}
                  {row.map((m) => (
                    <CaseFigure {...m} eager={false} />
                  ))}
                  {row.map((m) => (
                    <div class="case-scroller__clone" aria-hidden="true">
                      <CaseFigure {...m} eager={false} zoom={false} />
                    </div>
                  ))}
                </div>
              ))}
            </div>
          ) : (
            <div
              class:list={['case-media', `case-media--${layout}`, gap === 'none' && 'case-media--flush']}
              style={gap !== 'default' && gap !== 'none' ? `gap: ${gap}` : undefined}
            >
              {media.map((m) => (
                <CaseFigure {...m} eager={first} />
              ))}
            </div>
          )
        )}

        <div class="case-shell">
        {(embed || localEmbed) && (
          <div class:list={['case-embed', localEmbed?.bleed && 'case-embed--bleed']}>
            <iframe
              src={(embed || localEmbed)!.src}
              title={(embed || localEmbed)!.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        )}

        {audio.length > 0 && <CaseAudio tracks={audio} />}
        </div>
      </>
    )
  }
</section>
