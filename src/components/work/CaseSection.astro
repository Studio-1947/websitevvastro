---
/**
 * One case-study block: optional heading + brand pill + prose + media grid.
 * Supports split layout (text left, media right).
 */
import CaseFigure from './CaseFigure.astro';
import CaseAudio from './CaseAudio.astro';

interface AudioTrack {
  title: string;
  artist?: string;
  origin?: string;
  genre?: string;
  duration?: string;
  src: string;
}

interface Media {
  src: string;
  alt: string;
  caption?: string;
  zoom?: boolean;
  pad?: boolean;
  ratio?: string;
}
interface Card {
  num?: string;
  title: string;
  body?: string;
}
interface Swatch {
  hex: string;
  name: string;
  role?: string;
  note?: string;
}
interface Props {
  heading?: string;
  subheading?: string;
  label?: string;
  body?: string[];
  list?: string[];
  swatches?: Swatch[];
  cards?: Card[];
  media?: Media[];
  embed?: { src: string; title: string };
  /** Playable field recordings (Sundargaan) — rendered as a track-list player. */
  audio?: AudioTrack[];
  layout?: 'stack' | 'split' | 'grid-2' | 'grid-3';
  divider?: boolean;
  /** First section after the hero — its media loads eagerly. */
  first?: boolean;
}

function swatchInk(hex: string): string {
  const v = (i: number) => {
    const c = parseInt(hex.slice(1 + i * 2, 3 + i * 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  };
  const L = 0.2126 * v(0) + 0.7152 * v(1) + 0.0722 * v(2);
  return L > 0.223 ? '#10240f' : '#ffffff';
}

const {
  heading,
  subheading,
  label,
  body = [],
  list = [],
  swatches = [],
  cards = [],
  media = [],
  embed,
  audio = [],
  layout = 'stack',
  divider = true,
  first = false,
} = Astro.props;

const SubheadingTag = subheading ? (heading ? 'h3' : 'h2') : null;
const CardTitleTag = subheading ? (heading ? 'h4' : 'h3') : heading ? 'h3' : 'h2';
const isSplit = layout === 'split';
---

<section class:list={['case-section', divider && 'case-section--divided', first && 'case-section--first', isSplit && 'case-section--split']}>
  {
    isSplit ? (
      <div class="case-split">
        <div class="case-split__content">
          {label && <span class="case-label">{label}</span>}
          {heading && <h2 class="case-section__heading">{heading}</h2>}
          {SubheadingTag && <SubheadingTag class="case-section__subheading">{subheading}</SubheadingTag>}

          {body.length > 0 && (
            <div class="case-prose">
              {body.map((p) => (
                <p set:html={p} />
              ))}
            </div>
          )}

          {list.length > 0 && (
            <ul class="case-list">
              {list.map((item) => (
                <li set:html={item} />
              ))}
            </ul>
          )}
        </div>

        {media.length > 0 && (
          <div class="case-split__media">
            {media.map((m) => (
              <CaseFigure {...m} eager={first} />
            ))}
          </div>
        )}
      </div>
    ) : (
      <>
        {heading && <h2 class="case-section__heading">{heading}</h2>}
        {SubheadingTag && <SubheadingTag class="case-section__subheading">{subheading}</SubheadingTag>}
        {label && <span class="case-label">{label}</span>}

        {body.length > 0 && (
          <div class="case-prose">
            {body.map((p) => (
              <p set:html={p} />
            ))}
          </div>
        )}

        {list.length > 0 && (
          <ul class="case-list">
            {list.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        )}

        {swatches.length > 0 && (
          <div class="case-swatches">
            {swatches.map((s) => (
              <div class="case-swatch" style={`--sw: ${s.hex}; --sw-ink: ${swatchInk(s.hex)}`}>
                {s.note && <p class="case-swatch__note">{s.note}</p>}
                <div class="case-swatch__foot">
                  <div class="case-swatch__row">
                    {s.role && <span class="case-swatch__role">{s.role}</span>}
                    <span class="case-swatch__hex">{s.hex.toUpperCase()}</span>
                  </div>
                  <span class="case-swatch__name">{s.name}</span>
                </div>
              </div>
            ))}
          </div>
        )}

        {cards.length > 0 && (
          <div class:list={['case-cards', `case-cards--${layout === 'stack' ? 'grid-3' : layout}`]}>
            {cards.map((c) => (
              <div class="case-card">
                {c.num && <div class="case-card__num">{c.num}</div>}
                <CardTitleTag class="case-card__title">{c.title}</CardTitleTag>
                {c.body && <p class="case-card__body" set:html={c.body} />}
              </div>
            ))}
          </div>
        )}

        {media.length > 0 && (
          <div class:list={['case-media', `case-media--${layout}`]}>
            {media.map((m) => (
              <CaseFigure {...m} eager={first} />
            ))}
          </div>
        )}

        {embed && (
          <div class="case-embed">
            <iframe
              src={embed.src}
              title={embed.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        )}

        {audio.length > 0 && <CaseAudio tracks={audio} />}
      </>
    )
  }
</section>
