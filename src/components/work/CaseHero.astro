---
/**
 * Case hero: the cover image, then a heading block below it.
 *
 *  photo: full-bleed image (or film). Nothing is overlaid, so it carries no
 *          scrim unless the case sets a brand `scrim` tint.
 *  logo: brand lockup contained on a tinted panel. Some brands supply a logo
 *          rather than a photograph.
 *
 * The cover is one fixed height for every case. The title sits inside it,
 * bottom-left, in a frosted pane painted with the case's contrast-checked
 * brand colours. Tags, place · date and the live-project button follow on
 * the page underneath.
 *
 * Per the theme decision the title renders in Syne 400 (not the source's
 * font-black Bricolage) and lets size carry the emphasis.
 */
interface Props {
  src: string;
  alt: string;
  title: string;
  tags?: string[];
  style?: 'photo' | 'logo';
  /**
   * Optional overlay colour for 'photo' heroes: the case brand's own hero
   * treatment. Applied as a flat 80% tint over the whole image (matches the
   * source sites' `bg-<brand>/80`), replacing the default black gradient.
   */
  scrim?: string;
  /** Strength of that tint, 0 to 1. Defaults to the source sites' 80%. */
  scrimOpacity?: number;
  /**
   * Logo-hero surface: 'brand' (default) renders the lockup on the brand-fill
   * panel; 'light' renders it on a clean light panel for lockups that read
   * muddy against their own fill. Ignored for 'photo' style.
   */
  background?: 'brand' | 'light';
  /** Legacy case studies carry these; the React-sourced ones do not. */
  location?: string;
  year?: string;
  /** Still frame shown while a video hero loads (and if it cannot play). */
  poster?: string;
  /** The shipped product's public URL; renders the "View Live Project" button. */
  liveUrl?: string;
}
const { src, alt, title, tags = [], style = 'photo', scrim, scrimOpacity, background, location, year, poster, liveUrl } = Astro.props;
// A hero can be a film rather than a photograph. It plays muted, loops and
// carries no controls, so it behaves like a moving still: the poster paints
// first, and a browser that blocks autoplay simply keeps showing it.
const isVideo = /\.(mp4|webm)$/.test(src);
const isLogo = style === 'logo';
const isLight = isLogo && background === 'light';
const meta = [location, year].filter(Boolean) as string[];
// The tint is an 8 digit hex: 'cc' is the 80% the source sites apply, and
// `scrimOpacity` overrides that per case.
const alphaHex = Math.round(Math.min(Math.max(scrimOpacity ?? 0.8, 0), 1) * 255)
  .toString(16)
  .padStart(2, '0');
const scrimStyle = scrim ? { '--case-scrim': `${scrim}${alphaHex}` }: undefined;
---

<div class:list={['case-hero', isLogo && 'case-hero--logo', isLight && 'case-hero--light']} style={scrimStyle}>
  {
    isVideo ? (
      <video
        class="case-hero__img case-hero__video"
        src={src}
        poster={poster}
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        aria-label={alt}
      />
    ): (
      <img class="case-hero__img" src={src} alt={alt} loading="eager" decoding="async" fetchpriority="high" />
    )
  }
  {!isLogo && scrim && <div class="case-hero__scrim"></div>}
  <h1 class="case-hero__title"><span class="case-heading__box" set:html={title} /></h1>
</div>

<div class="case-heading">
  {
    (tags.length > 0 || meta.length > 0) && (
      <div class="case-heading__row">
        {tags.length > 0 && (
          <div class="case-heading__tags">
            {tags.map((t) => (
              <span class="case-tag">{t}</span>
            ))}
          </div>
        )}
        {meta.length > 0 && (
          <p class="case-heading__meta">
            {meta.map((m, i) => (
              <>
                {i > 0 && <span class="case-heading__dot" aria-hidden="true">·</span>}
                <span>{m}</span>
              </>
            ))}
          </p>
        )}
      </div>
    )
  }
  {
    liveUrl && (
      <div class="case-heading__cta">
        <a class="case-live" href={liveUrl} target="_blank" rel="noopener noreferrer">
          View Live Project
          <span class="case-live__arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </span>
        </a>
      </div>
    )
  }
</div>
