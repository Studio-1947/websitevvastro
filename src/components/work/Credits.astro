---
import { teamMemberHref, teamMemberKeyForCreditName } from '../../lib/team';
import FooterStrip from './FooterStrip.astro';

/**
 * The colophon that closes every case study: who the work was for, who ran it
 * on their side, who worked on it here and in what role, when and where it
 * happened, and how many people have read the page.
 *
 * Names that belong to current team members link to their profile on
 * /about-us/ (which opens their person modal). External collaborators stay
 * plain text: they have no profile here.
 */
interface Props {
  client: string;
  /** The client's own point of contact on the project. */
  coordinator?: { name: string; role?: string };
  roles?: { role: string; members: string }[];
  /** Credits belonging to the client's side, listed under the client name. */
  clientRoles?: { role: string; members: string }[];
  /** Whether the role list is a two-up grid (default) or one column. */
  layout?: 'grid' | 'stack';
  /** Profile-link treatment: underline by default, arrow button when opted in. */
  linkStyle?: 'underline' | 'arrow';
  location?: string;
  year?: string;
  /** This case's slug, used to read and increment its own view tally. */
  slug?: string;
}
const { client, coordinator, roles = [], clientRoles = [], layout = 'grid', linkStyle = 'underline', location, year, slug } = Astro.props;

const when = [location, year].filter(Boolean).join(', ');

/** Split a credit line into names, each with the profile link it deserves. */
function creditNames(list: string) {
  return list
    .split(',')
    .map((raw) => raw.trim())
    .filter(Boolean)
    .map((name, i, arr) => ({
      name,
      href: teamMemberKeyForCreditName(name)
        ? teamMemberHref(teamMemberKeyForCreditName(name)!)
        : null,
      // Separator sits outside the link: it is punctuation between names, not
      // part of the linked name.
      sep: i < arr.length - 1 ? ', ' : '',
    }));
}
---

<section class="case-colophon">
  <h2 class="case-colophon__title">Project credits</h2>

  <div class="case-colophon__grid">
    <div class="case-colophon__block">
      <h3 class="case-colophon__kicker">Client</h3>
      <p class="case-colophon__client">{client}</p>
      {
        coordinator && (
          <p class="case-colophon__coordinator">
            <span class="case-colophon__label">Coordinated by</span>
            {coordinator.name}
            {coordinator.role && <span class="case-colophon__role">{coordinator.role}</span>}
          </p>
        )
      }
      {
        clientRoles.length > 0 && (
          <ul class="case-colophon__team case-colophon__team--stack">
            {clientRoles.map((r) => (
              <li class="case-colophon__credit">
                <span class="case-colophon__creditRole">{r.role}</span>
                <span class="case-colophon__creditNames">{r.members}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      roles.length > 0 && (
        <div class="case-colophon__block case-colophon__block--team">
          <h3 class="case-colophon__kicker">Studio 1947</h3>
          <ul class:list={['case-colophon__team', layout === 'stack' && 'case-colophon__team--stack']}>
            {roles.map((r) => (
              <li class="case-colophon__credit">
                <span class="case-colophon__creditRole">{r.role}</span>
                <span class="case-colophon__creditNames">
                  {creditNames(r.members).map((n) => (
                    <>
                      {n.href ? (
                        <a class:list={['case-colophon__creditLink', linkStyle === 'arrow' && 'case-colophon__creditLink--arrow']} href={n.href}>
                          <span>{n.name}</span>
                          {linkStyle === 'arrow' && (
                            <span class="case-colophon__creditArrow" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19 19 5M9 5h10v10" /></svg>
                            </span>
                          )}
                        </a>
                      ) : n.name}
                      {n.sep}
                    </>
                  ))}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      when && (
        <div class="case-colophon__block">
          <h3 class="case-colophon__kicker">Time and place</h3>
          <p class="case-colophon__when">{when}</p>
        </div>
      )
    }
  </div>

  {/* Filled in by scripts/views.ts from this project's own counter; hidden
      until a real number comes back. */}
  {
    slug && (
      <p class="case-colophon__views" data-views={slug} hidden>
        Viewed <span data-views-num>0</span> times
      </p>
    )
  }

  <FooterStrip />
</section>
