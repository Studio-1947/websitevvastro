---
import { teamMemberHref, teamMemberKeyForCreditName } from '../../lib/team';

/**
 * Project credits. The source linked each name to /team/<slug>; this site has
 * no /team routes, so credited names that are current team members link to the
 * member's profile on /about-us/ (which opens their person modal). External
 * collaborators (Tanisha, Mohanty, Zahid, …) stay plain text — they have no
 * profile here. Role kickers take the per-brand accent via --brand.
 */
interface Props {
  client: string;
  roles?: { role: string; members: string }[];
}
const { client, roles = [] } = Astro.props;
---

{
  roles.length > 0 && (
    <section class="case-credits">
      <div>
        <h3 class="case-credits__kicker">Client</h3>
        <p class="case-credits__client">{client}</p>
      </div>
      <div class="case-credits__grid">
        {roles.map((r) => (
          <div>
            <h4 class="case-credit__role">{r.role}</h4>
            <p class="case-credit__members">
              {r.members.split(',').map((raw, i, arr) => {
                const name = raw.trim();
                if (!name) return null;
                // Separator sits outside the link — it is punctuation between
                // names, not part of the linked name.
                const sep = i < arr.length - 1 ? ', ' : '';
                const key = teamMemberKeyForCreditName(name);
                const node = key ? <a href={teamMemberHref(key)}>{name}</a> : name;
                return [node, sep];
              })}
            </p>
          </div>
        ))}
      </div>
    </section>
  )
}
