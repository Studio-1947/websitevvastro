---
/**
 * Closing CTA for case studies, with the half-wheel mark bleeding off the right
 * edge (source: PortfolioCTA.tsx). The mark is decorative and hidden from
 * assistive tech; it drops out below 768px where it would crowd the copy.
 *
 * The source dispatched a custom "open-talk-modal" event; this site's modal
 * binds `[data-contact-open]`, with href="/sayhello/" as the no-JS fallback.
 */
interface Props {
  title?: string;
  label?: string;
}
const {
  title = 'Building a future-proof brand system or launching a complex digital product?',
  label = "Let's build a sustainable system",
} = Astro.props;
---

<section class="case-cta">
  <img class="case-cta__mark" src="/assets/img/work/cta-half-wheel.svg" alt="" aria-hidden="true" />
  <div class="case-cta__body">
    <h2 class="case-cta__title">{title}</h2>
    <a class="case-cta__btn" href="/sayhello/" data-contact-open>
      {label}
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </div>
</section>
