---
/**
 * A single case-study image or video figure.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { imageSize } from '../../lib/imageSize';
interface Props {
  src: string;
  alt: string;
  caption?: string;
  zoom?: boolean;
  pad?: boolean;
  /** Fixed aspect ratio ("4/3"); crops with object-fit: cover. */
  ratio?: string;
  /** Cap the rendered width (px), centred in the slot. Opt-in per image. */
  maxWidth?: number;
  /** Full-resolution source the lightbox zooms to (display file is a variant). */
  full?: string;
  /** Hero-adjacent images should load eagerly; everything else defers. */
  eager?: boolean;
  loop?: boolean;
  autoplay?: boolean;
  /** Line art drawn on white: multiply it into the page so no white shows. */
  blend?: boolean;
}
const { src, alt, caption, zoom = true, pad = false, ratio, maxWidth, full, eager = false, loop = false, autoplay = false, blend = false } = Astro.props;
const isVideo = src.endsWith('.mp4') || src.endsWith('.webm');
const isGif = src.endsWith('.gif');
const isLoopingVideo = isVideo && (loop || autoplay || src.includes('responsive'));
const isReel = (isVideo && !isLoopingVideo) || ratio === '9/16' || ratio === '3/4' || ratio === '9/20' || ratio === '1/1';
const cls = [
  'case-figure',
  pad && 'case-figure--pad',
  !isReel && ratio && 'case-figure--ratio',
  !isVideo && zoom && !isGif && 'case-figure--zoom',
  isReel && 'case-figure--reel',
  blend && 'case-figure--blend',
]
  .filter(Boolean)
  .join(' ');

// Animated art ships as a .gif; a hand-made .webp twin is served in its place
// when one exists. It usually does not, and pointing <source> at a file that
// isn't there breaks the whole <picture>, so the file is checked on disk.
const webpCandidate = isGif ? src.replace(/\.gif$/, '.webp'): null;
const webpSrc =
  webpCandidate && existsSync(join(process.cwd(), 'public', webpCandidate)) ? webpCandidate: null;

// Intrinsic size, so the browser reserves the right box before the file lands
// and the page does not reflow under the reader mid-scroll.
const dim = isVideo ? null: imageSize(src);
---

<figure
  class={cls}
  style={[
    !isReel && ratio ? `--ratio: ${ratio}`: null,
    maxWidth ? `max-width: ${maxWidth}px; margin-inline: auto`: null,
  ]
    .filter(Boolean)
    .join('; ') || undefined}
>
  {
    isVideo ? (
      isLoopingVideo ? (
        <video
          src={src}
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          class="case-figure__video case-figure__video--loop"
        />
      ): (
        <div class="case-reel-frame">
          <video
            src={src}
            controls
            playsinline
            preload="metadata"
            class="case-figure__video"
          >
            <track kind="captions" />
          </video>
        </div>
      )
    ): isGif ? (
      <picture>
        {webpSrc && <source srcset={webpSrc} type="image/webp" />}
        <img
          src={src}
          alt={alt}
          width={dim?.width}
          height={dim?.height}
          loading={eager ? 'eager': 'lazy'}
          decoding="async"
        />
      </picture>
    ): (
      <img
        src={src}
        alt={alt}
        data-full={full}
        width={dim?.width}
        height={dim?.height}
        loading={eager ? 'eager': 'lazy'}
        decoding="async"
      />
    )
  }
  {caption && <figcaption class="case-figure__caption">{caption}</figcaption>}
</figure>
