---
/**
 * A single case-study image or video figure.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  zoom?: boolean;
  pad?: boolean;
  /** Fixed aspect ratio ("4/3"); crops with object-fit: cover. */
  ratio?: string;
  /** Hero-adjacent images should load eagerly; everything else defers. */
  eager?: boolean;
}
const { src, alt, caption, zoom = true, pad = false, ratio, eager = false } = Astro.props;
const isVideo = src.endsWith('.mp4') || src.endsWith('.webm');
const isReel = isVideo || ratio === '9/16' || ratio === '3/4' || ratio === '9/20' || ratio === '1/1';
const cls = [
  'case-figure',
  pad && 'case-figure--pad',
  !isReel && ratio && 'case-figure--ratio',
  !isVideo && zoom && 'case-figure--zoom',
  isReel && 'case-figure--reel',
]
  .filter(Boolean)
  .join(' ');
---

<figure class={cls} style={!isReel && ratio ? `--ratio: ${ratio}` : undefined}>
  {
    isVideo ? (
      <div class="case-reel-frame">
        <video
          src={src}
          controls
          playsinline
          preload="metadata"
          class="case-figure__video"
        >
          <track kind="captions" />
        </video>
      </div>
    ) : (
      <img
        src={src}
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    )
  }
  {caption && <figcaption class="case-figure__caption">{caption}</figcaption>}
</figure>
