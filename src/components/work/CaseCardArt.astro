---
/**
 * The line illustration in the corner of a case card.
 *
 * Abstract rather than descriptive: a card carries an idea, not an object, so
 * the drawing is there to give the box weight and rhythm. Motifs cycle by
 * position, so a row of three never repeats itself, and each is drawn in the
 * case's own colour at low contrast so it stays behind the words.
 */
interface Props {
  /** Card position in its group; picks the motif. */
  index?: number;
}
const { index = 0 } = Astro.props;

const MOTIFS = [
  // woven arcs, after the nest
  'M4 84c0-44 36-80 80-80M22 84c0-34 28-62 62-62M40 84c0-24 20-44 44-44M58 84c0-13 12-25 26-25',
  // contour rings
  'M84 4a80 80 0 0 0-80 80M84 26a58 58 0 0 0-58 58M84 48a36 36 0 0 0-36 36M84 68a16 16 0 0 0-16 16',
  // rising measure
  'M4 84h80M18 84V56M36 84V36M54 84V52M72 84V20M4 6h30M4 20h14',
  // orbit
  'M44 4a40 40 0 1 1 0 80 40 40 0 0 1 0-80ZM4 44h80M44 12c14 12 14 52 0 64M44 12c-14 12-14 52 0 64',
  // grid weave
  'M4 24h80M4 48h80M4 72h80M24 4v80M48 4v80M72 4v80',
  // horizon
  'M4 60h80M4 44c14-10 26-10 40 0s26 10 40 0M14 76h60M28 28h40',
];
const d = MOTIFS[index % MOTIFS.length];
---

<svg
  class="case-card__art"
  viewBox="0 0 88 88"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>
