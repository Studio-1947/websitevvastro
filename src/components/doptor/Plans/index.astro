---
/**
 * How you can run Doptor: three cards side by side (online as a pay-as-you-go
 * service, installed at your site, or on your own server). Same card look as
 * the S47 Vyapar steps: a soft card, an icon on a flat red tint, a small
 * uppercase label, a title, a line of copy and a short checklist.
 * Phones: stacked.
 */
export interface Plan { label: string; tag?: string; title: string; body: string; points: string[]; icon: string }
export interface PlansContent { title: string; lede: string; plans: Plan[]; note?: string }

interface Props { content: PlansContent }
const { content: c } = Astro.props;
---

<section class="plans" aria-labelledby="doptor-plans-title">
  <header class="plans__head">
    <h2 id="doptor-plans-title" class="p-title">{c.title}</h2>
    <p class="p-lede">{c.lede}</p>
  </header>
  <ul class="plans__grid" data-stagger>
    {c.plans.map((p) => (
      <li class="plan">
        <div class="plan__top">
          <span class="plan__icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
          </span>
          {p.tag && <span class="plan__tag">{p.tag}</span>}
        </div>
        <p class="plan__label">{p.label}</p>
        <h3 class="plan__title">{p.title}</h3>
        <p class="plan__body">{p.body}</p>
        <ul class="plan__points">
          {p.points.map((t) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
  {c.note && <p class="plans__note">{c.note}</p>}
</section>

<style>
  .plans { max-width: 1280px; margin: 0 auto; padding: clamp(56px, 7vw, 110px) clamp(16px, 5vw, 72px); }
  .plans__head { max-width: 820px; margin: 0 auto clamp(36px, 4.4vw, 56px); text-align: center; }
  .plans__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }

  .plan { display: flex; flex-direction: column; padding: 22px 22px 26px; border-radius: 16px; background: var(--p-card); }
  .plan__top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 22px; }
  .plan__icon {
    display: grid; place-items: center; width: 64px; height: 64px; border-radius: 14px;
    /* A flat tint of Studio 1947 red, as on the S47 Vyapar toolkit. */
    background: #FFDCD6; color: var(--p-ink);
  }
  .plan__tag { padding: 5px 11px; border-radius: 999px; background: var(--p-ink); color: #fff; font-size: 12.5px; font-weight: 500; white-space: nowrap; }
  .plan__label { margin: 0 0 8px; font-size: 14px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--p-muted); }
  .plan__title { margin: 0 0 10px; font-size: clamp(22px, 1.9vw, 26px); line-height: 1.2; }
  .plan__body { margin: 0 0 18px; font-size: 15.5px; line-height: 1.55; color: var(--p-muted); }
  .plan__points { list-style: none; margin: auto 0 0; padding: 16px 0 0; border-top: 1px solid var(--p-line); display: grid; gap: 9px; }
  .plan__points li { display: flex; gap: 9px; align-items: flex-start; font-size: 15px; line-height: 1.45; }
  .plan__points svg { flex: none; margin-top: 2px; color: var(--p-green); }
  .plans__note { max-width: 720px; margin: clamp(28px, 3vw, 40px) auto 0; text-align: center; font-size: clamp(16px, 1.2vw, 18px); line-height: 1.5; }

  @media (max-width: 900px) {
    .plans__grid { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
  }
</style>
