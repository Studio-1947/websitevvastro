---
/**
 * Doptor NGO Manager demo, embedded in /products/doptor-erp/. A clickable
 * preview with sample data (./data.ts): Overview, Projects, Geography, SDGs
 * and Reports & Evidence. The Overview follows the impact-dashboard design
 * (SDG wheel, field feed, impact story, donor spotlight, theory of change).
 * Laid out on a fixed 1440 × 960 stage that the script scales to its box, so
 * it reads the same at every width. Charts are drawn here at build time; the
 * script only switches screens, zooms the map and applies filters. While on
 * screen and untouched, a pointer plays a guided demo round the screens
 * (src/scripts/demoTour.ts); the first click or key press stops it.
 *
 * It shows the product's own English interface, so it is left out of page
 * translation (`data-i18n-skip`); the heading above it is translated.
 */
import IndiaMap from '../../isd/Map/IndiaMap.astro';
import { INDIA, INDIA_PATH, project } from '../../isd/Map/india';
import { STATES as SHAPES } from '../../isd/Map/states';
import {
  ORG, KPIS, STATES, PROJECTS, FEED, CLUSTERS, BUCKETS, STORY, DONOR, ALERTS, QUICK,
  MONTHS, GROWTH, FUNDS, SECTORS, SDGS, REPORTS, CHANGE,
  COMMUNITY_TILES, VILLAGES, REACH, VOICES, INSIGHTS, RADAR, FIN_TILES, GRANTS, DISBURSED,
  PART_TILES, SURVEYS, FEEDBACK, MEETINGS, ALERT_LIST, PROFILE, ROLES, NOTIFY, LANGUAGES,
} from './data';

const IMG = '/assets/img/products/doptor-ngo';

const ICON: Record<string, string> = {
  home: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
  people: '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 19c0-3 3-5 6.5-5s6.5 2 6.5 5"/><circle cx="17" cy="8.5" r="2.4"/><path d="M15.7 13.8c2.7.4 4.8 2.1 4.8 4.7"/>',
  person: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>',
  venus: '<circle cx="12" cy="9" r="5"/><path d="M12 14v7M9 18h6"/>',
  folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/>',
  rupee: '<path d="M6 4h12M6 9h12M6 14l8.5 7M6 14h3a5 5 0 0 0 0-10"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/>',
  sdg: '<circle cx="12" cy="12" r="8.5" stroke-dasharray="3.2 1.8" stroke-width="3.4"/>',
  leaf: '<path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19 13 11"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  doc: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  alert: '<path d="M12 3 2 20h20Z"/><path d="M12 10v4M12 17h.01"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5h.01"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
  bell: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  trend: '<path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5Z"/><path d="m3 13 9 5 9-5"/>',
  chart: '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/>',
  shield: '<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6Z"/><path d="m9 12 2 2 4-4"/>',
  hands: '<circle cx="8" cy="7" r="3"/><path d="M2 20c0-3.5 2.7-6 6-6 1.5 0 2.8.5 3.8 1.3"/><path d="m14 18 2.5 2.5L22 15"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  filePlus: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6M12 12v6M9 15h6"/>',
  upload: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6M12 18v-6M9.5 14.5 12 12l2.5 2.5"/>',
  userPlus: '<circle cx="10" cy="8" r="4"/><path d="M3 21c0-4 3.1-7 7-7 1.6 0 3 .4 4.2 1.2"/><path d="M19 14v6M16 17h6"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9.5h8M8 12.5h5"/>',
  hut: '<path d="m3 11 9-7 9 7"/><path d="M6 9.5V20h12V9.5"/><path d="M10 20v-5h4v5"/>',
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5Z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/>',
  drop: '<path d="M12 3s7 7.5 7 12a7 7 0 0 1-14 0c0-4.5 7-12 7-12Z"/>',
  heart: '<path d="M12 20s-8-4.8-8-10.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5C20 15.2 12 20 12 20Z"/>',
  sprout: '<path d="M12 21v-9"/><path d="M12 12C12 7 8.5 5 4 5c0 4.5 3 7 8 7Z"/><path d="M12 14c0-4 3-6 8-6 0 4-3 6-8 6Z"/>',
  dots: '<circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/>',
  play: '<circle cx="12" cy="12" r="10"/><path d="m10 8 6 4-6 4Z" fill="currentColor"/>',
  bulb: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3Z"/>',
  arrowDown: '<path d="M7 7l10 10M17 9v8H9"/>',
  arrowUp: '<path d="M7 17 17 7M9 7h8v8"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13"/><path d="M12 8S10.5 3 8 4.5 9 8 12 8Zm0 0s1.5-5 4-3.5S15 8 12 8Z"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>',
  palette: '<path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.6-.9 1.2-1.8-.5-1.1.3-2.2 1.5-2.2H17a4 4 0 0 0 4-4c0-5.5-4-10-9-10Z"/><circle cx="7.5" cy="11" r="1.2"/><circle cx="10" cy="7" r="1.2"/><circle cx="15" cy="7.5" r="1.2"/>',
  chevR: '<path d="m9 6 6 6-6 6"/>',
};
const icon = (name: string, size = 16) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[name]}</svg>`;

const NAV: { go: string; label: string; icon: string; badge?: number }[] = [
  { go: 'overview', label: 'Overview', icon: 'home' },
  { go: 'projects', label: 'Projects', icon: 'folder' },
  { go: 'geography', label: 'Geography', icon: 'globe' },
  { go: 'communities', label: 'Communities', icon: 'people' },
  { go: 'sdgs', label: 'SDGs', icon: 'target' },
  { go: 'analytics', label: 'Impact Analytics', icon: 'chart' },
  { go: 'reports', label: 'Reports & Evidence', icon: 'doc' },
  { go: 'finance', label: 'Financial Transparency', icon: 'shield' },
  { go: 'participation', label: 'Participation', icon: 'hands' },
  { go: 'alerts', label: 'Alerts & Insights', icon: 'bell', badge: 4 },
  { go: 'settings', label: 'Settings', icon: 'gear' },
];

const inr = (n: number) => n.toLocaleString('en-IN');

/* ---------- Donut arcs ---------- */
function arc(cx: number, cy: number, r0: number, r1: number, a0: number, a1: number): string {
  const p = (r: number, a: number) => [cx + r * Math.sin(a), cy - r * Math.cos(a)].map((v) => v.toFixed(2)).join(' ');
  const large = a1 - a0 > Math.PI ? 1 : 0;
  return `M${p(r1, a0)} A${r1} ${r1} 0 ${large} 1 ${p(r1, a1)} L${p(r0, a1)} A${r0} ${r0} 0 ${large} 0 ${p(r0, a0)} Z`;
}
const TAU = Math.PI * 2;
const sdgArcs = SDGS.map((s, i) => {
  const a0 = (i / 17) * TAU + 0.03, a1 = ((i + 1) / 17) * TAU - 0.03;
  const mid = (a0 + a1) / 2, r = 87;
  return {
    d: arc(120, 120, 64, 110, a0, a1), color: s.color, on: s.progress > 0, n: s.n, name: s.name,
    x: (120 + r * Math.sin(mid)).toFixed(1), y: (120 - r * Math.cos(mid) + 6).toFixed(1),
  };
});
const addressed = SDGS.filter((s) => s.progress > 0);
const sdgOverall = 55; // shown as the headline, matching the KPI story

const fundTotal = FUNDS.reduce((n, f) => n + f.cr, 0);
let acc = 0;
const fundArcs = FUNDS.map((f) => {
  const a0 = (acc / fundTotal) * TAU;
  acc += f.cr;
  const a1 = (acc / fundTotal) * TAU;
  return { d: arc(70, 70, 50, 68, a0 + 0.012, a1 - 0.012), color: f.color };
});

/* ---------- Line chart ---------- */
const LW = 300, LH = 132, PAD = { l: 32, r: 6, t: 6, b: 18 };
const maxY = 500;
const lx = (i: number) => PAD.l + (i / (MONTHS.length - 1)) * (LW - PAD.l - PAD.r);
const ly = (v: number) => PAD.t + (1 - v / maxY) * (LH - PAD.t - PAD.b);
const line = (vals: number[]) => vals.map((v, i) => `${i ? 'L' : 'M'}${lx(i).toFixed(1)} ${ly(v).toFixed(1)}`).join(' ');
const SERIES = [
  { vals: GROWTH.beneficiaries, color: '#1E8A55', label: 'Beneficiaries' },
  { vals: GROWTH.women, color: '#8B6AD6', label: 'Women reached' },
  { vals: GROWTH.youth, color: '#F2B632', label: 'Youth trained' },
];

/* ---------- Overview map: district clusters on a zoomable crop ---------- */
const bucket = (n: number) => BUCKETS.find((b) => n >= b.min)!;
const clusters = CLUSTERS.map((c) => {
  const [x, y] = project(c.lon, c.lat);
  const b = bucket(c.n);
  return { ...c, x: x.toFixed(1), y: y.toFixed(1), r: 9 + Math.sqrt(c.n) * 1.6, color: b.color };
});
// Three zoom levels, from the whole country in to the programme states.
const [cx0, cy0] = project(69.5, 29.5);
const [cx1, cy1] = project(89, 17.5);
const views = [
  `0 0 ${INDIA.w} ${INDIA.h}`,
  `${(cx0 - 20).toFixed(0)} ${(cy0 - 40).toFixed(0)} ${(cx1 - cx0 + 40).toFixed(0)} ${(cy1 - cy0 + 70).toFixed(0)}`,
  `${(cx0 + 40).toFixed(0)} ${(cy0 + 10).toFixed(0)} ${((cx1 - cx0) * 0.72).toFixed(0)} ${((cy1 - cy0) * 0.8).toFixed(0)}`,
];

/* ---------- Geography map pins ---------- */
const mostProjects = Math.max(...STATES.map((s) => s.projects));
const pins = STATES.map((s) => ({ label: `${s.abbr} ${s.projects}`, lon: s.lon, lat: s.lat, share: s.projects / mostProjects }));

/* ---------- Projects ---------- */
const sum = (k: 'beneficiaries' | 'budget' | 'spent') => PROJECTS.reduce((n, p) => n + p[k], 0);
const ring = (pct: number) => {
  const c = 2 * Math.PI * 15;
  return `<svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="15" fill="none" stroke="#E7EBE8" stroke-width="4"/><circle cx="20" cy="20" r="15" fill="none" stroke="#1E8A55" stroke-width="4" stroke-linecap="round" stroke-dasharray="${((pct / 100) * c).toFixed(1)} ${c.toFixed(1)}" transform="rotate(-90 20 20)"/></svg>`;
};
const maxVillages = Math.max(...STATES.map((s) => s.villages));
const reportCount = (s: string) => REPORTS.filter((r) => r.status === s).length;

/* ---------- Impact analytics ---------- */
const GW = 560, GH = 230, GP = { l: 40, r: 10, t: 10, b: 22 };
const gx = (i: number) => GP.l + (i / (MONTHS.length - 1)) * (GW - GP.l - GP.r);
const gy = (v: number) => GP.t + (1 - v / 500) * (GH - GP.t - GP.b);
const gLine = GROWTH.beneficiaries.map((v, i) => `${i ? 'L' : 'M'}${gx(i).toFixed(1)} ${gy(v).toFixed(1)}`).join(' ');
const gArea = `${gLine} L${gx(MONTHS.length - 1).toFixed(1)} ${gy(0)} L${gx(0).toFixed(1)} ${gy(0)} Z`;
const RC = { x: 170, y: 122, r: 92 };
const radarPt = (i: number, v: number) => {
  const a = (i / RADAR.axes.length) * TAU;
  return [RC.x + RC.r * (v / 100) * Math.sin(a), RC.y - RC.r * (v / 100) * Math.cos(a)];
};
const poly = (vals: number[]) => vals.map((v, i) => radarPt(i, v).map((n) => n.toFixed(1)).join(',')).join(' ');
const radarAxes = RADAR.axes.map((name, i) => {
  const [x, y] = radarPt(i, 100);
  const [tx, ty] = radarPt(i, 116);
  return { name, x: x.toFixed(1), y: y.toFixed(1), tx: tx.toFixed(1), ty: (ty + 4).toFixed(1), anchor: Math.abs(tx - RC.x) < 4 ? 'middle' : tx > RC.x ? 'start' : 'end' };
});
const maxReach = Math.max(...STATES.map((s) => s.beneficiaries));
const heat = (color: string, p: number) => (p ? `background: color-mix(in srgb, ${color} ${Math.round(28 + p * 0.72)}%, #fff); color: ${p > 50 ? '#fff' : 'var(--g-ink)'}` : '');

/* ---------- Finance, participation, alerts ---------- */
const maxDisb = Math.max(...DISBURSED);
const sevCount = (sev: string) => ALERT_LIST.filter((a) => a.sev === sev).length;
const SEV_ICON: Record<string, string> = { Critical: 'alert', Warning: 'clock', Info: 'info', Success: 'check' };
const chipRow = (values: string[]) => ['All', ...values];
---

<div class="ngo" data-i18n-skip data-ngo role="region" aria-label="Interactive preview of Doptor NGO Manager, with sample data. Use the sidebar to move between screens.">
  <div class="ngo__scaler" data-scaler>
    <div class="ngo__stage" data-stage>
      <div class="ngo__app">
        <!-- Sidebar -->
        <nav class="nside" aria-label="Dashboard screens">
          <div class="nside__brand">
            <span class="nside__logo" aria-hidden="true"><Fragment set:html={icon('leaf', 20)} /></span>
            <span><b>Doptor</b><small>NGO Manager</small></span>
          </div>
          <ul>
            {NAV.map((n, i) => (
              <li>
                <button type="button" class="nside__item" data-go={n.go} aria-current={i === 0 ? 'page' : undefined}>
                  <Fragment set:html={icon(n.icon, 18)} />{n.label}{n.badge && <em class="nside__badge">{n.badge}</em>}
                </button>
              </li>
            ))}
          </ul>
          <img class="nside__art" src={`${IMG}/village-art.webp`} alt="" width="414" height="928" loading="lazy" decoding="async" />
        </nav>

        <div class="ngo__main">
          <!-- Top bar -->
          <header class="ntop">
            <span class="ntop__menu" aria-hidden="true"><Fragment set:html={icon('menu', 20)} /></span>
            <div class="ntop__greet">
              <p class="ntop__hi">Welcome back, {ORG.first} <span aria-hidden="true">👋</span></p>
              <p class="ntop__sub">Here's what's happening across your impact ecosystem today.</p>
            </div>
            <div class="ntop__tools" aria-hidden="true">
              <span class="ntop__chip"><Fragment set:html={icon('pin', 15)} />All States<Fragment set:html={icon('chevron', 13)} /></span>
              <span class="ntop__chip ntop__chip--search"><Fragment set:html={icon('search', 15)} />Search anything…</span>
              <span class="ntop__bell"><Fragment set:html={icon('bell', 19)} /><i>3</i></span>
              <span class="ntop__lang"><Fragment set:html={icon('globe', 17)} />English<Fragment set:html={icon('chevron', 13)} /></span>
              <span class="ntop__user"><b>{ORG.initials}</b><span>{ORG.user}<small>{ORG.role}</small></span><Fragment set:html={icon('chevron', 13)} /></span>
            </div>
          </header>

          <div class="ngo__body">
            <!-- ===== Overview ===== -->
            <section class="nview is-on" data-view="overview" aria-label="Overview">
              <div class="kpis">
                {KPIS.map((k) => (
                  <div class="kpi">
                    {k.icon === 'sdg'
                      ? <span class="kpi__ico kpi__ico--sdg"><svg width="36" height="36" viewBox="0 0 240 240" aria-hidden="true">{sdgArcs.map((a) => <path d={a.d} fill={a.color} />)}</svg></span>
                      : <span class={`kpi__ico tone-${k.tone}`} set:html={icon(k.icon, 19)} />}
                    <div>
                      <p class="kpi__label">{k.label}</p>
                      <p class="kpi__value">{k.value}</p>
                      <p class="kpi__note">{k.note}</p>
                    </div>
                  </div>
                ))}
              </div>

              <div class="ov-row ov-row--a">
                <div class="card card--map">
                  <div class="card__head">
                    <p>Impact Map<small>Live project coverage across India</small></p>
                    <button type="button" class="iconbtn" data-go="geography" aria-label="Open Geography"><Fragment set:html={icon('layers', 16)} /></button>
                  </div>
                  <div class="omap">
                    <svg viewBox={views[1]} data-omap data-boxes={JSON.stringify(views)} data-zoom="1" role="img" aria-label="Map of India with project clusters by district">
                      <path class="omap__land" d={INDIA_PATH} />
                      {SHAPES.map((s) => <path class="omap__state" d={s.d} />)}
                      <path class="omap__edge" d={INDIA_PATH} />
                      {clusters.map((c, i) => (
                        <g class="omap__pin" style={`--d:${i * 50}ms`}>
                          <title>{c.place}: {c.n} projects</title>
                          <circle cx={c.x} cy={c.y} r={(c.r + 5).toFixed(1)} fill={c.color} opacity=".22" />
                          <circle cx={c.x} cy={c.y} r={c.r.toFixed(1)} fill={c.color} stroke="#fff" stroke-width="2" />
                          <text x={c.x} y={(+c.y + 4.5).toFixed(1)} text-anchor="middle">{c.n}</text>
                        </g>
                      ))}
                    </svg>
                    <div class="omap__legend">
                      <b>Projects</b>
                      {BUCKETS.map((b) => <span><i style={`background:${b.color}`}></i>{b.label}</span>)}
                    </div>
                    <div class="omap__zoom">
                      <button type="button" data-zoom-step="1" aria-label="Zoom in"><Fragment set:html={icon('plus', 15)} /></button>
                      <button type="button" data-zoom-step="-1" aria-label="Zoom out"><Fragment set:html={icon('minus', 15)} /></button>
                    </div>
                  </div>
                </div>

                <div class="card">
                  <div class="card__head">
                    <p>SDG Progress Overview</p>
                    <button type="button" class="btn-sm" data-go="sdgs">View all SDGs</button>
                  </div>
                  <div class="sdg-wheel">
                    <svg viewBox="0 0 240 240" aria-hidden="true">
                      {sdgArcs.map((a) => (
                        <g opacity={a.on ? 1 : 0.28}>
                          <path d={a.d} fill={a.color} />
                          <text x={a.x} y={a.y} text-anchor="middle">{a.n}</text>
                        </g>
                      ))}
                    </svg>
                    <div class="sdg-wheel__mid"><small>Overall Progress</small><b>{sdgOverall}%</b><span><Fragment set:html={icon('trend', 13)} />On Track</span></div>
                  </div>
                  <p class="sdg-wheel__note">{addressed.length} of 17 goals addressed</p>
                </div>

                <div class="card">
                  <div class="card__head">
                    <p>Real-time Activity Feed</p>
                    <button type="button" class="btn-sm" data-go="projects">View all</button>
                  </div>
                  <ul class="feed">
                    {FEED.map((f) => (
                      <li>
                        <img src={`${IMG}/${f.photo}.webp`} alt="" width="80" height="80" loading="lazy" decoding="async" />
                        <span class="feed__text"><b>{f.title}</b><small>{f.place}</small></span>
                        <span class="feed__meta"><em class={`tag tone-${f.tone}`}>{f.tag}</em><small>{f.time}</small></span>
