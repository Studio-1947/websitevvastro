                      {chipRow(['Grievance', 'Suggestion', 'Appreciation']).map((c, i) => <button type="button" data-chip={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>)}
                    </div>
                    <ul class="fb">
                      {FEEDBACK.map((f) => (
                        <li data-kind={f.kind}>
                          <em class={`pill pill--${f.kind.toLowerCase()}`}>{f.kind}</em>
                          <span><b>{f.text}</b><small>{f.place} · {f.time}</small></span>
                          <em class={`pill pill--st-${f.status.split(' ')[0].toLowerCase()}`}>{f.status}</em>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                <div class="stack">
                  <div class="card">
                    <p class="card__title">Upcoming meetings</p>
                    <ul class="meet">
                      {MEETINGS.map((m) => <li><span class="meet__date"><b>{m.day}</b><small>{m.month}</small></span><span><b>{m.title}</b><small>{m.place}</small></span></li>)}
                    </ul>
                  </div>
                  <div class="card">
                    <p class="card__title">How people take part<small>Share of responses</small></p>
                    <ul class="hbars">
                      {[['Field app, with an officer', 52, '#1E8A55'], ['SMS and voice calls', 21, '#1F7FB2'], ['Gram sabha and meetings', 18, '#B8730C'], ['WhatsApp', 9, '#6D4FC4']].map(([l, v, c]) => (
                        <li><span>{l}</span><b>{v}%</b><i><em style={`width:${v}%; background:${c}`}></em></i></li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </section>

            <!-- ===== Alerts ===== -->
            <section class="nview" data-view="alerts" aria-label="Alerts and insights" hidden>
              <div class="vhead"><div><h3>Alerts &amp; Insights <em class="badge">4 new</em></h3><p>Programme alerts, field updates and system notices</p></div><span class="btn-sm" aria-hidden="true">Mark all as read</span></div>
              <div class="tiles">
                {['Critical', 'Warning', 'Info', 'Success'].map((sv) => <div class={`tile tile--center sev sev--${sv.toLowerCase()}`}><b>{sevCount(sv)}</b><small>{sv}</small></div>)}
              </div>
              <div class="chips" role="group" aria-label="Filter alerts by category" data-chips="cat">
                {chipRow(['Field', 'Finance', 'SDG', 'Project', 'Reporting', 'Community']).map((c, i) => <button type="button" data-chip={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>)}
              </div>
              <div class="card alist">
                {ALERT_LIST.map((a, i) => (
                  <div class={`alist__row sev--${a.sev.toLowerCase()}`} data-cat={a.cat}>
                    <span class="alist__ico" set:html={icon(SEV_ICON[a.sev], 18)} />
                    <span><b>{a.title}{i < 4 && <i class="alist__new">New</i>}</b><small>{a.detail}</small></span>
                    <em class="pill">{a.cat}</em>
                    <span class="muted">{a.time}</span>
                    <span class="btn-sm" aria-hidden="true">{a.action}</span>
                  </div>
                ))}
              </div>
            </section>

            <!-- ===== Settings ===== -->
            <section class="nview" data-view="settings" aria-label="Settings" hidden>
              <div class="vhead"><div><h3>Settings</h3><p>Manage your account, roles, notifications and preferences</p></div></div>
              <div class="settings">
                <div class="card settings__menu" role="tablist" aria-label="Settings sections">
                  {[['profile', 'Profile', 'person'], ['roles', 'Roles & Access', 'shield'], ['notify', 'Notifications', 'bell'], ['language', 'Language', 'globe'], ['look', 'Appearance', 'palette']].map(([k, l, ic], i) => (
                    <button type="button" role="tab" data-pane={k} aria-selected={i === 0 ? 'true' : 'false'}><Fragment set:html={icon(ic, 16)} />{l}<Fragment set:html={icon('chevR', 14)} /></button>
                  ))}
                </div>
                <div class="card settings__panel">
                  <div data-panel="profile">
                    <p class="card__title">Profile information</p>
                    <div class="who"><b>{ORG.initials}</b><span><strong>{ORG.user}</strong><small>{PROFILE.email}</small><em class="pill pill--active">{ORG.role}</em></span></div>
                    <div class="form">
                      <label>Full name<input type="text" value={ORG.user} /></label>
                      <label>Email<input type="email" value={PROFILE.email} /></label>
                      <label>Phone<input type="tel" value={PROFILE.phone} /></label>
                      <label>Organisation<input type="text" value={PROFILE.org} /></label>
                    </div>
                    <button type="button" class="btn-save" data-save>Save changes</button>
                  </div>
                  <div data-panel="roles" hidden>
                    <p class="card__title">Roles and access<small>66 people in 5 roles</small></p>
                    <div class="rtable rtable--roles">
                      <div class="rtable__row rtable__row--head"><span>Role</span><span>People</span><span>Can see and do</span></div>
                      {ROLES.map((r) => <div class="rtable__row"><span><b>{r.role}</b></span><span>{r.people}</span><span>{r.access}</span></div>)}
                    </div>
                  </div>
                  <div data-panel="notify" hidden>
                    <p class="card__title">Notifications<small>Choose what reaches you, and how</small></p>
                    <ul class="toggles">
                      {NOTIFY.map((n) => (
                        <li><span><b>{n.label}</b><small>{n.note}</small></span><button type="button" role="switch" aria-checked={n.on ? 'true' : 'false'} aria-label={n.label}><i></i></button></li>
                      ))}
                    </ul>
                  </div>
                  <div data-panel="language" hidden>
                    <p class="card__title">Language<small>Field officers can pick their own</small></p>
                    <div class="radios">
                      {LANGUAGES.map((l, i) => <label><input type="radio" name="ngo-lang" checked={i === 0} />{l}</label>)}
                    </div>
                  </div>
                  <div data-panel="look" hidden>
                    <p class="card__title">Appearance</p>
                    <div class="radios">
                      {['Light', 'Dark', 'Match my device'].map((l, i) => <label><input type="radio" name="ngo-look" checked={i === 0} />{l}</label>)}
                    </div>
                    <ul class="toggles">
                      <li><span><b>Compact tables</b><small>Fit more rows on screen</small></span><button type="button" role="switch" aria-checked="false" aria-label="Compact tables"><i></i></button></li>
                    </ul>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { startTour } from '../../../scripts/demoTour';

  document.querySelectorAll<HTMLElement>('[data-ngo]').forEach((root) => {
    const W = 1440, H = 960;
    const scaler = root.querySelector<HTMLElement>('[data-scaler]')!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const fit = () => {
      const s = scaler.clientWidth / W;
      stage.style.setProperty('--s', String(s));
      scaler.style.height = `${H * s}px`;
    };
    new ResizeObserver(fit).observe(scaler);
    fit();

    // Screens: the sidebar, plus shortcut buttons on the overview
    const navs = root.querySelectorAll<HTMLButtonElement>('.nside [data-go]');
    const views = root.querySelectorAll<HTMLElement>('[data-view]');
    const show = (go: string) => {
      navs.forEach((n) => (n.dataset.go === go ? n.setAttribute('aria-current', 'page') : n.removeAttribute('aria-current')));
      views.forEach((v) => {
        const on = v.dataset.view === go;
        v.hidden = !on;
        v.classList.toggle('is-on', on);
      });
    };
    root.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => show(b.dataset.go || 'overview')));

    // Overview map zoom
    const omap = root.querySelector<SVGSVGElement>('[data-omap]');
    if (omap) {
      const boxes: string[] = JSON.parse(omap.dataset.boxes || '[]');
      root.querySelectorAll<HTMLButtonElement>('[data-zoom-step]').forEach((b) =>
        b.addEventListener('click', () => {
          const z = Math.min(boxes.length - 1, Math.max(0, Number(omap.dataset.zoom) + Number(b.dataset.zoomStep)));
          omap.dataset.zoom = String(z);
          omap.setAttribute('viewBox', boxes[z]);
        })
      );
    }

    // Filter chips: projects by status, reports by type
    root.querySelectorAll<HTMLElement>('[data-chips]').forEach((group) => {
      const view = group.closest<HTMLElement>('[data-view]')!;
      const key = group.dataset.chips || '';
      const chips = group.querySelectorAll<HTMLButtonElement>('[data-chip]');
      chips.forEach((c) =>
        c.addEventListener('click', () => {
          chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
          const want = c.dataset.chip;
          view.querySelectorAll<HTMLElement>(`[data-${key}]`).forEach((row) => {
            row.hidden = want !== 'All' && row.dataset[key] !== want;
          });
        })
      );
    });

    // Impact analytics: show or hide the baseline on the radar
    root.querySelectorAll<HTMLButtonElement>('[data-baseline]').forEach((b) =>
      b.addEventListener('click', () => {
        const on = b.getAttribute('aria-pressed') !== 'true';
        b.setAttribute('aria-pressed', String(on));
        root.querySelector('[data-radar]')?.classList.toggle('show-base', on);
      })
    );

    // Settings: tabs, switches and the save button
    const panes = root.querySelectorAll<HTMLButtonElement>('[data-pane]');
    panes.forEach((b) =>
      b.addEventListener('click', () => {
        panes.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.pane));
      })
    );
    root.querySelectorAll<HTMLButtonElement>('[role="switch"]').forEach((b) =>
      b.addEventListener('click', () => b.setAttribute('aria-checked', String(b.getAttribute('aria-checked') !== 'true')))
    );
    root.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((b) =>
      b.addEventListener('click', () => {
        b.textContent = 'Saved';
        b.classList.add('is-saved');
        setTimeout(() => { b.textContent = 'Save changes'; b.classList.remove('is-saved'); }, 1800);
      })
    );

    // Geography: pick a state from the list or the map
    const geo = root.querySelector<HTMLElement>('[data-view="geography"]')!;
    const stateButtons = geo.querySelectorAll<HTMLButtonElement>('[data-state]');
    const pick = (name: string) => {
      if (![...stateButtons].some((b) => b.dataset.state === name)) return;
      stateButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.state === name)));
      geo.querySelectorAll<HTMLElement>('[data-detail]').forEach((d) => (d.hidden = d.dataset.detail !== name));
      geo.querySelectorAll<HTMLElement>('[data-bar]').forEach((d) => d.classList.toggle('is-on', d.dataset.bar === name));
      geo.querySelectorAll<SVGPathElement>('.imap__state').forEach((p) => p.classList.toggle('is-active', p.dataset.state === name));
    };
    stateButtons.forEach((b) => b.addEventListener('click', () => pick(b.dataset.state || '')));
    geo.querySelectorAll<SVGPathElement>('.imap__state').forEach((p) => p.addEventListener('click', () => pick(p.dataset.state || '')));
    pick(stateButtons[0]?.dataset.state || '');

    // Guided demo: a round of the screens, ending back on the overview.
    const q = (sel: string) => root.querySelector<HTMLElement>(sel);
    const nav = (go: string) => q(`.nside [data-go="${go}"]`);
    startTour({
      root,
      stage,
      round: async ({ wait, press }) => {
        await wait(2200);
        await press(q('[data-zoom-step="1"]'));
        await wait(1600);
        await press(q('[data-zoom-step="-1"]'));
        await wait(1200);
        await press(nav('projects'));
        await wait(1600);
        await press(q('[data-chips="status"] [data-chip="Active"]'));
        await wait(1800);
        await press(q('[data-chips="status"] [data-chip="All"]'));
        await wait(900);
        await press(nav('geography'));
        await wait(1500);
        await press(q('[data-state="Bihar"]'));
        await wait(1600);
        await press(q('[data-state="Odisha"]'));
        await wait(1600);
        await press(q('[data-state="Rajasthan"]'));
        await wait(900);
        await press(nav('analytics'));
        await wait(1500);
        await press(q('[data-baseline]'));
        await wait(2000);
        await press(q('[data-baseline]'));
        await wait(900);
        await press(nav('finance'));
        await wait(1500);
        await press(q('[data-chips="uc"] [data-chip="Due"]'));
        await wait(1800);
        await press(q('[data-chips="uc"] [data-chip="All"]'));
        await wait(900);
        await press(nav('alerts'));
        await wait(1500);
        await press(q('[data-chips="cat"] [data-chip="Project"]'));
        await wait(1800);
        await press(q('[data-chips="cat"] [data-chip="All"]'));
        await wait(900);
        await press(nav('settings'));
        await wait(1200);
        await press(q('[data-pane="notify"]'));
        await wait(1600);
        await press(q('[data-pane="profile"]'));
        await wait(900);
        await press(nav('overview'));
      },
    });
  });
</script>

<style>
  .ngo {
    --g-ink: #16211B; --g-muted: #66736C; --g-line: #E6E9E4; --g-bg: #F7F7F3; --g-card: #FFFFFF; --g-warm: #FCFAF4;
    --g-side: #13291D; --g-green: #1E8A55; --g-active: #2E8B4E; --g-amber: #F2A93B;
    /* Same width as the hero's Office Manager demo: 1120px at most, centred. */
    max-width: 1120px; margin: 0 auto;
    border-radius: 14px; overflow: hidden; border: 1px solid var(--g-line); background: var(--g-bg);
    box-shadow: 0 30px 70px -30px rgba(16, 41, 31, .35);
  }
  .ngo__scaler { position: relative; aspect-ratio: 1440 / 960; overflow: hidden; }
  .ngo__stage {
    position: absolute; top: 0; left: 0; width: 1440px; height: 960px;
    transform: scale(var(--s, 1)); transform-origin: 0 0;
    color: var(--g-ink); font-size: 13px; line-height: 1.35;
  }
  :where(.ngo__stage button) { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; padding: 0; }
  :where(.ngo__stage) :where(p, h3, ul, ol, dl, dd, blockquote) { margin: 0; padding: 0; }
  :where(.ngo__stage) :where(ul, ol) { list-style: none; }
  .ngo__stage button:focus-visible { outline: 2px solid var(--g-amber); outline-offset: 2px; }
  .ngo__stage img { display: block; }
  .ngo__app { height: 100%; display: grid; grid-template-columns: 206px 1fr; }

  /* Sidebar */
  .nside { position: relative; overflow: hidden; background: linear-gradient(180deg, #102419 0%, #173322 60%, #1C3A26 100%); color: #DCE7E1; padding: 22px 12px; display: flex; flex-direction: column; gap: 22px; }
  .nside__brand { position: relative; z-index: 1; display: flex; align-items: center; gap: 10px; padding: 0 8px; }
  .nside__logo { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: rgba(255, 255, 255, .1); color: #fff; }
  .nside__brand b { display: block; color: #fff; font-family: Georgia, 'Times New Roman', serif; font-weight: 400; font-size: 23px; line-height: 1; }
  .nside__brand small { display: block; margin-top: 4px; font-size: 9.5px; letter-spacing: .32em; text-transform: uppercase; color: #C9D8D0; }
  .nside ul { position: relative; z-index: 1; display: grid; gap: 2px; }
  .nside__item { width: 100%; display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 10px; color: #D5E1DA; font-size: 13.5px; text-align: left; }
  .nside__badge { margin-left: auto; min-width: 20px; padding: 1px 6px; border-radius: 999px; background: #E5484D; color: #fff; font-size: 10.5px; font-style: normal; font-weight: 700; text-align: center; }
  button.nside__item:not([aria-current]):hover { background: rgba(255, 255, 255, .08); color: #fff; }
  .nside__item[aria-current='page'] { background: var(--g-active); color: #fff; font-weight: 600; }
  .nside__art {
    position: absolute; left: 0; bottom: 0; width: 100%; height: auto;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 26%); mask-image: linear-gradient(180deg, transparent 0%, #000 26%);
  }

  .ngo__main { display: flex; flex-direction: column; min-width: 0; overflow: hidden; }
  .ntop { display: flex; align-items: center; gap: 18px; height: 72px; flex: none; padding: 0 22px; background: #fff; border-bottom: 1px solid var(--g-line); }
  .ntop__menu { color: var(--g-ink); display: grid; }
  .ntop__greet { flex: 1; min-width: 0; }
  .ntop__hi { font-size: 20px; font-weight: 600; letter-spacing: -.01em; }
  .ntop__sub { font-size: 12.5px; color: var(--g-muted); margin-top: 2px !important; }
  .ntop__tools { display: flex; align-items: center; gap: 12px; }
  .ntop__chip { display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 12px; border-radius: 8px; background: #fff; border: 1px solid var(--g-line); font-size: 12.5px; color: var(--g-ink); }
  .ntop__chip--search { width: 172px; color: var(--g-muted); }
  .ntop__bell { position: relative; display: grid; place-items: center; width: 36px; height: 36px; }
  .ntop__bell i { position: absolute; top: 3px; right: 3px; display: grid; place-items: center; min-width: 15px; height: 15px; border-radius: 999px; background: #E5484D; color: #fff; font-size: 9.5px; font-style: normal; font-weight: 700; }
  .ntop__lang { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; }
  .ntop__user { display: inline-flex; align-items: center; gap: 9px; font-size: 12.5px; font-weight: 600; padding-left: 12px; border-left: 1px solid var(--g-line); }
  .ntop__user b { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #2E8B4E, #1E5C3A); color: #fff; font-size: 13px; }
  .ntop__user small { display: block; font-weight: 400; color: var(--g-muted); font-size: 11px; }

  .ngo__body { flex: 1; min-height: 0; padding: 16px 18px; overflow: hidden; }
  .nview { display: flex; flex-direction: column; gap: 12px; height: 100%; min-height: 0; }
  .nview[hidden] { display: none; }
  .nview.is-on { animation: ngo-in .35s ease both; }
  @keyframes ngo-in { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { .nview.is-on { animation: none; } }

  .card { background: var(--g-card); border: 1px solid var(--g-line); border-radius: 14px; padding: 16px; min-width: 0; box-shadow: 0 1px 2px rgba(16, 41, 31, .04); }
  .card--warm { background: var(--g-warm); }
  .card__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 12px; }
  .card__head p, .card__title { font-weight: 600; font-size: 15px; letter-spacing: -.005em; }
  .card__head small, .card__title small { display: block; font-weight: 400; font-size: 11.5px; color: var(--g-muted); margin-top: 3px; }
  .card__title { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 13.5px; margin-bottom: 10px !important; }
  .card__title small { margin: 0; font-size: 11px; }
  .btn-sm { flex: none; padding: 5px 10px; border-radius: 7px; border: 1px solid var(--g-line) !important; background: #fff; font-size: 11px; color: var(--g-green) !important; font-weight: 500; }
  .btn-sm:hover { border-color: var(--g-green) !important; }
  .iconbtn { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--g-line) !important; }
  .sel { flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 5px 9px; border-radius: 7px; border: 1px solid var(--g-line); font-size: 11px; font-weight: 400; }
  .btn-line { display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #CFE3D6 !important; background: #F2F8F3 !important; color: var(--g-green) !important; font-size: 12px; font-weight: 500; }
  .btn-line:hover { border-color: var(--g-green) !important; }

  /* Tones shared by icons, tags */
  .tone-green { background: #E3F3EA; color: #1E8A55; }
  .tone-blue { background: #E1F1FA; color: #1F7FB2; }
  .tone-amber { background: #FDF0DA; color: #B8730C; }
  .tone-red { background: #FDE6E7; color: #D1373F; }
  .tone-pink { background: #FBE3EC; color: #C2255C; }
  .tone-navy { background: #E2E8F2; color: #1D3D6B; }
  .tone-leaf { background: #E6F1E2; color: #3F7E44; }
  .tone-purple { background: #EEE8FB; color: #6D4FC4; }
  .ink-red { color: #D1373F; }
  .ink-amber { color: #D98A1A; }
  .ink-blue { color: #1F7FB2; }

  /* KPIs */
  .kpis { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px; flex: none; }
  .kpi { display: flex; gap: 8px; align-items: center; background: #fff; border: 1px solid var(--g-line); border-radius: 14px; padding: 12px 9px; min-width: 0; }
  .kpi > div { min-width: 0; }
  .kpi__ico { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; }
  .kpi__ico--sdg { background: #fff; }
  .kpi__label, .kpi__note { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kpi__label { font-size: 11.5px; color: var(--g-ink); }
  .kpi__value { font-size: 20px; font-weight: 700; letter-spacing: -.02em; line-height: 1.2; margin: 3px 0 !important; white-space: nowrap; }
  .kpi__note { font-size: 10.5px; color: var(--g-green); }

  .ov-row { display: grid; gap: 12px; grid-template-columns: 1fr 1fr 1fr .86fr; flex: none; }
  .ov-row--a { height: 344px; }
  .ov-row--b { height: 206px; }
  .ov-row--c { flex: 1; min-height: 0; grid-template-columns: 2fr 1fr .86fr; }
  .ov-row > .card { display: flex; flex-direction: column; overflow: hidden; }

  /* Overview map */
  .card--map { padding-bottom: 0; }
  .omap { position: relative; flex: 1; min-height: 0; margin: 0 -16px; background: #EAF3F2; border-top: 1px solid var(--g-line); }
  .omap svg { display: block; width: 100%; height: 100%; }
  .omap__land { fill: #DCEBD6; }
  .omap__state { fill: none; stroke: rgba(30, 80, 50, .22); stroke-width: .8; vector-effect: non-scaling-stroke; }
  .omap__edge { fill: none; stroke: #9DBFA5; stroke-width: 1.2; vector-effect: non-scaling-stroke; }
  .omap__pin text { fill: #fff; font-size: 12px; font-weight: 700; }
  .omap__pin { animation: omap-in .5s cubic-bezier(.22, 1.4, .36, 1) var(--d) both; transform-box: fill-box; transform-origin: center; }
  @keyframes omap-in { from { opacity: 0; transform: scale(.4); } }
  @media (prefers-reduced-motion: reduce) { .omap__pin { animation: none; } }
  .omap svg { transition: none; }
  .omap__legend { position: absolute; left: 12px; bottom: 12px; display: grid; gap: 5px; padding: 9px 11px; border-radius: 10px; background: #fff; box-shadow: 0 2px 8px rgba(16, 41, 31, .1); font-size: 10.5px; }
  .omap__legend b { font-weight: 600; font-size: 11px; margin-bottom: 1px; }
  .omap__legend span { display: flex; align-items: center; gap: 7px; }
  .omap__legend i { width: 9px; height: 9px; border-radius: 50%; }
  .omap__zoom { position: absolute; right: 12px; bottom: 12px; display: grid; border-radius: 9px; background: #fff; box-shadow: 0 2px 8px rgba(16, 41, 31, .1); overflow: hidden; }
  .omap__zoom button { display: grid; place-items: center; width: 30px; height: 30px; }
  .omap__zoom button + button { border-top: 1px solid var(--g-line); }
  .omap__zoom button:hover { background: #F2F8F3; }

  /* SDG wheel */
  .sdg-wheel { position: relative; width: 262px; margin: 2px auto 0; }
  .sdg-wheel svg { display: block; width: 100%; }
  .sdg-wheel text { fill: #fff; font-size: 15px; font-weight: 800; }
  .sdg-wheel__mid { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; text-align: center; }
  .sdg-wheel__mid small { font-size: 11.5px; color: var(--g-ink); }
  .sdg-wheel__mid b { font-size: 40px; line-height: 1.05; letter-spacing: -.02em; }
  .sdg-wheel__mid span { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; color: var(--g-green); font-weight: 600; }
  .sdg-wheel__note { margin-top: auto !important; text-align: center; font-size: 11.5px; color: var(--g-muted); }

  /* Feed */
  .feed { display: grid; }
  .feed li { display: grid; grid-template-columns: 44px 1fr auto; gap: 11px; align-items: center; padding: 10px 0; border-bottom: 1px solid #EEF0EC; }
  .feed li:first-child { padding-top: 0; }
  .feed li:last-child { border-bottom: 0; }
  .feed img { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; }
  .feed__text { min-width: 0; }
  .feed__text b { display: block; font-size: 12.5px; font-weight: 500; line-height: 1.3; }
  .feed__text small { display: block; font-size: 11.5px; color: var(--g-muted); margin-top: 4px; }
  .feed__meta { text-align: right; align-self: start; }
  .feed__meta small { display: block; font-size: 10.5px; color: var(--g-muted); margin-top: 12px; }
  .tag { display: inline-block; font-style: normal; font-size: 9.5px; padding: 3px 7px; border-radius: 5px; white-space: nowrap; }

  /* Impact story */
  .story__media { position: relative; border-radius: 10px; overflow: hidden; height: 132px; flex: none; }
  .story__media img { width: 100%; height: 100%; object-fit: cover; }
  .story__quote { position: relative; margin-top: 10px !important; padding-left: 14px !important; font-size: 12px; line-height: 1.45; }
  .story__quote::before { content: '“'; position: absolute; left: 0; top: -4px; font-size: 22px; color: var(--g-muted); font-family: Georgia, serif; }
  .story__who { margin: 8px 0 auto !important; padding-left: 14px; }
  .story__who b { display: block; font-size: 12px; font-weight: 600; }
  .story__who small { font-size: 10.5px; color: var(--g-muted); }
  .story .btn-line { margin-top: 10px; }

  /* Line chart */
  .line { display: block; width: 100%; flex: 1; min-height: 0; }
  .line__grid { stroke: #EEF1EF; }
  .line__axis { font-size: 8.5px; fill: var(--g-muted); }
  .legend { display: flex; align-items: center; justify-content: center; gap: 5px; white-space: nowrap; font-size: 10px; color: var(--g-ink); margin: -2px 0 6px !important; }
  .legend i { flex: none; width: 7px; height: 7px; border-radius: 50%; margin-left: 8px; }
  .legend i:first-child { margin-left: 0; }

  /* Funds */
  .funds { display: grid; grid-template-columns: 100px 1fr; gap: 10px; align-items: center; flex: 1; }
  .funds__donut { position: relative; }
  .funds__donut svg { display: block; width: 100px; }
  .funds__donut div { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .funds__donut b { font-size: 14px; letter-spacing: -.01em; }
  .funds__donut small { font-size: 9.5px; color: var(--g-muted); }
  .funds__list { display: grid; gap: 8px; font-size: 10px; }
  .funds__list li { display: grid; grid-template-columns: 7px 1fr 26px 42px; gap: 5px; align-items: center; }
  .funds__list i { width: 8px; height: 8px; border-radius: 50%; }
  .funds__list span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .funds__list em { font-style: normal; text-align: right; }
  .funds__list b { font-weight: 500; text-align: right; }
  .meter__note { font-size: 11px; color: var(--g-ink); margin: 8px 0 6px !important; }
  .meter { height: 5px; border-radius: 999px; background: #EEF1EF; overflow: hidden; flex: none; }
  .meter span { display: block; height: 100%; background: var(--g-green); border-radius: inherit; }

  /* Sectors */
  .sectors { display: grid; gap: 7px; }
  .sectors li { display: grid; grid-template-columns: 16px 1fr 96px 30px; gap: 8px; align-items: center; font-size: 11.5px; white-space: nowrap; }
  .sectors__ico { display: grid; }
  .sectors i { height: 5px; border-radius: 999px; background: #EEF1EF; overflow: hidden; }
  .sectors em { display: block; height: 100%; border-radius: inherit; background: var(--g-green); }
  .sectors b { font-weight: 500; text-align: right; }

  /* Donor */
  .donor__who { display: flex; gap: 12px; align-items: center; }
  .donor__logo { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: #fff; border: 1px solid var(--g-line); color: var(--g-green); }
  .donor__who b { display: block; font-size: 13px; font-weight: 600; line-height: 1.3; }
  .donor__who small { display: block; font-size: 11px; color: var(--g-muted); margin-top: 5px; }
  .donor__amount { margin: auto 0 12px !important; }
  .donor__amount b { display: block; font-size: 22px; letter-spacing: -.01em; }
  .donor__amount small { font-size: 11.5px; color: var(--g-muted); }

  /* Alerts */
  .alerts { display: grid; gap: 8px; }
  .alerts li { display: grid; grid-template-columns: 22px 1fr; gap: 11px; align-items: start; }
  .alerts__ico { display: grid; padding-top: 1px; }
  .alerts b { display: block; font-size: 11.5px; font-weight: 500; }
  .alerts small { font-size: 11px; color: var(--g-muted); }

  /* Quick actions */
  .quick { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; flex: 1; align-content: start; }
  .quick button { display: flex; align-items: center; gap: 8px; padding: 8px 8px; border-radius: 10px; border: 1px solid var(--g-line) !important; background: #fff; font-size: 11.5px; text-align: left; line-height: 1.25; }
  .quick button:hover { border-color: #B9C9BF !important; background: #FAFCFA; }
  .quick__ico { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; }

  /* Screen heads, tiles, chips */
  .vhead { display: flex; justify-content: space-between; align-items: center; }
  .vhead h3 { font-size: 21px; }
  .vhead p { font-size: 12.5px; color: var(--g-muted); }
  .vhead__btn { padding: 9px 14px; border-radius: 8px; background: var(--g-green); color: #fff; font-size: 12px; font-weight: 600; }
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .tiles--3 { grid-template-columns: repeat(3, 1fr); }
  .tile { background: #fff; border: 1px solid var(--g-line); border-radius: 14px; padding: 14px 16px; }
  .tile small { display: block; font-size: 12px; color: var(--g-muted); }
  .tile b { font-size: 24px; }
  .chips { display: flex; gap: 6px; }
  .chips button { padding: 7px 14px; border-radius: 999px; background: #fff; border: 1px solid var(--g-line); font-size: 12px; }
  .chips button[aria-pressed='true'] { background: var(--g-active); border-color: var(--g-active); color: #fff; }
  .pill { display: inline-block; font-style: normal; font-size: 10.5px; padding: 2px 8px; border-radius: 999px; background: #EEF1EF; color: var(--g-muted); }
  .pill--active { background: #E3F3EA; color: #1E8A55; }
  .pill--monitoring { background: #FDF0DA; color: #B8730C; }
  .pill--completed, .pill--published { background: #E1F1FA; color: #1F7FB2; }
  .pill--draft { background: #EEF1EF; color: #4B5852; }
  .pill--due { background: #FDE6E7; color: #D1373F; }

  /* Projects */
  .plist { display: grid; gap: 10px; }
  .plist li { display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; background: #fff; border: 1px solid var(--g-line); border-radius: 14px; padding: 12px 16px; }
  .plist li[hidden] { display: none; }
  .plist__name { display: flex; align-items: center; gap: 7px; font-weight: 600; font-size: 14px; }
  .plist__meta { font-size: 12px; color: var(--g-muted); margin: 2px 0 7px !important; }
  .plist__spend { display: grid; grid-template-columns: 1fr 220px; gap: 10px; align-items: center; }
  .plist__spend i { height: 6px; border-radius: 999px; background: #EEF1EF; overflow: hidden; }
  .plist__spend em { display: block; height: 100%; background: var(--g-green); }
  .plist__spend small { font-size: 11px; color: var(--g-muted); text-align: right; }
  .plist__prog { display: flex; align-items: center; gap: 8px; }
  .plist__prog small { display: block; font-size: 10.5px; color: var(--g-muted); }
  .plist__prog b { font-size: 15px; }

  /* Geography */
  .geo { flex: 1; display: grid; grid-template-columns: 320px 1fr 320px; gap: 12px; min-height: 0; }
  .glist { display: grid; gap: 7px; }
  .glist button { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--g-line); text-align: left; }
  .glist button:hover { border-color: #B9C9BF; }
  .glist button[aria-pressed='true'] { border-color: var(--g-green); background: #F1F8F4; }
  .glist b { display: block; font-size: 13px; }
  .glist small { font-size: 11px; color: var(--g-muted); }
  .risk { font-style: normal; font-size: 10px; padding: 2px 8px; border-radius: 999px; }
  .risk--high { background: #FDE6E7; color: #D1373F; }
  .risk--medium { background: #FDF0DA; color: #B8730C; }
  .risk--low { background: #E3F3EA; color: #1E8A55; }
  .geo__map { display: grid; place-items: center; padding: 10px; background: #EAF3F2; }
  .geo__map :global(.imap) { width: auto; height: 100%; max-width: 100%; --map-land: #DCEBD6; --map-edge: #9DBFA5; --map-state: rgba(30, 80, 50, .22); --map-label: #13201A; }
  .geo__map :global(.imap__label) { font-size: 17px; }
  .geo__map :global(.imap__state) { cursor: pointer; }
  .geo__map :global(.imap__state.is-active) { fill: rgba(30, 138, 85, .22); stroke: #1E8A55; }
  .geo__side { display: flex; flex-direction: column; gap: 12px; }
  .gdetail[hidden] { display: none; }
  .gdetail dl { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .gdetail dt { font-size: 11px; color: var(--g-muted); }
  .gdetail dd { font-size: 17px; font-weight: 700; }
  .vbars { display: grid; gap: 9px; }
  .vbars li { display: grid; grid-template-columns: 26px 1fr 34px; gap: 8px; align-items: center; font-size: 12px; }
  .vbars i { height: 7px; border-radius: 999px; background: #EEF1EF; overflow: hidden; }
  .vbars em { display: block; height: 100%; background: #9DC9AF; }
  .vbars li.is-on em { background: var(--g-green); }
  .vbars li.is-on { font-weight: 700; }
  .vbars b { text-align: right; font-weight: 500; }

  /* SDGs */
  .sdgs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
  .sdgs li { display: grid; grid-template-columns: 34px 1fr; gap: 8px 10px; align-items: center; background: #fff; border: 1px solid var(--g-line); border-radius: 14px; padding: 13px; }
  .sdgs li.is-off { opacity: .45; }
  .sdgs__n { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 8px; color: #fff; font-weight: 700; }
  .sdgs b { font-size: 12.5px; line-height: 1.2; }
  .sdgs i { grid-column: 1 / -1; height: 6px; border-radius: 999px; background: #EEF1EF; overflow: hidden; }
  .sdgs em { display: block; height: 100%; }
  .sdgs small { grid-column: 1 / -1; font-size: 11px; color: var(--g-muted); }

  /* Reports */
  .rtable { padding: 4px 16px; }
  .rtable__row { display: grid; grid-template-columns: 1fr 100px 120px 100px; gap: 12px; align-items: center; padding: 9px 0; border-bottom: 1px solid #EEF1EF; font-size: 12.5px; }
  .rtable__row:last-child { border-bottom: 0; }
  .rtable__row[hidden] { display: none; }
  .rtable__row--head { font-size: 11px; color: var(--g-muted); }
  .rtable__row b { display: block; font-size: 13px; }
  .rtable__row small { font-size: 11px; color: var(--g-muted); }

  /* Theory of change (overview and reports) */
  .change { display: grid; grid-template-columns: repeat(5, 1fr); gap: 30px; }
  .change li { position: relative; display: grid; align-content: center; gap: 3px; padding: 8px 8px; white-space: nowrap; border-radius: 12px; border: 1px solid; text-align: center; }
  .change li:not(:last-child)::after { content: '→'; position: absolute; right: -23px; top: 50%; transform: translateY(-50%); font-size: 18px; font-weight: 700; }
  .change li:nth-child(1) { background: #EFF7F0; border-color: #D3E8D7; }
  .change li:nth-child(2) { background: #EDF4FB; border-color: #D3E3F2; }
  .change li:nth-child(3) { background: #EFF7F0; border-color: #D3E8D7; }
  .change li:nth-child(4) { background: #FDF0EE; border-color: #F5D7D2; }
  .change li:nth-child(5) { background: #FDEDEB; border-color: #F5D2CD; }
  .change li:nth-child(1)::after, .change li:nth-child(3)::after { color: #1E8A55; }
  .change li:nth-child(2)::after { color: #1F6FB2; }
  .change li:nth-child(4)::after { color: #D1373F; }
  .change li:nth-child(1) small, .change li:nth-child(3) small { color: #1E8A55; }
  .change li:nth-child(2) small { color: #1F6FB2; }
  .change li:nth-child(4) small, .change li:nth-child(5) small { color: #D1373F; }
  .change small { display: block; font-size: 12px; font-weight: 500; }
  .change b { display: block; font-size: 17px; letter-spacing: -.01em; }
  .change span { font-size: 11px; color: var(--g-muted); }
  .change li:nth-child(5) b { font-size: 14px; font-weight: 600; line-height: 1.25; white-space: normal; }
  .change--ov { flex: 1; }

  /* ---------- Shared bits for the newer screens ---------- */
  .split { flex: 1; min-height: 0; display: grid; gap: 12px; }
  .split--wide { grid-template-columns: 1.65fr 1fr; }
  .split--an { flex: none; height: 292px; grid-template-columns: 1.35fr 1fr; }
  .split--an2 { grid-template-columns: 1fr 1fr; }
  .split > .card, .stack > .card { display: flex; flex-direction: column; overflow: hidden; }
  .stack { display: flex; flex-direction: column; gap: 12px; min-height: 0; }
  .muted { color: var(--g-muted); }
  .chips--sm { flex-wrap: wrap; margin-bottom: 10px; }
  .chips--sm button { padding: 5px 11px; font-size: 11.5px; }
  .score { display: flex; align-items: center; gap: 8px; font-size: 12px; }
  .score i { flex: 1; height: 6px; border-radius: 999px; background: #EEF1EF; overflow: hidden; }
  .score em { display: block; height: 100%; border-radius: inherit; background: var(--g-green); }
  .score--wide { margin: 8px 0 6px; }
  .hbars { display: grid; gap: 10px; }
  .hbars li { display: grid; grid-template-columns: 1fr auto; gap: 5px 8px; font-size: 12px; }
  .hbars b { font-weight: 600; }
  .hbars i { grid-column: 1 / -1; height: 6px; border-radius: 999px; background: #EEF1EF; overflow: hidden; }
  .hbars em { display: block; height: 100%; border-radius: inherit; }
  .tile--ico { display: flex; gap: 12px; align-items: center; }
  .tile__ico { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; }
  .tile--ico em { display: block; font-style: normal; font-size: 11px; color: var(--g-muted); }
  .tile--center { text-align: center; }
  .tile--center b { display: block; font-size: 28px; line-height: 1.15; }
  .ink-tone-pink { color: #C2255C; }
  .ink-tone-amber { color: #D98A1A; }
  .ink-tone-green { color: #1E8A55; }
  .ink-tone-blue { color: #1F7FB2; }

  /* Communities */
  .vtable__row { display: grid; grid-template-columns: 1.25fr 82px 50px 1.35fr 130px 80px; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid #EEF1EF; font-size: 12.5px; }
  .vtable__row:last-child { border-bottom: 0; }
  .vtable__row[hidden] { display: none; }
  .vtable__row--head { padding-top: 0; font-size: 11px; color: var(--g-muted); }
  .vtable__row b { display: block; font-size: 13px; }
  .vtable__row small { font-size: 11px; color: var(--g-muted); }
  .voices { display: grid; gap: 14px; }
  .voices blockquote { font-size: 12.5px; line-height: 1.45; }
  .voices small { display: block; margin-top: 5px; font-size: 11px; color: var(--g-muted); }
  .voices small b { color: var(--g-ink); font-weight: 600; }

  /* Impact analytics */
  .label-row { display: flex; align-items: center; gap: 6px; font-weight: 600; font-size: 13px; margin-bottom: -4px !important; color: var(--g-ink); }
  .insights { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; flex: none; }
  .insight { display: grid; gap: 7px; align-content: start; padding: 14px; }
  .insight__ico { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; }
  .insight b { font-size: 13px; }
  .insight p { font-size: 11.5px; color: var(--g-muted); line-height: 1.45; }
  .gchart { display: block; width: 100%; flex: 1; min-height: 0; }
  .radar { display: block; width: 100%; flex: 1; min-height: 0; }
  .radar__ring { fill: none; stroke: #E3E8E5; }
  .radar__label { font-size: 11px; fill: var(--g-muted); }
  .radar__now { fill: rgba(30, 138, 85, .2); stroke: #1E8A55; stroke-width: 2; }
  .radar__base { fill: rgba(102, 115, 108, .08); stroke: #9AA5A0; stroke-width: 1.5; stroke-dasharray: 4 3; opacity: 0; transition: opacity .3s ease; }
  .radar.show-base .radar__base { opacity: 1; }
  .radar__key { background: none !important; border: 1.5px dashed #9AA5A0; }
  .btn-sm[aria-pressed='true'] { background: var(--g-active); color: #fff !important; border-color: var(--g-active) !important; }
  .sbars { display: grid; gap: 12px; }
  .sbars li { display: grid; grid-template-columns: 110px 1fr 66px; gap: 10px; align-items: center; font-size: 12px; }
  .sbars i { height: 14px; border-radius: 4px; background: #F1F4F2; overflow: hidden; }
  .sbars em { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #8CC5A3, #1E8A55); }
  .sbars b { text-align: right; font-weight: 500; }
  .heat { flex: 1; display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-rows: 1fr; gap: 8px; }
  .heat li { display: grid; place-content: center; text-align: center; border-radius: 10px; background: #F1F3F1; }
  .heat li.is-off { color: #A5AEA9; }
  .heat b { font-size: 16px; }
  .heat small { font-size: 10.5px; opacity: .9; }

  /* Finance */
  .gtable__row { display: grid; grid-template-columns: 1.6fr 82px 82px 120px 96px; gap: 12px; align-items: center; padding: 11px 0; border-bottom: 1px solid #EEF1EF; font-size: 12.5px; }
  .gtable__row[hidden] { display: none; }
  .gtable__row--head { padding-top: 0; font-size: 11px; color: var(--g-muted); }
  .gtable__row--total { border-bottom: 0; }
  .gtable__row b { display: block; font-size: 13px; }
  .gtable__row small { font-size: 11px; color: var(--g-muted); }
  .pill--uc-submitted { background: #E3F3EA; color: #1E8A55; }
  .pill--uc-due { background: #FDF0DA; color: #B8730C; }
  .cols { flex: 1; min-height: 120px; display: grid; grid-template-columns: repeat(12, 1fr); gap: 6px; align-items: end; }
  .cols div { height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 5px; }
  .cols i { width: 100%; border-radius: 4px 4px 0 0; background: linear-gradient(180deg, #1E8A55, #6FB68C); }
  .cols small { font-size: 9.5px; color: var(--g-muted); }

  /* Participation */
  .surveys { display: grid; gap: 14px; }
  .surveys li { padding-bottom: 12px; border-bottom: 1px solid #EEF1EF; }
  .surveys li:last-child { padding-bottom: 0; border-bottom: 0; }
