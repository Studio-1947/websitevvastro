---
/**
 * Doptor ERP hero, the same design as the S47 Vyapar hero (components/isd/Hero):
 * app mark, product name, headline, one line of copy and a button. Below it,
 * a working copy of the Office Manager workspace (see OfficeDashboard).
 * Motion: the wash is made of a few large blurred blobs that drift slowly,
 * like light moving through mist, in Studio 1947 red. Held still for reduced motion.
 */
import { ctaAttrs } from '../../pharma/types';
import OfficeDashboard from '../OfficeDashboard/index.astro';
import type { HeroContent } from '../../isd/Hero/content';

interface Props { content: HeroContent }
const { content: c } = Astro.props;
---

<section class="phero" aria-labelledby="doptor-hero-title">
  <div class="phero__bg" aria-hidden="true">
    <span class="phero__blob phero__blob--1"></span>
    <span class="phero__blob phero__blob--2"></span>
    <span class="phero__blob phero__blob--3"></span>
    <span class="phero__blob phero__blob--4"></span>
  </div>
  <div class="phero__copy">
    {/* The product's own mark: four workspaces in one grid, in red, on its own. */}
    <span class="phero__icon" aria-hidden="true">
      <svg width="76" height="76" viewBox="0 0 24 24" fill="none" stroke="#E60000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="7" height="7" rx="1.6" /><rect x="13.5" y="3.5" width="7" height="7" rx="1.6" /><rect x="3.5" y="13.5" width="7" height="7" rx="1.6" /><rect x="13.5" y="13.5" width="7" height="7" rx="1.6" /></svg>
    </span>
    <p class="phero__name"><b>{c.name}</b> <span>{c.kind}</span></p>
    <h1 id="doptor-hero-title" class="phero__title">{c.title}</h1>
    <p class="phero__sub">{c.sub}</p>
    <a class="p-btn" {...ctaAttrs(c.primary)}>{c.primary.label}</a>
  </div>

  {/* Points down to the live workspace; the arrow keeps pulsing to invite a try. */}
  <p class="phero__example">
    <span class="phero__example-text">{c.example}</span>
    <span class="phero__example-arrow" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v15M6 13l6 6 6-6"/></svg>
    </span>
  </p>

  {/* The Office Manager section further down links back here. */}
  <div id="office-demo" class="phero__demo"><OfficeDashboard /></div>
</section>

<style>
  .phero {
    position: relative; isolation: isolate;
    padding: clamp(140px, 13vw, 180px) clamp(16px, 5vw, 72px) clamp(64px, 8vw, 120px);
  }

  /* The moving wash. It sits behind everything and fades into the page
     before the product preview ends, so the next section starts on plain ground. */
  .phero__bg {
    position: absolute; inset: 0; z-index: -1; overflow: hidden;
    background: #FEF5F3;
    -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent 90%);
    mask-image: linear-gradient(to bottom, #000 50%, transparent 90%);
  }
  /* Soft edges come from a radial gradient, not filter: blur(). A blur on
     layers this large is re-rendered on every repaint nearby, which starved
     the dashboard demo below of frames and made its pointer stutter. */
  .phero__blob {
    position: absolute; border-radius: 50%; opacity: .9;
    background: radial-gradient(closest-side, var(--c) 68%, transparent);
    scale: 1.2; /* the blur used to spill past the edge; this keeps that size */
    will-change: transform;
  }
  .phero__blob--1 { --c: #FFE8E4; width: 55vw; height: 55vw; left: -12vw; top: -18vw; animation: phero-drift-1 26s ease-in-out infinite alternate; }
  .phero__blob--2 { --c: #FFD2CB; width: 48vw; height: 48vw; right: -10vw; top: -14vw; animation: phero-drift-2 31s ease-in-out infinite alternate; }
  .phero__blob--3 { --c: #FFBDB4; width: 44vw; height: 44vw; left: 38vw; top: 22vw; opacity: .45; animation: phero-drift-3 23s ease-in-out infinite alternate; }
  .phero__blob--4 { --c: #FFF0EC; width: 40vw; height: 40vw; left: -6vw; top: 26vw; animation: phero-drift-4 35s ease-in-out infinite alternate; }

  @keyframes phero-drift-1 { to { transform: translate(14vw, 8vw) scale(1.12); } }
  @keyframes phero-drift-2 { to { transform: translate(-16vw, 10vw) scale(.9); } }
  @keyframes phero-drift-3 { to { transform: translate(-20vw, -6vw) scale(1.15); } }
  @keyframes phero-drift-4 { to { transform: translate(12vw, -10vw) scale(1.08); } }

  @media (max-width: 760px) {
    .phero__blob--1, .phero__blob--2 { width: 90vw; height: 90vw; }
    .phero__blob--3 { width: 80vw; height: 80vw; top: 70vw; left: 20vw; }
    .phero__blob--4 { width: 70vw; height: 70vw; top: 60vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .phero__blob { animation: none; }
  }
  .phero__copy { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .phero__demo { scroll-margin-top: 110px; }
  .phero__icon {
    display: grid; place-items: center; margin-bottom: clamp(24px, 2.6vw, 34px);
  }
  .phero__name { margin: 0 0 clamp(12px, 1.4vw, 18px); font-size: clamp(18px, 1.6vw, 24px); color: var(--p-ink); }
  .phero__name b { font-weight: 600; color: #E60000; }
  .phero__name span { color: var(--p-muted); }
  .phero__title { margin: 0; max-width: 16ch; font-size: clamp(42px, 5.6vw, 76px); line-height: 1.04; }
  .phero__example {
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    margin: clamp(28px, 3vw, 40px) 0 -6px; font-size: 14px;
  }
  .phero__example-text {
    padding: 8px 16px; border-radius: 999px;
    background: rgba(230, 0, 0, .08); color: #B4121B; font-weight: 500;
    box-shadow: inset 0 0 0 1px rgba(230, 0, 0, .18);
  }
  .phero__example-arrow { display: grid; place-items: center; color: #E60000; animation: phero-arrow 1.4s ease-in-out infinite; }
  @keyframes phero-arrow {
    0%, 100% { transform: translateY(-3px); opacity: .25; }
    50% { transform: translateY(5px); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .phero__example-arrow { animation: none; } }
  .phero__sub { margin: 18px 0 30px; font-size: clamp(18px, 1.5vw, 21px); line-height: 1.4; }
</style>
