---
/**
 * "Who sees what" in one workspace: the closing beat of each space block on
 * /products/doptor-erp/ (campus, office, NGO). A short label on one side and
 * three roles, each with what it sees and does, on a flat light red band.
 * Phones: stacked.
 */
export interface AccessContent {
  /** Which workspace, shown under the label (e.g. "Campus Manager"). */
  space: string;
  roles: { role: string; text: string }[];
}
interface Props { content: AccessContent }
const { content: c } = Astro.props;
---

<section class="access" aria-label={`Who sees what: ${c.space}`}>
  <div class="access__band reveal">
    <div class="access__head">
      <p class="access__label">Who sees what</p>
      <p class="access__space">{c.space}</p>
    </div>
    <ul class="access__roles">
      {c.roles.map((r, i) => (
        <li>
          <span class="access__level" aria-hidden="true">{i + 1}</span>
          <b>{r.role}</b>
          <span>{r.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .access { max-width: 1280px; margin: 0 auto; padding: 0 clamp(16px, 5vw, 72px) clamp(56px, 7vw, 110px); }
  .access__band {
    display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: clamp(20px, 4vw, 56px); align-items: center;
    padding: clamp(22px, 3vw, 36px) clamp(22px, 3.4vw, 44px); border-radius: 16px; background: #FFECE9;
  }
  .access__label { margin: 0 0 6px; font-size: 14px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #B4121B; }
  .access__space { margin: 0; font-family: var(--font-display); font-size: clamp(22px, 2vw, 28px); line-height: 1.15; letter-spacing: -.01em; }
  .access__roles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .access__roles li { display: grid; align-content: start; gap: 4px; padding: 14px 16px; border-radius: 12px; background: #fff; }
  .access__level { display: grid; place-items: center; width: 24px; height: 24px; margin-bottom: 6px; border-radius: 50%; background: var(--p-ink); color: #fff; font-size: 12px; }
  .access__roles b { font-size: 16px; font-weight: 600; }
  .access__roles li > span:last-child { font-size: 14.5px; line-height: 1.5; color: var(--p-muted); }

  @media (max-width: 900px) {
    .access__band { grid-template-columns: 1fr; }
    .access__roles { grid-template-columns: 1fr; }
  }
</style>
