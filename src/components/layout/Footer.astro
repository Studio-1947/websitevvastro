---
/**
 * CTA + footer: one red block with the hills photo behind both, plus the live
 * Darjeeling conditions strip. Markup ported from partials/footer.html.
 *
 * Rendered exactly ONCE per page (as a single component), which by construction
 * removes source defect D1: the duplicated/nested `.footer-block` that appeared
 * on 53 of 60 original pages (see MIGRATION_AUDIT.md §8).
 *
 * Behaviour (live clock/temp/AQI + current year) is wired in
 * src/scripts/darjeeling.ts, loaded globally via BaseLayout.
 */
import { Image } from 'astro:assets';
import footerHills from '../../assets/img/footer-hills.webp';

const year = new Date().getFullYear();
---

<div class="footer-block">
  {/* Full-bleed backdrop on every page, so it carries the site-wide win.
      Decorative (empty alt) and always below the fold, lazy, unlike the
      original eager <img>. */}
  <div class="footer-block__bg"><Image src={footerHills} sizes="100vw" quality={85} widths={[640, 960, 1280, 1600]} alt="" loading="lazy" /></div>

  <section class="cta">
    <div class="container">
      <h2 class="cta__title" data-i18n="global.footer.ctaTitle">Let's co-create something<br />meaningful &amp; impactful together.</h2>
      <a class="cta__btn" href="/sayhello/" data-contact-open>
        <span data-i18n="global.nav.sayHello">Say Hello</span>
        <span class="arrow" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <ul class="footer__col">
          <li><a href="/products/" data-i18n="global.footer.ourProducts">Products</a></li>
          <li><a href="/solutions/" data-i18n="global.footer.ourSolutions">Solutions</a></li>
          <li><a href="/about-us/" data-i18n="global.footer.ourJourney">Journey</a></li>
          {/* Labelled for where it goes. "Press Corner" is a separate thing and
              has no page yet: when it exists it gets its own entry here. */}
          <li><a href="/initiatives/" data-i18n="global.footer.initiatives">Initiatives</a></li>
          <li><a href="/people/" data-i18n="global.footer.people">People</a></li>
        </ul>
        <ul class="footer__col">
          <li><a href="/accessibility-statement/" data-i18n="global.footer.accessibility">Accessibility</a></li>
          <li><a href="/privacy-policy/" data-i18n="global.footer.privacyPolicy">Privacy Policy</a></li>
          <li><a href="/terms-of-service/" data-i18n="global.footer.termsOfService">Terms of Service</a></li>
          <li><a href="/labour-employment-policy/" data-i18n="global.footer.labourPolicy">Employment Policy</a></li>
          <li><a href="/careers/" data-i18n="global.footer.career">Career</a></li>
        </ul>
        {/* Names on wide screens; on phones the same links become a row of icons above the
            other columns (the name stays for screen readers). Icons are the brands' own marks. */}
        <ul class="footer__col footer__social">
          <li><a href="https://www.instagram.com/1947.io/" target="_blank" rel="noopener">
            <svg class="footer__social-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
            <span>Instagram</span></a></li>
          <li><a href="https://www.linkedin.com/company/studio-1947" target="_blank" rel="noopener">
            <svg class="footer__social-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            <span>LinkedIn</span></a></li>
          <li><a href="https://www.facebook.com/1947.io/" target="_blank" rel="noopener">
            <svg class="footer__social-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <span>Facebook</span></a></li>
        </ul>
        <address class="footer__addr">
          <div class="footer__addr-head">
            <strong data-i18n="global.footer.hqLine">Headquarter <br />@&nbsp;Mirik, Darjeeling</strong>
            <a class="footer__map" href="https://maps.app.goo.gl/mNnNQbUaWLFf5Xw79" target="_blank" rel="noopener" aria-label="Open our Mirik office in Google Maps"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a>
          </div>
          Studio 1947, 1/149 Manbir Thapa Road,<br />
          Ward 4, Mirik, Darjeeling - 734214<br />
          Coming Soon @Plassey, Nadia
        </address>
      </div>
      <div class="footer__bar">
        <span class="footer__wordmark">STUDIO 1947</span>
        <div class="footer__meta">
          <!-- Live Darjeeling conditions. Starts hidden and is only revealed once a
               value resolves, so a blocked or failed request leaves no broken UI. -->
          <p class="footer__live" data-live hidden>
            <span class="footer__live-item"><svg class="footer__live-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Darjeeling</span>
            <span class="footer__live-item" data-live-time-wrap hidden><svg class="footer__live-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5l3 2"/></svg><time data-live-time></time></span>
            <span class="footer__live-item" data-live-temp-wrap hidden><svg class="footer__live-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 14.76V5a2 2 0 1 0-4 0v9.76a4 4 0 1 0 4 0z"/></svg><span data-live-temp></span></span>
            <span class="footer__live-item" data-live-aqi-wrap hidden><svg class="footer__live-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h11a3 3 0 1 0-3-3"/><path d="M3 12h15a3 3 0 1 1-3 3"/><path d="M3 16h8a2.5 2.5 0 1 1-2.5 2.5"/></svg><span data-live-aqi></span></span>
          </p>
          <span class="footer__copy">&copy; <span data-year>{year}</span> <span data-i18n="global.footer.copyBy">by</span> Studio 1947</span>
        </div>
      </div>
    </div>
  </footer>
</div>
