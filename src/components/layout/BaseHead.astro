---
/**
 * <head> for every page: SEO meta, OG/Twitter, canonical, fonts, favicon,
 * JSON-LD. Mirrors the original static site's head, componentized.
 */
import { SITE, DEFAULT_FONT_HREF, SYNE_LATIN_URL, canonicalUrl, absoluteUrl, organizationJsonLd, type SeoProps } from '../../lib/seo';

type Props = SeoProps & { fontHref?: string };
const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  ogTitle,
  ogDescription,
  ogType = 'website',
  image,
  imageSize,
  imageAlt,
  path,
  jsonLd = [],
  noindex = false,
  fontHref = DEFAULT_FONT_HREF,
} = Astro.props;

const canonical = canonicalUrl(path, Astro.url.pathname);
const ogImage = absoluteUrl(image ?? '/assets/img/brand-mark.png');
const structured = [organizationJsonLd(), ...jsonLd];

// Each page loads the EXACT Google Fonts set its original counterpart loaded
// (3 variants across the site). Weight sets matter: the ERP product pages load
// Google Sans weight 400 only, which changes how the 500-weight footer wordmark
// resolves: loading extra weights broke parity (see MIGRATION_REPORT). "Google
// Sans" is not a public family; behaviour is reproduced verbatim.
const fontsHref = fontHref;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Q1S9K42RXD"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-Q1S9K42RXD');
</script>

<title>{title}</title>
<meta name="description" content={description} />
{/* Pages that build and resolve by URL but are not ready to be found. */}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<link rel="icon" href="/assets/img/brand-mark.png" />
<!-- /favicon.ico is requested by browsers and crawlers whether or not it is
     declared, so it ships as a real multi-resolution file rather than a 404. -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#e60000" />

<!-- Open Graph -->
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={ogTitle ?? title} />
<meta property="og:description" content={ogDescription ?? description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
{
  /* Declaring the dimensions lets crawlers lay the card out without first
     fetching the image to measure it: the difference between a card that
     renders immediately and one that appears blank on first share. */
  ogImage && imageSize && (
    <>
      <meta property="og:image:width" content={String(imageSize.w)} />
      <meta property="og:image:height" content={String(imageSize.h)} />
    </>
  )
}
{ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle ?? title} />
<meta name="twitter:description" content={ogDescription ?? description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<!-- Fonts
     The Google Fonts stylesheet is deliberately NOT render-blocking: it ships
     90+ @font-face blocks (three families, several subsets each), and in the
     original head it sat between the page and first paint, delaying the LCP
     (the hero title) by a full CSS round-trip plus parse. Every face here uses
     font-display: swap, so text paints immediately in the fallback face and
     swaps when ready; the `preload as=style` + `media=print` onload pattern
     keeps one fetch, and the Syne preload below warms the hero font in
     parallel so the swap lands within the first frames. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{fontsHref.includes('Syne') && (
  <link rel="preload" as="font" type="font/woff2" crossorigin href={SYNE_LATIN_URL} />
)}
<link rel="preload" as="style" href={fontsHref} />
<link href={fontsHref} rel="stylesheet" media="print" onload="this.media='all'" />
<noscript>
  <link href={fontsHref} rel="stylesheet" />
</noscript>

<meta name="generator" content={Astro.generator} />

<!-- Structured data -->
{
  structured.map((obj) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(obj)} />
  ))
}

<!-- Umami Analytics -->
<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="fdd51a3a-9f34-4567-af1b-6628a8ee7e82"></script>

<slot />
