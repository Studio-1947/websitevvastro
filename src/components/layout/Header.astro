---
/**
 * Site header: floating pill nav with three dropdowns (About / Solutions /
 * Products), plain links (Portfolio, Blogs), the "Say Hello" button, the
 * hamburger, and the mobile drawer. Markup ported verbatim from
 * partials/header.html. Behaviour is wired in src/scripts/{nav,mobileMenu}.ts
 * (loaded globally via BaseLayout). Identical on every page.
 */
---

<header class="site-header">
  <nav class="nav" aria-label="Primary">
    <a class="nav__brand" href="/" aria-label="Studio 1947 home">
      <img src="/assets/img/brand-mark.svg" alt="Studio 1947" width="38" height="38" />
    </a>
    <div class="nav__links">
      <div class="nav__item has-dropdown">
        <button class="nav__trigger" type="button" aria-expanded="false" aria-controls="dd-about">
          About Us
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="nav__dropdown" id="dd-about">
          <div class="dd__intro">
            <p class="eyebrow">About Studio 1947</p>
            <h3>The people co-creating with you</h3>
            <a class="dd__cta" href="/about-us/">See overview</a>
          </div>
          <div class="dd__list">
            <p class="dd__label">Company</p>
            <a class="dd__item" href="/about-us/#our-story">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg></span>
              Our Story
            </a>
            <a class="dd__item" href="/about-us/#team">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 19c0-3 3-5 6.5-5s6.5 2 6.5 5"/><circle cx="17" cy="8.5" r="2.4"/><path d="M15.7 13.8c2.7.4 4.8 2.1 4.8 4.7"/></svg></span>
              Our Team
            </a>
            <a class="dd__item" href="/about-us/#values">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.8C.8 8.7 2.2 5 6 5c2 0 3.3 1 4 2.2C10.7 6 12 5 14 5c3.8 0 5.2 3.7 3.5 7.2C19 16.65 12 21 12 21Z"/></svg></span>
              Our Values
            </a>
            <a class="dd__item" href="/careers/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/></svg></span>
              Careers
            </a>
          </div>
        </div>
      </div>

      <a href="/our-work/">Portfolio</a>

      <div class="nav__item has-dropdown">
        <button class="nav__trigger" type="button" aria-expanded="false" aria-controls="dd-solutions">
          Solutions
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="nav__dropdown" id="dd-solutions">
          <div class="dd__intro">
            <p class="eyebrow">Our Solutions</p>
            <h3>Solutions built for real-world impact</h3>
            <a class="dd__cta" href="/solutions/">See overview</a>
          </div>
          <div class="dd__list">
            <p class="dd__label">Solutions</p>
            <a class="dd__item" href="/solutions/data-design-tech/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><path d="M7 20V10M12 20V4M17 20v-8"/></svg></span>
              Data, Design &amp; Tech
            </a>
            <a class="dd__item" href="/solutions/communication-campaign/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11v2a1 1 0 0 0 1 1h3l4.5 4V6L7 10H4a1 1 0 0 0-1 1Z"/><path d="M15.5 8.5a4 4 0 0 1 0 7"/></svg></span>
              Communication &amp; Campaign
            </a>
            <a class="dd__item" href="/solutions/research-survey/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.35-4.35"/></svg></span>
              Research &amp; Survey
            </a>
            <a class="dd__item" href="/solutions/capacity-building/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="M3 12l9 5 9-5M3 16l9 5 9-5"/></svg></span>
              Capacity Building
            </a>
          </div>
        </div>
      </div>

      <div class="nav__item has-dropdown">
        <button class="nav__trigger" type="button" aria-expanded="false" aria-controls="dd-products">
          Products
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="nav__dropdown" id="dd-products">
          <div class="dd__intro">
            <p class="eyebrow">Our Products</p>
            <h3>Explore our next-generation products</h3>
            <a class="dd__cta" href="/products/">See overview</a>
          </div>
          <div class="dd__list">
            <p class="dd__label">Products</p>
            <span class="dd__item dd__item--soon" data-href="/products/doptor-campus-manager/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 2.7 2 6 2s6-1 6-2v-5"/><path d="M22 10v6"/></svg></span>
              Doptor Campus Manager
              <em class="dd__soon">Soon</em>
            </span>
            <span class="dd__item dd__item--soon" data-href="/products/doptor-office-manager/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/></svg></span>
              Doptor Office Manager
              <em class="dd__soon">Soon</em>
            </span>
            <span class="dd__item dd__item--soon" data-href="/products/doptor-ngo-manager/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/></svg></span>
              Doptor NGO Manager
              <em class="dd__soon">Soon</em>
            </span>
            <span class="dd__item dd__item--soon" data-href="/products/inventory-sales-dashboard/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15V9M12 15V6M17 15v-4"/></svg></span>
              Inventory + Sales Dashboard
              <em class="dd__soon">Soon</em>
            </span>
            <span class="dd__item dd__item--soon" data-href="/products/social-flow/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="m8.3 10.7 7.4-4.3M8.3 13.3l7.4 4.3"/></svg></span>
              Social Flow
              <em class="dd__soon">Soon</em>
            </span>
            <span class="dd__item dd__item--soon" data-href="/products/1-darjeeling/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><path d="m5 20 5-9 4 6 2-3 3 6"/><circle cx="17" cy="5" r="2"/></svg></span>
              1 Darjeeling
              <em class="dd__soon">Soon</em>
            </span>
            <span class="dd__item dd__item--soon" data-href="/products/pharma-erp/">
              <span class="dd__ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 21 7v10l-9 5-9-5V7Z"/><path d="M12 12 21 7M12 12v10M12 12 3 7"/></svg></span>
              Pharma ERP
              <em class="dd__soon">Soon</em>
            </span>
          </div>
        </div>
      </div>

      <a href="/blog/">Blogs</a>
    </div>
    <a class="btn-hello" href="/sayhello/">
      Say Hello
      <span class="arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </span>
    </a>
    <button class="nav__burger" aria-label="Open menu"><span></span></button>
  </nav>
</header>

<div class="mobile-menu" inert>
  <button class="mobile-menu__close" aria-label="Close menu">&times;</button>
  <a href="/about-us/">About Us</a>
  <a href="/our-work/">Portfolio</a>
  <a href="/solutions/">Solutions</a>
  <a href="/products/">Products</a>
  <a href="/blog/">Blogs</a>
  <a href="/sayhello/">Say Hello</a>
</div>

