---
/**
 * "And that is the whole idea": the manifesto payoff that follows MarkStory.
 *
 * The four discipline lines (Data / Design / Technology / Communication) are the
 * four crossing lines MarkStory builds its wheel from; this is where they land.
 *
 * Scroll effect: a pinned stage (a tall wrapper + a sticky 100vh stage, the same
 * pattern MarkStory uses so it plays nicely with Lenis). As the section scrolls
 * through, the text grows and rises, and the lines reveal in sequence. Text is
 * fully visible by default, so no-JS and reduced-motion readers lose nothing.
 */
---

<section class="wi" aria-label="Studio 1947: the whole idea">
  <div class="wi-scrolly" id="wi-scrolly">
    <div class="wi-stage">
      <canvas class="wi-dots" id="wi-dots" aria-hidden="true"></canvas>
      <div class="wi-inner" id="wi-inner">
        <p class="wi-open" data-i18n="about.wi.open">And that is the whole idea.</p>

        <p class="wi-line wi-disc" data-i18n="about.wi.disc1"><span>Data</span> measures it.</p>
        <p class="wi-line wi-disc" data-i18n="about.wi.disc2"><span>Design</span> shapes it.</p>
        <p class="wi-line wi-disc" data-i18n="about.wi.disc3"><span>Technology</span> moves it.</p>
        <p class="wi-line wi-disc" data-i18n="about.wi.disc4"><span>Communication</span> carries it.</p>

        <p class="wi-line wi-jrny" data-i18n="about.wi.jrny1">It leaves the ridge,</p>
        <p class="wi-line wi-jrny" data-i18n="about.wi.jrny2">it crosses the world,</p>
        <p class="wi-line wi-jrny" data-i18n="about.wi.jrny3">and it comes back to <em>Darjeeling</em>.</p>

        <button class="wi-again" id="wi-replay" type="button" data-i18n="about.wi.replay">Build it again</button>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .wi { background: linear-gradient(160deg, #4a0a0a 0%, #2a0505 55%, #1c0303 100%); color: #fff; }
  /* Tall wrapper gives the pin something to scrub against; the stage stays put. */
  .wi-scrolly { position: relative; height: 260vh; }
  .wi-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    place-items: center start;
    overflow: hidden;
    padding: 8vh clamp(20px, 6vw, 84px);
  }
  /* Mild dot-wave texture behind the text: data points rolling like the mark
     itself, in the same red/design/tech register as the four disciplines. */
  .wi-dots { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .wi-inner {
    position: relative;
    z-index: 1;
    text-align: left;
    max-width: 1300px;
    transform-origin: left 40%;
    will-change: transform;
  }
  .wi-open {
    font-family: 'Google Sans', system-ui, sans-serif;
    font-size: clamp(15px, 1.5vw, 20px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: clamp(24px, 4.4vw, 52px);
  }
  .wi-line {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(30px, 4.6vw, 68px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .wi-disc span { color: #ff9d9d; }
  .wi-jrny { color: #fff; }
  /* A gap between the four disciplines and the three journey lines. */
  .wi-jrny:first-of-type { margin-top: clamp(20px, 3.4vw, 44px); }
  .wi-jrny em { font-style: normal; color: #ff9d9d; }

  /* "Build it again": the replay control, sitting below the closing line. */
  .wi-again {
    margin-top: clamp(28px, 4vw, 52px);
    font-family: 'Google Sans', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
    background: none;
    border: 0;
    border-bottom: 1px solid #ff9d9d;
    padding: 0 0 6px;
    cursor: pointer;
  }
  .wi-again:focus-visible { outline: 2px solid #ff9d9d; outline-offset: 4px; }

  /* Enhanced state only applies once JS marks the section active; without it
     (no-JS) everything stays fully visible. */
  .wi.is-live .wi-line,
  .wi.is-live .wi-again { opacity: 0; transform: translateY(20px); }

  @media (prefers-reduced-motion: reduce) {
    .wi-scrolly { height: auto; }
    .wi-stage { position: static; height: auto; min-height: 60vh; }
    .wi.is-live .wi-line,
    .wi.is-live .wi-again { opacity: 1; transform: none; }
  }
</style>

<script is:inline>
  (function () {
    // Mild dot-wave: a grid of dots undulating like the wheel's own journey,
    // painted at very low opacity so it reads as texture, not decoration.
    var canvas = document.getElementById('wi-dots');
    if (canvas) {
      var ctx = canvas.getContext('2d');
      var dotsRM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var stage = canvas.parentElement;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var W, H, dots = [];
      var SPACING = 36;

      function buildDots() {
        dots = [];
        var cols = Math.ceil(W / SPACING) + 2;
        var rows = Math.ceil(H / SPACING) + 2;
        for (var r = 0; r < rows; r++) {
          for (var c = 0; c < cols; c++) {
            dots.push({ x: c * SPACING, y: r * SPACING, row: r });
          }
        }
      }
      function resizeDots() {
        W = stage.clientWidth;
        H = stage.clientHeight;
        canvas.width = W * dpr;
        canvas.height = H * dpr;
        canvas.style.width = W + 'px';
        canvas.style.height = H + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        buildDots();
      }
      function drawDots(t) {
        ctx.clearRect(0, 0, W, H);
        for (var i = 0; i < dots.length; i++) {
          var d = dots[i];
          var wave = Math.sin(d.x * 0.012 + t * 0.00045 + d.row * 0.35) * 9
                   + Math.sin(d.y * 0.01 - t * 0.0003) * 5;
          var y = d.y + wave;
          var alpha = 0.035 + 0.045 * (Math.sin(d.x * 0.012 + t * 0.00045 + d.row * 0.35) * 0.5 + 0.5);
          ctx.beginPath();
          ctx.arc(d.x, y, 1.5, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255,255,255,' + alpha.toFixed(3) + ')';
          ctx.fill();
        }
      }
      window.addEventListener('resize', resizeDots);
      resizeDots();
      if (dotsRM) {
        drawDots(0);
      } else {
        (function loop(t) { drawDots(t); requestAnimationFrame(loop); })(0);
      }
    }

    var RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var scrolly = document.getElementById('wi-scrolly');
    var inner = document.getElementById('wi-inner');
    if (!scrolly || !inner) return;

    var lines = inner.querySelectorAll('.wi-line');
    var again = document.getElementById('wi-replay');
    var section = scrolly.closest('.wi');

    function clamp(v, a, b) { return v < a ? a: v > b ? b: v; }
    function seg(p, a, b) { return clamp((p - a) / (b - a), 0, 1); }

    // Replay the wheel build. Works regardless of motion preference, so it is
    // wired before the reduced-motion return below.
    if (again) {
      again.addEventListener('click', function () {
        var el = document.getElementById('sf-build');
        if (el) window.scrollTo({ top: el.offsetTop, behavior: RM ? 'auto' : 'smooth' });
      });
    }

    if (RM) return; // CSS renders the static, fully-visible layout

    section.classList.add('is-live');

    function render(p) {
      var vh = window.innerHeight || 800;
      // The whole block grows and rises as the section scrolls through.
      var scale = 0.84 + p * 0.34;          // 0.84 -> 1.18
      var y = (0.11 - p * 0.22) * vh;        // +11vh -> -11vh
      inner.style.transform = 'translateY(' + y.toFixed(1) + 'px) scale(' + scale.toFixed(3) + ')';

      // Lines reveal in sequence across the first ~75% of the scrub.
      var n = lines.length;
      for (var i = 0; i < n; i++) {
        var start = (i / n) * 0.55;
        var t = seg(p, start, start + 0.16);
        lines[i].style.opacity = t.toFixed(3);
        lines[i].style.transform = 'translateY(' + ((1 - t) * 20).toFixed(1) + 'px)';
      }
      // The replay control comes in just after the last line.
      if (again) {
        var bt = seg(p, 0.62, 0.8);
        again.style.opacity = bt.toFixed(3);
        again.style.transform = 'translateY(' + ((1 - bt) * 20).toFixed(1) + 'px)';
      }
    }

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        var r = scrolly.getBoundingClientRect();
        var total = scrolly.offsetHeight - window.innerHeight;
        render(clamp(-r.top / (total || 1), 0, 1));
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    render(0);
  })();
</script>
