          <g transform="translate(300,300)">
            <rect class="sf-cons bar" id="sf-a0" x="-166.5" y="-14.3" width="333" height="28.6"/>
            <rect class="sf-cons bar" id="sf-a1" x="-166.5" y="-14.3" width="333" height="28.6" transform="rotate(45)"/>
            <rect class="sf-cons bar" id="sf-a2" x="-166.5" y="-14.3" width="333" height="28.6" transform="rotate(90)"/>
            <rect class="sf-cons bar" id="sf-a3" x="-166.5" y="-14.3" width="333" height="28.6" transform="rotate(135)"/>
          </g>
          <circle class="sf-cons" cx="300" cy="300" r="51.2"/>
        </g>
      </g>
    </svg>
  </div>
</section>

<!-- The manifesto text AND its "Build it again" replay control now live in the
     scroll-driven Manifesto section rendered right after this one, so the whole
     close band is gone from here. -->

</section>

<script is:inline>
(function(){
  "use strict";
  var RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── geometry helpers ─────────────────────────────────────────── */
  var CX = 500, CY = 500, R = 330, HUB = 84;
  var TAGS = ['Data','Design','Technology'];

  function clamp(v,a,b){ return v<a?a:(v>b?b:v); }
  function seg(p,a,b){ return clamp((p-a)/(b-a),0,1); }
  function lerp(a,b,t){ return a+(b-a)*t; }
  function easeOut(t){ return 1-Math.pow(1-t,3); }
  function easeInOut(t){ return t<.5 ? 4*t*t*t : 1-Math.pow(-2*t+2,3)/2; }
  function pol(cx,cy,a,r){ var t=a*Math.PI/180; return [cx+r*Math.cos(t), cy+r*Math.sin(t)]; }

  /* pie wedge used as a reveal mask */
  function wedge(cx,cy,a0,span,r){
    if(span<=0.05) return 'M0 0';
    if(span>=359.9) span = 359.9;
    var s=pol(cx,cy,a0,r), e=pol(cx,cy,a0+span,r), la = span>180?1:0;
    return 'M'+cx+','+cy+' L'+s[0].toFixed(2)+','+s[1].toFixed(2)+
           ' A'+r+','+r+' 0 '+la+' 1 '+e[0].toFixed(2)+','+e[1].toFixed(2)+' Z';
  }

  var $ = function(id){ return document.getElementById(id); };

  /* ── STAGE: three bold lines cross, one circle closes it ──────── */
  var stage = $('sf-stage');
  if(stage){
    var G  = [$('sf-g0'),$('sf-g1'),$('sf-g2'),$('sf-g3')];
    var L  = [$('sf-l0'),$('sf-l1'),$('sf-l2'),$('sf-l3')];
    var D  = [$('sf-d0'),$('sf-d1'),$('sf-d2'),$('sf-d3')];
    var T  = [$('sf-t0'),$('sf-t1'),$('sf-t2'),$('sf-t3')];
    var guides = $('sf-guides'), logo = $('sf-logo'), lockup = $('sf-lockup');
    var ring = $('sf-ring'), hub = $('sf-hub');
    var caps = Array.prototype.slice.call(document.querySelectorAll('#sf-build .sf-cap'));
    var fill = $('sf-fill'), count = $('sf-count');
    var scrolly = $('sf-build');

    /* every number below is measured off the real mark */
    var CX = 500, CY = 500;
    var REACH  = 274.7;    /* spokes run out to the inner edge of the rim   */
    var BOLD   = 47.2;     /* the mark's own spoke width: 0.143 x R (R=330) */
    var HUBR   = 84.4;     /* and that core's inscribed circle is the hub   */
    var RINGC  = 2*Math.PI*302.35;
    var TILT   = -1.5;                  /* the mark itself sits 1.5 deg off-axis   */
    var ANG    = [0+TILT, 45+TILT, 90+TILT, 135+TILT];  /* -> the 8 real spoke angles */
    var TAGA   = [180+TILT, 45+TILT, 270+TILT, 315+TILT];
    var HY     = [359, 453, 547, 641];  /* stacked, before they cross             */

    ring.setAttribute('stroke-dasharray', RINGC.toFixed(1));

    function mix(t){   /* ink -> red, as the circle closes */
      return 'rgb('+Math.round(lerp(11,230,t))+','+Math.round(lerp(11,0,t))+','+Math.round(lerp(12,0,t))+')';
    }

    /* white marks cut into each bold bar — one per discipline */
    function decorate(i, x1,y1,x2,y2, alpha){
      var g = D[i];
      if(alpha <= 0.01){ if(g.firstChild) g.textContent=''; return; }
      var dx=x2-x1, dy=y2-y1, len=Math.hypot(dx,dy) || 1;
      var ux=dx/len, uy=dy/len, px=-uy, py=ux, h=BOLD/2, out='';

      function cross(f, wid, frac){
        var bx=x1+dx*f, by=y1+dy*f, e=h*frac;
        out += '<line class="sf-cut" stroke-width="'+wid+'" x1="'+(bx-px*e).toFixed(1)+'" y1="'+(by-py*e).toFixed(1)+
               '" x2="'+(bx+px*e).toFixed(1)+'" y2="'+(by+py*e).toFixed(1)+'"/>';
      }
      if(i===0){                                   /* Data — ruled increments */
        for(var t=0;t<=20;t++) cross(t/20, t%5===0 ? 4 : 2.4, t%5===0 ? 1 : 0.5);
      } else if(i===1){                            /* Design — a path with handles */
        out += '<line class="sf-cut" stroke-width="2.4" x1="'+x1.toFixed(1)+'" y1="'+y1.toFixed(1)+
               '" x2="'+x2.toFixed(1)+'" y2="'+y2.toFixed(1)+'"/>';
        [[x1,y1],[x2,y2],[(x1+x2)/2,(y1+y2)/2]].forEach(function(q,n){
          out += '<circle class="sf-cut" stroke-width="'+(n===2?2:2.6)+'" cx="'+q[0].toFixed(1)+
                 '" cy="'+q[1].toFixed(1)+'" r="'+(n===2?8:14)+'"/>';
        });
      } else if(i===2){                            /* Technology — sampled blocks */
        for(var j=1;j<8;j++) cross(j/8, 13, 1);
      } else {                                     /* Communication — carried outward */
        var wh = h*0.60, dp = 9;
        for(var m=0;m<8;m++){
          var f2=(m+0.5)/8, bx2=x1+dx*f2, by2=y1+dy*f2, sg=(f2<0.5?-1:1);
          out += '<polyline class="sf-cut" stroke-width="3" points="'+
                 (bx2-ux*sg*dp+px*wh).toFixed(1)+','+(by2-uy*sg*dp+py*wh).toFixed(1)+' '+
                 (bx2+ux*sg*dp).toFixed(1)+','+(by2+uy*sg*dp).toFixed(1)+' '+
                 (bx2-ux*sg*dp-px*wh).toFixed(1)+','+(by2-uy*sg*dp-py*wh).toFixed(1)+'"/>';
        }
      }
      g.innerHTML = out;
      g.setAttribute('opacity', alpha.toFixed(3));
    }

    function placeTag(i, tx, ty, anchor, alpha){
      var t = T[i];
      if(alpha<=0.01){ t.setAttribute('opacity','0'); return; }
      t.setAttribute('x', tx.toFixed(1)); t.setAttribute('y', ty.toFixed(1));
      t.setAttribute('text-anchor', anchor);
      t.setAttribute('opacity', alpha.toFixed(3));
    }

    var lastCap = -1;

    function render(p){
      var grow  = [seg(p,0.012,0.105), seg(p,0.157,0.250), seg(p,0.302,0.395), seg(p,0.447,0.540)];
      var born  = [seg(p,0.004,0.040), seg(p,0.150,0.185), seg(p,0.295,0.330), seg(p,0.440,0.475)];
      var conv  = easeInOut(seg(p,0.592,0.722));   /* swing into the crossing */
      var ringP = easeOut(seg(p,0.752,0.872));     /* draw the circle          */
      var res   = easeInOut(seg(p,0.888,0.978));   /* settle into the mark     */
      var done  = seg(p,0.940,1.000);
      var col   = mix(ringP);

      for(var i=0;i<4;i++){
        var a  = lerp(0, ANG[i], conv) * Math.PI/180;
        var cy = lerp(HY[i], CY, conv);
        var hf = REACH * easeOut(grow[i]);
        var x1 = CX - hf*Math.cos(a), y1 = cy - hf*Math.sin(a);
        var x2 = CX + hf*Math.cos(a), y2 = cy + hf*Math.sin(a);

        L[i].setAttribute('x1',x1.toFixed(2)); L[i].setAttribute('y1',y1.toFixed(2));
        L[i].setAttribute('x2',x2.toFixed(2)); L[i].setAttribute('y2',y2.toFixed(2));
        L[i].setAttribute('stroke', col);
        L[i].setAttribute('stroke-width', BOLD);
        /* translucent while they cross, so the core builds up visibly,
           then solid again as the circle closes */
        var alpha = lerp(lerp(1, 0.58, conv), 1, ringP);
        G[i].setAttribute('opacity', (born[i]*alpha*(1-res)).toFixed(3));

        decorate(i, x1,y1,x2,y2, born[i]*(1-conv));

        /* the name travels from beside the bar to the end of its spoke */
        var rp = pol(CX,CY,TAGA[i],REACH+62), c = Math.cos(TAGA[i]*Math.PI/180);
        placeTag(i,
          lerp(CX-REACH, rp[0], conv),
          lerp(HY[i]-BOLD/2-30, rp[1], conv),
          conv>0.5 ? (c>0.25?'start':(c<-0.25?'end':'middle')) : 'start',
          born[i]*(1-res));
      }

      hub.setAttribute('opacity', (conv*(1-ringP*0.7)*(1-res)).toFixed(3));
      guides.setAttribute('opacity', (conv*0.9*(1-res*0.85)).toFixed(3));

      ring.setAttribute('opacity', ringP>0.001 ? '1' : '0');
      ring.setAttribute('stroke-dashoffset', (RINGC*(1-ringP)).toFixed(1));

      logo.setAttribute('opacity', res.toFixed(3));
      lockup.setAttribute('opacity', done.toFixed(3));

      var idx = p<0.145?0 : p<0.290?1 : p<0.435?2 : p<0.580?3 : p<0.735?4 : 5;
      if(idx!==lastCap){
        for(var c2=0;c2<caps.length;c2++) caps[c2].classList.toggle('on', c2===idx);
        count.textContent = '0'+(idx+1)+' / 06';
        lastCap = idx;
      }
      fill.style.height = (p*100).toFixed(1)+'%';
    }

    var ticking = false;
    function onScroll(){
      if(ticking) return;
      ticking = true;
      requestAnimationFrame(function(){
        var r = scrolly.getBoundingClientRect();
        var total = scrolly.offsetHeight - window.innerHeight;
        render(clamp(-r.top/(total||1), 0, 1));
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, {passive:true});
    window.addEventListener('resize', onScroll);
    render(0);
  }

  /* ── INTERACTIVE WHEEL ────────────────────────────────────────── */
  var toy = $('sf-toy');
  if(toy){
    var toyLogo = $('sf-toylogo'), axes = $('sf-axes');
    var BARS = [$('sf-a0'),$('sf-a1'),$('sf-a2'),$('sf-a3')];
    var spin = $('sf-spin'), degOut = $('sf-deg');
    var rot = 0, vel = RM ? 0 : 0.06, drag = false, lastA = 0, touched = false;

    function paint(){
      spin.setAttribute('transform','rotate('+rot.toFixed(2)+' 300 300)');
      degOut.textContent = (((rot%360)+360)%360).toFixed(0)+'°';
    }
    function frame(){
      if(!drag){
        rot += vel;
        if(touched) vel *= 0.955;
        if(Math.abs(vel)<0.004) vel = 0;
      }
      paint();
      requestAnimationFrame(frame);
    }
    function angleAt(ev){
      var bx = toy.getBoundingClientRect();
      return Math.atan2(ev.clientY-(bx.top+bx.height/2), ev.clientX-(bx.left+bx.width/2))*180/Math.PI;
    }
    toy.addEventListener('pointerdown', function(e){
      drag = true; touched = true; lastA = angleAt(e); vel = 0;
      toy.setPointerCapture(e.pointerId);
    });
    toy.addEventListener('pointermove', function(e){
      if(!drag) return;
      var a = angleAt(e), d = a-lastA;
      if(d>180) d-=360; if(d<-180) d+=360;
      rot += d; vel = d; lastA = a; paint();
      e.preventDefault();
    });
    function release(){ drag = false; }
    toy.addEventListener('pointerup', release);
    toy.addEventListener('pointercancel', release);
    toy.addEventListener('keydown', function(e){
      if(e.key==='ArrowRight'||e.key==='ArrowUp'){ touched=true; rot+=15; vel=0; paint(); e.preventDefault(); }
      if(e.key==='ArrowLeft' ||e.key==='ArrowDown'){ touched=true; rot-=15; vel=0; paint(); e.preventDefault(); }
    });

    /* lay a construction line back over the mark — hover previews, click pins */
    var chips = Array.prototype.slice.call(document.querySelectorAll('.sf-chip'));
    var pinned = -1;
    function apply(n){
      var on = n >= 0;
      toyLogo.setAttribute('fill', on ? 'var(--ghost)' : 'var(--red)');
      axes.setAttribute('opacity', on ? '1' : '0');
      for(var k=0;k<4;k++) BARS[k].setAttribute('opacity', (on && k===n) ? '1' : '0');
    }
    function pin(n){
      pinned = n; apply(n);
      chips.forEach(function(c){ c.setAttribute('aria-pressed', String(+c.dataset.iso === n)); });
    }
    chips.forEach(function(c){
      var n = +c.dataset.iso;
      c.addEventListener('click', function(){ pin(n); });
      c.addEventListener('mouseenter', function(){ apply(n); });
      c.addEventListener('focus', function(){ apply(n); });
      c.addEventListener('blur', function(){ apply(pinned); });
    });
    document.querySelector('.sf-chips').addEventListener('mouseleave', function(){ apply(pinned); });

    apply(-1); paint();
    if(!RM) frame();
  }

  /* ── ACT TWO: the wheel rolls ──────────────────────────────────── */
  var jrs = $('jr-stage');
  if(jrs){
    var JCX = 600, WR = 52, GLOBE = 185, SPAN = 780;
    var FLAT_Y = 470, ARC_Y = 235;
    var OFF0 = 560, LEN = 6300;

    var ground = $('jr-ground'), marks = $('jr-marks'), occ = $('jr-occ');
    var wheelG = $('jr-wheel'), merG = $('jr-mer'), rulerG = $('jr-ruler');
    var oAlt = $('jr-alt'), oRev = $('jr-rev'), oPos = $('jr-pos');
    var stops = Array.prototype.slice.call(document.querySelectorAll('.jr-stops span'));
    var jFill = $('jr-fill'), jCount = $('jr-count'), jRoll = $('sf-roll');
    var jCaps = Array.prototype.slice.call(jRoll.querySelectorAll('.sf-cap'));

    /* split each lede so the copy can arrive in step with the rolling wheel */
    var esc = function(t){ return t.replace(/&/g,'&amp;').replace(/</g,'&lt;'); };
    jCaps.forEach(function(c){
      var l = c.querySelector('.lede'); if(!l) return;
      l.innerHTML = esc(l.textContent.trim()).split(/\s+/)
        .map(function(w){ return '<span class="w">'+w+'</span>'; }).join(' ');
      c.__w = l.querySelectorAll('.w');
      c.__h = c.querySelector('h2');
    });
    var SCN = [[0,0.19],[0.19,0.38],[0.38,0.55],[0.55,0.82],[0.82,1.0]];

    /* deterministic hash so the landscape never reshuffles */
    function h1(i){ var x = Math.sin(i*12.9898 + 78.233) * 43758.5453; return x - Math.floor(x); }

    /* ── build the world: one continuous strip of terrain ─────────── */
    var FEAT = [], PINS = [], FOLK = [], k = 0;

    function ridge(s0,s1){
      var s = s0;
      while(s < s1){
        var w = 120 + h1(k)*130, hh = 52 + h1(k+91)*100;
        FEAT.push({s:s + w/2, w:w, h:hh, peak:1}); s += w*0.62; k++;
      }
    }
    function roofs(s0,s1){
      var s = s0;
      while(s < s1){
        var w = 56 + h1(k)*70, hh = 26 + h1(k+37)*36;
        FEAT.push({s:s + w/2, w:w, h:hh, peak:0}); s += w + 10 + h1(k+7)*26; k++;
      }
    }
    function towers(s0,s1){
      var s = s0;
      while(s < s1){
        var w = 26 + h1(k)*32, hh = 62 + h1(k+53)*105;
        FEAT.push({s:s + w/2, w:w, h:hh, peak:0}); s += w + 12 + h1(k+11)*20; k++;
      }
    }
    function crust(s0,s1){                      /* near-smooth earth, faint texture */
      var s = s0;
      while(s < s1){
        var w = 40 + h1(k)*70, hh = 4 + h1(k+23)*12;
        FEAT.push({s:s + w/2, w:w, h:hh, peak:1}); s += w*0.8; k++;
      }
    }

    ridge(0,1500); roofs(1500,2900); towers(2900,4200); crust(4200,5600); ridge(5600,7700);

    /* city pins around the globe, people back on the home ridge */
    for(var s=4240; s<5580; s+=52 + h1(k++)*46) PINS.push({s:s, h:24 + h1(k)*44});
    for(var s2=6180; s2<7320; s2+=24 + h1(k++)*16) FOLK.push({s:s2, h:13 + h1(k)*5});

    /* bucket the features so height() stays cheap */
    var BUCKET = {}, BW = 300;
    FEAT.forEach(function(f){
      var a = Math.floor((f.s-f.w/2)/BW), b = Math.floor((f.s+f.w/2)/BW);
      for(var i=a;i<=b;i++){ (BUCKET[i] = BUCKET[i] || []).push(f); }
    });
    var HS = 1;                                  /* relief flattens with distance */
    function hAt(sv){ return height(sv)*HS; }
    function height(sv){
      var list = BUCKET[Math.floor(sv/BW)]; if(!list) return 0;
      var m = 0;
      for(var i=0;i<list.length;i++){
        var f = list[i], d = Math.abs(sv - f.s), r = f.w/2;
        if(d > r) continue;
        var hv = f.peak ? f.h*(1 - d/r) : f.h;
        if(hv > m) m = hv;
      }
      return m;
    }

    /* ── map arc-distance + height onto the curved ground ─────────── */
    var Rc = 60000, GYc = FLAT_Y;
    function mapPt(d, h){
      if(Rc > 20000) return [JCX + d, GYc - h];
      var th = d/Rc, rr = Rc + h;
      return [JCX + rr*Math.sin(th), GYc + Rc - rr*Math.cos(th)];
    }

    var WHERE = ['Darjeeling','The plains','The metros','The world','Darjeeling'];
    var ALT   = ['2,042 m','122 m','sea level','40,075 km','2,042 m'];
    var lastJ = -1;

    function drawJourney(p){
      var off = OFF0 + p*LEN;

      /* curvature: flat, curl into a globe, flatten again */
      var c = seg(p,0.50,0.645) - seg(p,0.775,0.905);
      c = clamp(c,0,1); c = c*c*(3-2*c);
      Rc  = 1/(c/GLOBE + (1-c)/60000);
      GYc = lerp(FLAT_Y, ARC_Y, c);
      HS  = 1 - 0.70*c;

      var dmax = Math.min(SPAN, Math.PI*Rc);
      var step = 4.5, d, pt, out = '';
      for(d = -dmax; d <= dmax; d += step){
        pt = mapPt(d, hAt(off + d));
        out += (out ? 'L' : 'M') + pt[0].toFixed(1) + ' ' + pt[1].toFixed(1);
      }
      ground.setAttribute('d', out);

      /* pins + people, drawn only while they are inside the window */
      var pinA = clamp((c-0.30)/0.35, 0, 1), g = '';
      function stem(item, cls, alpha, rad){
        var d0 = item.s - off;
        if(d0 < -dmax || d0 > dmax || alpha <= 0.02) return;
        var base = hAt(item.s), a = mapPt(d0, base), b = mapPt(d0, base + item.h);
        g += '<g class="'+cls+'" opacity="'+alpha.toFixed(2)+'">'
          +  '<line class="jr-stem" x1="'+a[0].toFixed(1)+'" y1="'+a[1].toFixed(1)+
             '" x2="'+b[0].toFixed(1)+'" y2="'+b[1].toFixed(1)+'"/>'
          +  '<circle class="jr-dot" cx="'+b[0].toFixed(1)+'" cy="'+b[1].toFixed(1)+'" r="'+rad+'"/></g>';
      }
      PINS.forEach(function(o){ stem(o,'jr-pin',  pinA, 5); });
      FOLK.forEach(function(o){ stem(o,'jr-red',  1,     4.2); });
      marks.innerHTML = g;

      /* meridians only once it genuinely reads as a sphere */
      var mA = clamp((c-0.55)/0.35, 0, 1);
      merG.setAttribute('opacity', mA.toFixed(2));
      if(mA > 0.02){
        var cy = GYc + Rc;
        merG.innerHTML =
          '<circle class="jr-mer" cx="'+JCX+'" cy="'+cy.toFixed(1)+'" r="'+Rc.toFixed(1)+'"/>'+
          '<ellipse class="jr-mer" cx="'+JCX+'" cy="'+cy.toFixed(1)+'" rx="'+(Rc*0.34).toFixed(1)+'" ry="'+Rc.toFixed(1)+'"/>'+
          '<ellipse class="jr-mer" cx="'+JCX+'" cy="'+cy.toFixed(1)+'" rx="'+(Rc*0.70).toFixed(1)+'" ry="'+Rc.toFixed(1)+'"/>'+
          '<ellipse class="jr-mer" cx="'+JCX+'" cy="'+cy.toFixed(1)+'" rx="'+Rc.toFixed(1)+'" ry="'+(Rc*0.30).toFixed(1)+'"/>';
      } else if(merG.firstChild) merG.textContent = '';

      /* the measuring line from Act one, still running underneath */
      var rA = (1-c)*0.9;
      rulerG.setAttribute('opacity', rA.toFixed(2));
      if(rA > 0.02){
        var ry = GYc + 168, r0 = Math.ceil((off-540)/60)*60, rg = '';
        rg += '<line class="jr-rule" x1="70" y1="'+ry+'" x2="1130" y2="'+ry+'"/>';
        for(var t = r0; t < off+540; t += 60){
          var x = JCX + (t - off);
          if(x < 72 || x > 1128) continue;
          var tall = (Math.round(t/60) % 5 === 0) ? 13 : 6;
          rg += '<line class="jr-rule" x1="'+x.toFixed(1)+'" y1="'+(ry-tall)+'" x2="'+x.toFixed(1)+'" y2="'+ry+'"/>';
        }
        rulerG.innerHTML = rg;
      } else if(rulerG.firstChild) rulerG.textContent = '';

      /* the wheel: rolls, so rotation is distance over radius */
      /* ride on the ground it passes instead of gliding at a fixed height, so
         it bobs over bumps like a real tyre. Contact = the tallest ground within
         a short footprint under the axle; capped + scaled so the ride stays only
         slightly bumpy, and it eases off with the globe curvature because hAt
         already carries the HS relief-flattening. */
      var bump = 0;
      for(var bd = -WR*0.42; bd <= WR*0.42; bd += WR*0.084){
        var bh = hAt(off + bd); if(bh > bump) bump = bh;
      }
      /* scale (not cap) the contact height, so the ride keeps varying even where
         the ground is uniformly tall — a cap there would flatten it back out. */
      bump *= 0.24;
      var wy  = GYc - WR - bump;
      var deg = (off - OFF0)/WR * 180/Math.PI;
      wheelG.setAttribute('transform','translate('+JCX+','+wy.toFixed(1)+') rotate('+deg.toFixed(2)+')');
      occ.setAttribute('cy', wy.toFixed(1));

      /* readout + captions */
      var idx = p<0.19?0 : p<0.38?1 : p<0.55?2 : p<0.82?3 : 4;
      if(idx !== lastJ){
        oAlt.textContent = ALT[idx];
        for(var q=0;q<jCaps.length;q++) jCaps[q].classList.toggle('on', q===idx);
        for(var q2=0;q2<stops.length;q2++) stops[q2].classList.toggle('on', q2===idx);
        jCount.textContent = '0'+(idx+1)+' / 05';
        lastJ = idx;
      }
      oPos.style.left = (p*100).toFixed(2)+'%';

      /* the copy arrives at the pace the wheel turns */
      var cap = jCaps[idx], ws = cap.__w;
      if(ws && ws.length){
        var loc  = clamp((p-SCN[idx][0])/(SCN[idx][1]-SCN[idx][0]), 0, 1);
        var lead = RM ? ws.length+8 : easeOut(clamp(loc/0.55,0,1))*(ws.length+8);
        for(var w=0; w<ws.length; w++){
          var tw = clamp(lead - w, 0, 1);
          ws[w].style.opacity   = (0.08 + 0.92*tw).toFixed(3);
          ws[w].style.transform = tw>0.999 ? 'none' : 'translateY('+((1-tw)*5).toFixed(2)+'px)';
        }
        if(cap.__h) cap.__h.style.transform =
          RM ? 'none' : 'translateX('+((1-easeOut(clamp(loc/0.3,0,1)))*16).toFixed(1)+'px)';
      }
      oRev.textContent = ((off-OFF0)/(2*Math.PI*WR)).toFixed(1) + ' rev';
      jFill.style.height = (p*100).toFixed(1)+'%';
    }

    var jTick = false;
    function onRoll(){
      if(jTick) return;
      jTick = true;
      requestAnimationFrame(function(){
        var r = jRoll.getBoundingClientRect();
        var total = jRoll.offsetHeight - window.innerHeight;
        drawJourney(clamp(-r.top/(total||1), 0, 1));
        jTick = false;
      });
    }
    window.addEventListener('scroll', onRoll, {passive:true});
    window.addEventListener('resize', onRoll);
    drawJourney(0);
  }

  /* the "Build it again" replay control now lives in Manifesto.astro */
})();
</script>
