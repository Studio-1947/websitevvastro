---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatPostDate } from '../../lib/seo';
import html from '../../generated/blog-index/main.html?raw';
import css from '../../generated/blog-index/style.css?raw';

/*
 * The ported index markup pins every card to a placeholder date
 * ("<span>Jun 4</span>"). The cards sit in `order` sequence, so walk the
 * collection sorted by order and swap each placeholder for its post's real
 * date, stamped as a <time> to match the visible date on the post page.
 */
const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order);
let card = 0;
const datedHtml = html.replace(/<span>Jun 4<\/span>/g, () => {
  const date = posts[card++]?.data.date;
  return date ? `<time datetime="${date}">${formatPostDate(date)}</time>`: '<span>Jun 4</span>';
});
---

<BaseLayout
  title={"Stories, Ideas & Perspectives | Studio 1947 Blog"}
  description={"Stories, ideas and perspectives from Studio 1947, on traditional knowledge, design thinking, culture, craft and community from Darjeeling and beyond."}
  ogTitle={"Stories, Ideas & Perspectives | Studio 1947 Blog"}
  ogDescription={"Stories, ideas and perspectives from Studio 1947, on traditional knowledge, design, culture and community."}
  ogType={"website"}
  bodyClass={"page-blog"}
>
  <style slot="head" is:global set:html={css} />
  <Fragment set:html={datedHtml} />
</BaseLayout>
