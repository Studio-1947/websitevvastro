---
import { getCollection } from 'astro:content';
import StructuredLayout from '../../layouts/StructuredLayout.astro';
import { productJsonLd, cleanName, breadcrumbJsonLd } from '../../lib/seo';
// Shared scoped CSS for the ERP/SaaS product pages (byte-identical in source).
// aangan uses the global .pdp-* system and simply ignores these selectors.
import productCss from '../../styles/product.css?raw';

export async function getStaticPaths() {
  // These have their own component-built pages (products/aangan.astro,
  // products/pharma-erp.astro, products/inventory-sales-dashboard.astro).
  const OWN_PAGE = ['aangan', 'pharma-erp', 'inventory-sales-dashboard'];
  const entries = (await getCollection('products')).filter((e) => !OWN_PAGE.includes(e.id));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const url = new URL(`/products/${entry.id}/`, Astro.site).href;
const jsonLd = [productJsonLd({ name: cleanName(d.title), description: d.description, url }),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Products', path: '/products/' },
    { name: cleanName(d.title), path: `/products/${entry.id}/` },
  ]),
];
---

<StructuredLayout data={d} sharedStyles={productCss} jsonLd={jsonLd} />
