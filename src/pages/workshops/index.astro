---
import BaseLayout from '../../layouts/BaseLayout.astro';
import html from '../../generated/workshops/main.html?raw';
import css from '../../generated/workshops/style.css?raw';
---

<BaseLayout
  title={"Community Workshops | Studio 1947"}
  description={"Free community workshops from Studio 1947 on Digital Literacy and Digital Marketing Basics, practical digital skills for local communities."}
  ogTitle={"Community Workshops | Studio 1947"}
  ogDescription={"Free, hands-on workshops on Digital Literacy and Digital Marketing Basics, run with local communities."}
  ogType={"website"}
  bodyClass={"page-workshops"}
  noindex={true}
>
  <style slot="head" is:global set:html={css} />
  <Fragment set:html={html} />
</BaseLayout>

<script>
  /*
   * Workshops explorer: turns the stacked workshop cards into a tab list with
   * one visible panel. Without this script every card simply stays visible.
   */
  const explorer = document.querySelector<HTMLElement>('[data-ws-explorer]');
  if (explorer) {
    const tabList = explorer.querySelector<HTMLElement>('.ws-tabs');
    const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-ws-tab]'));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-ws-panel]'));

    if (tabList && tabs.length && tabs.length === panels.length) {
      tabList.setAttribute('role', 'tablist');
      tabs.forEach((tab, i) => {
        const panel = panels[i];
        tab.id = `ws-tab-${i + 1}`;
        panel.id = `ws-panel-${i + 1}`;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', panel.id);
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tab.id);
        panel.tabIndex = 0;
      });

      const select = (index: number, focus = false): void => {
        tabs.forEach((tab, i) => {
          const on = i === index;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          panels[i].hidden = !on;
          panels[i].classList.toggle('is-entering', on);
        });
        const active = tabs[index];
        if (focus) active.focus();
        // Keep the chosen chip in view on the mobile scroll row.
        if (tabList.scrollWidth > tabList.clientWidth) {
          tabList.scrollTo({ left: active.offsetLeft - tabList.clientWidth / 2 + active.offsetWidth / 2, behavior: 'smooth' });
        }
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (e) => {
          const keys: Record<string, number> = {
            ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1,
          };
          if (!(e.key in keys)) return;
          e.preventDefault();
          select((keys[e.key] + tabs.length) % tabs.length, true);
        });
      });

      explorer.classList.add('is-ready');
      select(0);
    }
  }
</script>
