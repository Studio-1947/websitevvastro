---
import BaseLayout from '../../layouts/BaseLayout.astro';
import html from '../../generated/our-work/main.html?raw';
import css from '../../generated/our-work/style.css?raw';
import { RELEASED_WORK } from '../../lib/portfolioRelease';

// Cards always render as real links; the portfolio release gate
// (src/lib/portfolioRelease.ts + src/scripts/workGate.ts) decides per case,
// at click time, whether a card opens or shows the "Coming soon" popup.
// Not-yet-released cards also get a `work-card--soon` class here so their
// thumbnail reads as inactive (greyed out) at a glance.
const listing = html.replace(
  /<a class="work-card" href="\/work\/([^/"]+)\/">/g,
  (tag, slug) => (RELEASED_WORK.includes(slug) ? tag : tag.replace('class="work-card"', 'class="work-card work-card--soon"')),
);
---

<BaseLayout
  title={"Our Work | Studio 1947"}
  description={"Selected Studio 1947 projects: branding, marketing, web design, research and growth work for organisations across India and beyond."}
  ogTitle={"Our Work | Studio 1947"}
  ogDescription={"A curated showcase of projects brought to life by Studio 1947."}
  ogType={"website"}
>
  <style slot="head" is:global set:html={css} />
  <Fragment set:html={listing} />
</BaseLayout>
