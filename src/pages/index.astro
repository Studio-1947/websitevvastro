---
/**
 * Homepage: decomposed into section components (PRD Principle #5). Markup and
 * section order match the original index.html exactly.
 */
import { Image } from 'astro:assets';
import { clientLogos } from '../assets/clientLogos';

// `.marquee--lg img` runs bigger than the hero strip:
// `max-width: clamp(130px, 13vw, 190px)`. Same rationale as HomeHero: the
// track is JS-duplicated, so each logo is decoded twice on this page too.
const LOGO_SIZES = '(max-width: 1024px) 130px, 190px';
// 480 rather than a tight 400 for the 2x rung: these are high-contrast line-art
// marks where a little supersampling reads noticeably crisper, and a 480w logo
// is ~5KB: cheap enough that exactness isn't worth the softer edges.
const LOGO_WIDTHS = [200, 480, 641];
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import StatsSection from '../components/sections/StatsSection.astro';
import Commitment from '../components/sections/Commitment.astro';
import Approach from '../components/sections/Approach.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import HomeInitiatives from '../components/sections/HomeInitiatives.astro';
import Faq from '../components/sections/Faq.astro';
import { faqJsonLd } from '../lib/seo';

/* Mirrors the six questions rendered by <Faq />. Kept beside the page rather
   than inside the component so the markup stays a verbatim port. */
const faq = faqJsonLd([
  {
    question: 'What we do?',
    answer:
      'We design solutions that create impact. We work where Data, Design, Technology, Communication and Research meet, to make the biggest possible difference for our clients and partners. That runs from evidence and strategy through to brand, product and growth.',
  },
  {
    question: 'Why Darjeeling?',
    answer:
      'Local wisdom for global impact. We chose Darjeeling because creativity thrives where culture, nature and people meet. By building from the hills, we show that top-quality research, design, technology and communication can come from regional India.',
  },
  {
    question: 'Who is the Founder?',
    answer:
      'Rabi (Rabiul Islam) comes from a farming family in rural Bengal. He believes great ideas should not be held back by where you are or what you have. Through Studio 1947, he works where Data and Design meet.',
  },
  {
    question: 'Our Vision',
    answer:
      'Democratise innovation. We want Data, Design and Technology to be within reach, affordable and useful for every organisation: from grassroots communities and small local enterprises to governments, NGOs and global institutions.',
  },
  {
    question: 'How do we get started?',
    answer:
      "Simpler than you think. Tell us your challenge and we'll map out the solution. From the first conversation to a working platform, we guide every step.",
  },
  {
    question: 'Do you work with international clients?',
    answer:
      'Yes. We work with organisations across the US, Europe and beyond, and deliver the same standards from our base in the hills.',
  },
]);
---

<BaseLayout
  title="Data, Design & Tech Consulting | Studio 1947"
  description="Studio 1947 co-creates data, design and technology solutions from Darjeeling, helping organisations worldwide understand, design, build and grow."
  ogTitle="Data, Design & Tech Consulting | Studio 1947"
  ogDescription="Crafting & co-creating solutions from Darjeeling."
  ogType="website"
  image="/assets/img/og-home.jpg"
  imageSize={{ w: 1200, h: 628 }}
  imageAlt="We are Studio 1947: the studio wordmark over Mirik lake in Darjeeling"
  fontHref="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@400;500&family=Google+Sans:wght@400;500;700&family=Google+Sans+Flex:wght@400..700&display=swap"
  jsonLd={[faq]}
>
  <main>
    <HomeHero />
    <StatsSection />
    <Commitment />
    <Approach />

    <!-- ===== Client logos (above testimonials: larger, full colour) ===== -->
    <div class="marquee marquee--lg" aria-label="Trusted by">
      <div class="marquee__track">
        {/* Same marks as the hero strip, rendered larger, `.logo-seal` is
            deliberately not applied here (`.marquee--lg` sizes them all alike). */}
        {clientLogos.map((logo) => (
          <Image src={logo.src} alt="Client logo" loading="lazy" quality={85} sizes={LOGO_SIZES} widths={LOGO_WIDTHS} />
        ))}
      </div>
    </div>

    <Testimonials />
    <HomeInitiatives />
    <Faq />
  </main>
</BaseLayout>
