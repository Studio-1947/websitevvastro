  /* Two-column layout: main content + sticky calculator sidebar */
  .rc-layout { padding-block: clamp(64px, 9vw, 140px); display: grid; grid-template-columns: 1fr 380px; align-items: start; gap: clamp(24px, 3vw, 48px); }
  .rc-layout__main > .section:first-child { padding-top: 0; }
  .rc-layout__main > .section { padding-block: clamp(40px, 5vw, 70px); }
  .rc-layout__aside { position: sticky; top: 140px; }

  @media (max-width: 1100px) {
    .rc-layout { grid-template-columns: 1fr; }
    .rc-layout__aside { position: static; }
  }

  /* Calculator */
  .rc-calc { border: 1px solid var(--red); border-radius: var(--radius-lg); padding: clamp(24px, 2.6vw, 32px); background: var(--red); color: #fff; }
  .rc-calc .rc-h2 { color: #fff; font-size: clamp(20px, 1.8vw, 24px); }
  .rc-calc__totals { margin-top: 20px; display: flex; flex-direction: column; gap: 20px; }
  .rc-calc__col { display: flex; flex-direction: column; gap: 6px; }
  .rc-calc__label { font-size: 12px; color: rgba(255,255,255,.7); text-transform: uppercase; letter-spacing: .04em; }
  .rc-calc__row { display: flex; align-items: baseline; justify-content: space-between; font-size: 14px; color: rgba(255,255,255,.85); }
  .rc-calc__row--grand { margin-top: 4px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,.25); font-family: var(--font-display); font-size: clamp(19px, 1.6vw, 23px); color: #fff; }
  .rc-calc__advance { margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.25); }
  .rc-calc__advance .rc-calc__row { font-weight: 600; font-size: 15px; color: #fff; }
  .rc-calc__interest { margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.25); }
  .rc-calc__interest-list { margin-top: 8px; display: flex; flex-direction: column; gap: 5px; }
  .rc-calc__interest-list li { position: relative; padding-left: 14px; font-size: 13px; line-height: 1.4; color: rgba(255,255,255,.9); }
  .rc-calc__interest-list li::before { content: '●'; position: absolute; left: 0; top: 0; font-size: 8px; color: rgba(255,255,255,.7); }
  .rc-calc__cta-block { margin: 0 calc(-1 * clamp(24px, 2.6vw, 32px)) calc(-1 * clamp(24px, 2.6vw, 32px)); margin-top: 36px; padding: 20px clamp(24px, 2.6vw, 32px) clamp(24px, 2.6vw, 32px); background: #a80000; border-radius: 0 0 var(--radius-lg) var(--radius-lg); }
  .rc-calc__cta-heading { font-size: 14px; font-weight: 600; color: #fff; line-height: 1.4; }
  .rc-calc__actions { margin-top: 14px; display: flex; flex-direction: row; justify-content: flex-start; flex-wrap: wrap; gap: 12px; }
  .rc-calc__book {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border: 1px solid #fff; border-radius: 999px;
    padding: 11px 11px 11px 18px; font-size: 14px; font-weight: 600; color: var(--red); white-space: nowrap;
    background: #fff; text-decoration: none; font-family: inherit; cursor: pointer;
    transition: background .35s var(--ease), border-color .35s var(--ease), color .35s var(--ease);
  }
  .rc-calc__book-arrow {
    width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
    border: 1.5px solid var(--red); color: var(--red); background: transparent;
    display: grid; place-items: center;
    transition: background .35s var(--ease), color .35s var(--ease), border-color .35s var(--ease), transform .35s var(--ease);
  }
  .rc-calc__book-arrow svg { width: 14px; height: 14px; }
  .rc-calc__book:hover { background: transparent; border-color: #fff; color: #fff; }
  .rc-calc__book:hover .rc-calc__book-arrow { background: #fff; border-color: #fff; color: var(--red); transform: translateX(2px); }
  .rc-calc__book--outline { background: transparent; color: #fff; }
  .rc-calc__book--outline .rc-calc__book-arrow { border-color: #fff; color: #fff; }
  .rc-calc__book--outline:hover { background: #fff; color: var(--red); border-color: #fff; }
  .rc-calc__book--outline:hover .rc-calc__book-arrow { background: var(--red); border-color: var(--red); color: #fff; }
  .rc-calc__note { margin-top: 18px; font-size: 13px; color: rgba(255,255,255,.7); }

  /* Interactive selection feedback */
  .rc-card.is-picked, .rc-tier.is-picked { border-color: var(--red); box-shadow: 0 12px 30px rgba(230,0,0,.1); }

  .rc-note-large { max-width: 62ch; color: var(--grey-700); font-size: clamp(15px, 1.05vw, 17px); line-height: 1.6; }

  /* Also Available: full-bleed band, text overlaid on the image */
  .rc-also { position: relative; width: 100%; margin: 0; }
  .rc-also__banner { width: 100%; height: auto; aspect-ratio: 1920 / 960; object-fit: cover; display: block; }
  .rc-also::after {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(0deg, rgba(0,0,0,.92) 0%, rgba(0,0,0,.75) 45%, rgba(0,0,0,.3) 75%, rgba(0,0,0,.05) 100%);
  }
  .rc-also__body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding-bottom: clamp(48px, 6.5vw, 104px); }
  .rc-also__body .rc-eyebrow { color: #fff; font-size: 16px; }
  .rc-also__body .rc-note-large { color: rgba(255,255,255,.95); max-width: 64ch; font-size: clamp(21px, 1.9vw, 30px); line-height: 1.45; }

  /* Below ~700px the overlay text no longer fits inside the image's short
     aspect-ratio height, so switch to a stacked layout: image on top,
     text in a solid block underneath instead of overlaid. */
  @media (max-width: 700px) {
    .rc-also::after { display: none; }
    .rc-also__body {
      position: static; background: var(--grey-900); padding-block: 24px 28px;
    }
  }

  /* Team cards: "Working On This Project" */
  .rc-team-grid { margin-top: clamp(28px, 3.4vw, 44px); display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 1.8vw, 24px); }
  .rc-team-card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg); transition: box-shadow .4s var(--ease), transform .4s var(--ease); }
  .rc-team-card:hover { box-shadow: 0 18px 44px rgba(0,0,0,.08); transform: translateY(-4px); }
  .rc-team-card__img { aspect-ratio: 4 / 5; overflow: hidden; background: var(--bg-alt); }
  .rc-team-card__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .rc-team-card:hover .rc-team-card__img img { transform: scale(1.05); }
  .rc-team-card__body { position: relative; padding: clamp(16px, 1.4vw, 22px); display: flex; flex-direction: column; }
  .rc-team-card__name { font-family: var(--font-display); font-size: clamp(19px, 1.5vw, 24px); color: var(--grey-900); line-height: 1.08; padding-right: 36px; }
  .rc-team-card__role { color: var(--red); font-size: 14px; margin-top: 8px; }
  .rc-team-card__spec { color: var(--grey-500); font-size: 14px; margin-top: 4px; }
  .rc-team-card--cta { align-items: stretch; justify-content: stretch; text-decoration: none; background: #fdf3f3; border-color: var(--red); }
  .rc-team-card--cta:hover { border-color: var(--red); }
  .rc-team-card__cta-body { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: clamp(24px, 2.4vw, 32px); text-align: center; }
  .rc-team-card__cta-icon { width: 52px; height: 52px; border-radius: 50%; border: 1.5px solid var(--red); color: var(--red); display: grid; place-items: center; transition: transform .35s var(--ease); }
  .rc-team-card--cta:hover .rc-team-card__cta-icon { transform: translateY(-3px); }
  .rc-team-card__cta-text { font-family: var(--font-display); font-size: clamp(19px, 1.5vw, 23px); color: var(--grey-900); line-height: 1.25; }
  .rc-team-card__cta-link { font-size: 14px; font-weight: 600; color: var(--red); transition: transform .35s var(--ease); display: inline-block; }
  .rc-team-card--cta:hover .rc-team-card__cta-link { transform: translateX(4px); }
  .rc-team-card .team-card__more {
    position: absolute; top: clamp(13px, 1.2vw, 19px); right: clamp(14px, 1.3vw, 20px);
    width: 26px; height: 26px; border-radius: 50%;
    border: 1.5px solid var(--red); color: var(--red); background: transparent;
    display: grid; place-items: center; flex-shrink: 0;
    transition: background .3s var(--ease), color .3s var(--ease), transform .3s var(--ease);
  }
  .rc-team-card .team-card__more svg { width: 12px; height: 12px; }
  .rc-team-card .team-card__more:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  .rc-team-card.is-clickable { cursor: pointer; }
  .rc-team-card.is-clickable:hover .team-card__more,
  .rc-team-card.is-clickable:focus-within .team-card__more {
    background: var(--red); color: #fff; transform: translateX(2px);
  }

  @media (max-width: 900px) {
    .rc-team-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .rc-team-grid { grid-template-columns: 1fr; }
  }

  /* ---- Person modal (ported from about-us) ---- */
  .person-modal { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: clamp(16px, 4vw, 48px);
    opacity: 0; visibility: hidden; transition: opacity .3s var(--ease), visibility 0s linear .3s; }
  .person-modal.is-open { opacity: 1; visibility: visible; transition: opacity .3s var(--ease); }
  .person-modal__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.5); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
  .person-modal__panel {
    position: relative; z-index: 1; background: #fff; border-radius: var(--radius-lg);
    width: min(720px, 100%); max-height: min(88vh, 820px);
    display: flex; flex-direction: column; overflow: hidden;
    box-shadow: 0 40px 90px rgba(0,0,0,.28);
    transform: translateY(12px) scale(.98); transition: transform .35s var(--ease);
  }
  .person-modal__scroll {
    flex: 1 1 auto; min-height: 0; overflow-y: auto;
    padding: clamp(20px, 2.4vw, 30px) clamp(24px, 3vw, 44px) clamp(24px, 3vw, 40px);
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(0,0,0,.2) transparent;
  }
  .person-modal__panel::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 60px;
    background: linear-gradient(180deg, rgba(255,255,255,0), #fff 78%);
    pointer-events: none; opacity: 0; transition: opacity .25s var(--ease);
  }
  .person-modal__panel.is-scrollable:not(.is-scroll-end)::after { opacity: 1; }
  .person-modal__scroll::-webkit-scrollbar { width: 10px; }
  .person-modal__scroll::-webkit-scrollbar-track { background: transparent; }
  .person-modal__scroll::-webkit-scrollbar-thumb { background-color: rgba(0,0,0,.16); border-radius: 999px; border: 3px solid transparent; background-clip: content-box; }
  .person-modal__scroll:hover::-webkit-scrollbar-thumb { background-color: rgba(0,0,0,.3); background-clip: content-box; }
  .person-modal__head {
    flex: none; display: flex; align-items: center; gap: clamp(18px, 2.2vw, 28px);
    padding: clamp(24px, 3vw, 40px) clamp(24px, 3vw, 44px) clamp(20px, 2.2vw, 28px);
    padding-right: clamp(56px, 6vw, 76px);
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, var(--bg-alt), #fff);
  }
  .person-modal__id { min-width: 0; }
  .person-modal__panel:focus { outline: none; }
  .person-modal.is-open .person-modal__panel { transform: translateY(0) scale(1); }
  .person-modal__close {
    position: absolute; top: clamp(14px, 1.6vw, 20px); right: clamp(14px, 1.6vw, 20px); z-index: 2;
    width: 38px; height: 38px; border-radius: 50%;
    background: rgba(255,255,255,.82); border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    font-size: 24px; line-height: 1; color: var(--grey-700); display: grid; place-items: center;
    transition: background .25s var(--ease), color .25s var(--ease), border-color .25s var(--ease);
  }
  .person-modal__close:hover { background: var(--red); border-color: var(--red); color: #fff; }
  .person-modal__close:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
  .person-modal__media { flex: none; width: clamp(88px, 11vw, 120px); aspect-ratio: 4 / 5; background: var(--bg-alt); display: grid; place-items: center; overflow: hidden; border-radius: 16px; }
  .person-modal__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .person-modal__media :global(.initial) { font-family: var(--font-display); font-size: clamp(34px, 4vw, 48px); color: var(--red); line-height: 1; }
  .person-modal__body { padding: 0; }

  .person-modal :global(.pm-audio) { margin-top: 14px; }
  .person-modal :global(.pm-audio[hidden]) { display: none; }
  .person-modal :global(.pm-audio__toggle) {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 7px 16px 7px 7px; border-radius: 999px;
    border: 1px solid var(--line); background: #fff;
    color: var(--grey-900); font-size: 13.5px; line-height: 1;
    transition: border-color .25s var(--ease), box-shadow .25s var(--ease);
  }
  .person-modal :global(.pm-audio__toggle:hover) { border-color: var(--red); box-shadow: 0 6px 18px rgba(0,0,0,.08); }
  .person-modal :global(.pm-audio__toggle:focus-visible) { outline: 2px solid var(--red); outline-offset: 2px; }
  .person-modal :global(.pm-audio__icon) { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--red); position: relative; }
  .person-modal :global(.pm-audio__icon::before), .person-modal :global(.pm-audio__icon::after) { content: ""; position: absolute; top: 50%; left: 50%; }
  .person-modal :global(.pm-audio__icon::before) { transform: translate(-35%, -50%); border-style: solid; border-width: 5px 0 5px 8px; border-color: transparent transparent transparent #fff; }
  .person-modal :global(.pm-audio__icon::after) { display: none; }
  .person-modal :global(.pm-audio__toggle.is-playing .pm-audio__icon::before),
  .person-modal :global(.pm-audio__toggle.is-playing .pm-audio__icon::after) { display: block; border: none; box-shadow: none; width: 3px; height: 10px; border-radius: 1px; background: #fff; }
  .person-modal :global(.pm-audio__toggle.is-playing .pm-audio__icon::before) { transform: translate(-4px, -50%); }
  .person-modal :global(.pm-audio__toggle.is-playing .pm-audio__icon::after) { transform: translate(1px, -50%); }
  .person-modal :global(.pm-audio__note) { margin: 0 0 clamp(16px, 1.8vw, 22px); color: var(--grey-700); font-size: 13.5px; line-height: 1.6; font-style: italic; padding: 12px 16px; border-radius: 12px; background: var(--bg-alt); }
  .person-modal :global(.pm-audio__note[hidden]) { display: none; }

  .person-modal :global(.pm-bio .team-bio__lead) { font-family: var(--font-display); color: var(--grey-900); font-size: clamp(18px, 1.7vw, 24px); line-height: 1.25; padding-left: 16px; border-left: 3px solid var(--red); margin-bottom: clamp(20px, 2.4vw, 28px); display: block; }
  .person-modal :global(.pm-bio p) { color: var(--grey-700); font-size: clamp(14.5px, 1.05vw, 16.5px); line-height: 1.72; margin-bottom: 16px; }
  .person-modal :global(.pm-bio p:last-child) { margin-bottom: 0; }
  .person-modal :global(.pm-bio em) { font-style: italic; color: var(--grey-900); }
  .person-modal :global(.pm-bio a) { color: var(--red); text-decoration: underline; text-underline-offset: 3px; font-weight: 500; transition: color .2s var(--ease); }
  .person-modal :global(.pm-bio a:hover) { color: var(--grey-900); }

  .person-modal__name { font-family: var(--font-display); font-size: clamp(24px, 2.4vw, 34px); color: var(--grey-900); line-height: 1.08; }
  .person-modal__role { color: var(--red); font-size: 15px; margin-top: 6px; }
  .person-modal :global(.pm-block) { margin-top: clamp(20px, 2.2vw, 30px); }
  .person-modal :global(.pm-block:first-child) { margin-top: 0; }
  .person-modal :global(.pm-block h4) { font-family: var(--font-body); font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--grey-500); margin-bottom: 8px; }
  .person-modal :global(.pm-block p) { color: var(--grey-700); font-size: clamp(15px, 1.05vw, 17px); }
  .person-modal :global(.pm-tags) { display: flex; flex-wrap: wrap; gap: 8px; }
  .person-modal :global(.pm-tags span) { border: 1px solid var(--line); border-radius: 999px; padding: 7px 14px; font-size: 14px; color: var(--grey-900); }
  .person-modal :global(.pm-projects ul) { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .person-modal :global(.pm-projects a) {
    display: inline-flex; align-items: center;
    border: 1px solid var(--line); border-radius: 999px;
    padding: 7px 14px; font-size: 14px; line-height: 1.4; color: var(--grey-900);
    text-decoration: none;
    transition: border-color .25s var(--ease), color .25s var(--ease);
  }
  .person-modal :global(.pm-projects a:hover) { border-color: var(--red); color: var(--red); }
  .person-modal :global(.pm-projects a:focus-visible) { outline: 2px solid var(--red); outline-offset: 2px; }
  @media (max-width: 480px) {
    .person-modal__head { gap: 14px; align-items: flex-start; }
    .person-modal__media { width: 84px; }
    .person-modal { padding: 12px; }
    .person-modal__panel { max-height: 92vh; }
  }

  /* Why This Rate Card Exists: full-bleed band, three cards */
  .rc-intro { position: relative; z-index: 2; margin-top: clamp(-220px, -19vw, -170px); padding-bottom: clamp(16px, 2vw, 28px); }
  .rc-clients-marquee { padding-block: clamp(10px, 1.4vw, 16px); max-width: 560px; margin-left: auto; margin-right: var(--gutter); }
  @media (max-width: 700px) { .rc-clients-marquee { max-width: 100%; margin-right: 0; } }
  .rc-why__top { display: flex; align-items: center; justify-content: space-between; gap: clamp(20px, 3vw, 40px); }
  .rc-why__headtext { flex: 0 0 auto; }
  .rc-clients-marquee--why {
    flex: 1 1 auto; min-width: 0; max-width: none; margin: 0;
    margin-right: calc(-1 * max(var(--gutter), (100vw - var(--container)) / 2));
  }
  @media (max-width: 900px) {
    .rc-why__top { flex-direction: column; align-items: flex-start; }
    .rc-clients-marquee--why { width: 100%; margin-right: calc(-1 * max(var(--gutter), (100vw - var(--container)) / 2)); }
  }
  .rc-clients-marquee--full { max-width: none; margin-left: 0; margin-right: 0; width: 100%; }
  .rc-clients-marquee__name { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: .02em; font-size: clamp(20px, 2vw, 28px); color: var(--grey-300); white-space: nowrap; }
  .rc-why { position: relative; width: 100%; padding: clamp(32px, 4vw, 56px) 0 clamp(48px, 6vw, 90px); background: #fff; }
  .rc-why__heading {
    position: relative; z-index: 2; display: inline-block; max-width: calc(100% - 8px);
    margin-top: clamp(12px, 1.6vw, 20px); margin-bottom: clamp(44px, 5vw, 64px);
    background: #fff; padding: clamp(21px, 2.6vw, 31px) clamp(26px, 3.1vw, 36px);
    border: 2px solid var(--red); border-radius: 20px;
    transform: scale(1.15); transform-origin: left top;
  }
  @media (max-width: 700px) {
    .rc-why__heading { transform: scale(1.02); }
  }
  .rc-why__grid { margin-top: clamp(28px, 3.4vw, 44px); display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(18px, 2vw, 28px); }
  .rc-why__card {
    position: relative; display: flex; flex-direction: column; background: #fdf3f3; border: 1px solid var(--line);
    border-radius: var(--radius-lg); padding: clamp(24px, 2.2vw, 32px);
    transition: box-shadow .35s var(--ease), transform .35s var(--ease), border-color .35s var(--ease);
  }
  .rc-why__card:hover { box-shadow: 0 20px 44px rgba(0,0,0,.08); transform: translateY(-4px); border-color: #eecccc; }
  .rc-why__icon {
    flex-shrink: 0; width: 56px; height: 56px; border-radius: 50%;
    background: #fff; border: 1px solid var(--line); color: var(--red);
    display: grid; place-items: center; margin-bottom: clamp(16px, 1.8vw, 22px);
  }
  .rc-why__card-body { min-width: 0; display: flex; flex-direction: column; flex: 1; }
  .rc-why__card h3 { font-family: var(--font-display); font-weight: 500; font-size: clamp(19px, 1.5vw, 22px); color: var(--grey-900); }
  .rc-why__card p { margin-top: 12px; margin-bottom: 24px; font-size: 15px; line-height: 1.6; color: var(--grey-700); }
  .rc-why__cta {
    margin-top: 22px; display: inline-flex; align-items: center; gap: 10px;
    border: 1px solid var(--grey-300); border-radius: 999px;
    padding: 12px 10px 12px 20px; font-size: 13.5px; font-weight: 600; color: var(--grey-900);
    background: #fff; text-decoration: none;
    transition: background .35s var(--ease), border-color .35s var(--ease), color .35s var(--ease);
  }
  .rc-why__cta-arrow {
    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    border: 1.5px solid var(--red); color: var(--red); background: transparent;
    display: grid; place-items: center;
    transition: background .35s var(--ease), color .35s var(--ease), border-color .35s var(--ease), transform .35s var(--ease);
  }
  .rc-why__cta:hover { background: var(--red); border-color: var(--red); color: #fff; }
  .rc-why__cta:hover .rc-why__cta-arrow { background: #fff; border-color: #fff; color: var(--red); transform: translateX(2px); }
  .rc-why__card p a { color: var(--red); text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 900px) {
    .rc-why__grid { grid-template-columns: 1fr; }
