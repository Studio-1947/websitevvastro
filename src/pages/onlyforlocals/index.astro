<script>
  function initCalc(): void {
    const onetimeSubEl = document.querySelector<HTMLElement>('[data-calc-onetime-sub]');
    const onetimeGstEl = document.querySelector<HTMLElement>('[data-calc-onetime-gst]');
    const onetimeTotalEl = document.querySelector<HTMLElement>('[data-calc-onetime-total]');
    const monthlySubEl = document.querySelector<HTMLElement>('[data-calc-monthly-sub]');
    const monthlyGstEl = document.querySelector<HTMLElement>('[data-calc-monthly-gst]');
    const monthlyTotalEl = document.querySelector<HTMLElement>('[data-calc-monthly-total]');
    if (!onetimeSubEl || !onetimeGstEl || !onetimeTotalEl || !monthlySubEl || !monthlyGstEl || !monthlyTotalEl) return;
    const fmt = (n: number) => `₹${Math.round(n).toLocaleString('en-IN')}`;
    const GST_RATE = 0.18;

    function recompute(): void {
      let oneTime = 0;
      let monthly = 0;
      document.querySelectorAll<HTMLInputElement>('[data-calc-item]').forEach((input) => {
        const raw = input.dataset.calcItem ?? input.value;
        if (!input.checked) return;
        if (raw.startsWith('monthly:')) {
          monthly += Number(raw.split(':')[1]) || 0;
        } else {
          oneTime += Number(raw) || 0;
        }
      });
      onetimeSubEl!.textContent = fmt(oneTime);
      onetimeGstEl!.textContent = fmt(oneTime * GST_RATE);
      onetimeTotalEl!.textContent = fmt(oneTime * (1 + GST_RATE));
      monthlySubEl!.textContent = fmt(monthly);
      monthlyGstEl!.textContent = fmt(monthly * GST_RATE);
      monthlyTotalEl!.textContent = fmt(monthly * (1 + GST_RATE));
    }

    function syncPicked(): void {
      document.querySelectorAll<HTMLInputElement>('[data-calc-item]').forEach((input) => {
        const card = input.closest<HTMLElement>('.rc-card, .rc-tier');
        if (card) card.classList.toggle('is-picked', input.checked);
      });
    }

    function syncOptionPrices(): void {
      document.querySelectorAll<HTMLElement>('.rc-card').forEach((card) => {
        const checked = card.querySelector<HTMLInputElement>('.rc-card__toggle input:checked');
        if (!checked) return;
        const val = Number(checked.value) || 0;
        const priceEl = card.querySelector<HTMLElement>('.rc-card__price');
        const gstEl = card.querySelector<HTMLElement>('.rc-card__gst');
        if (priceEl) priceEl.textContent = fmt(val);
        if (gstEl) gstEl.textContent = `+ ${fmt(val * GST_RATE)} GST (18%)`;
        const addInput = card.querySelector<HTMLInputElement>('.rc-card__add input');
        if (addInput) {
          addInput.value = String(val);
          addInput.dataset.calcItem = String(val);
        }
        const provideEl = card.querySelector<HTMLElement>('[data-calc-provide]');
        if (provideEl && checked.dataset.desc) provideEl.textContent = checked.dataset.desc;
      });
    }

    document.querySelectorAll<HTMLInputElement>('[data-calc-item]').forEach((input) => {
      input.addEventListener('change', () => {
        syncPicked();
        syncOptionPrices();
        recompute();
      });
    });
    document.querySelectorAll<HTMLInputElement>('.rc-card__toggle input').forEach((input) => {
      input.addEventListener('change', () => {
        syncOptionPrices();
        recompute();
      });
    });

    function syncInterest(): void {
      const wrap = document.querySelector<HTMLElement>('[data-calc-interest-wrap]');
      const list = document.querySelector<HTMLElement>('[data-calc-interest-list]');
      if (!wrap || !list) return;
      const items = Array.from(document.querySelectorAll<HTMLInputElement>('[data-calc-interest]'))
        .filter((i) => i.checked)
        .map((i) => i.dataset.calcInterest ?? '');
      list.innerHTML = '';
      items.forEach((name) => {
        const li = document.createElement('li');
        li.textContent = name;
        list.appendChild(li);
      });
      wrap.hidden = items.length === 0;
    }

    document.querySelectorAll<HTMLInputElement>('[data-calc-interest]').forEach((input) => {
      input.addEventListener('change', syncInterest);
    });

    const STUDIO_WHATSAPP_NUMBER = '919093277919';

    function buildWhatsAppMessage(): string {
      const lines: string[] = [];
      lines.push('Hi Studio 1947, here is my requirement from the rate card:');
      lines.push('');

      const oneTimeItems: { title: string; price: string }[] = [];
      document.querySelectorAll<HTMLElement>('.rc-card').forEach((card) => {
        const input = card.querySelector<HTMLInputElement>('.rc-card__add input');
        if (!input?.checked) return;
        oneTimeItems.push({
          title: card.querySelector('.rc-card__head h3')?.textContent?.trim() ?? '',
          price: card.querySelector('.rc-card__price')?.textContent?.trim() ?? '',
        });
      });
      if (oneTimeItems.length) {
        lines.push('*One-time services*');
        oneTimeItems.forEach((it) => lines.push(`- ${it.title}: ${it.price}`));
        lines.push('');
      }

      let monthlyPlan: { title: string; price: string } | null = null;
      document.querySelectorAll<HTMLElement>('.rc-tier').forEach((tier) => {
        const input = tier.querySelector<HTMLInputElement>('.rc-tier__cta input');
        if (!input?.checked) return;
        monthlyPlan = {
          title: tier.querySelector('.rc-tier__name')?.textContent?.trim() ?? '',
          price: tier.querySelector('.rc-tier__price')?.textContent?.trim() ?? '',
        };
      });
      if (monthlyPlan) {
        const mp = monthlyPlan as { title: string; price: string };
        lines.push('*Monthly plan*');
        lines.push(`- ${mp.title}: ${mp.price}`);
        lines.push('');
      }

      const interestItems = Array.from(document.querySelectorAll<HTMLInputElement>('[data-calc-interest]'))
        .filter((i) => i.checked)
        .map((i) => i.dataset.calcInterest ?? '');
      if (interestItems.length) {
        lines.push('*Also interested in*');
        interestItems.forEach((t) => lines.push(`- ${t}`));
        lines.push('');
      }

      lines.push('*Totals*');
      lines.push(`One-time: ${onetimeTotalEl!.textContent} (incl. GST ${onetimeGstEl!.textContent})`);
      lines.push(`Monthly: ${monthlyTotalEl!.textContent} (incl. GST ${monthlyGstEl!.textContent})`);

      return lines.join('\n');
    }

    function sendToWhatsApp(): void {
      const text = buildWhatsAppMessage();
      const url = `https://wa.me/${STUDIO_WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;
      window.open(url, '_blank', 'noopener');
    }

    document.querySelector<HTMLButtonElement>('[data-calc-whatsapp]')?.addEventListener('click', sendToWhatsApp);

    document.querySelectorAll<HTMLButtonElement>('[data-calc-remove-tier]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const input = btn.parentElement?.querySelector<HTMLInputElement>('.rc-tier__cta input');
        if (!input) return;
        input.checked = false;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });

    syncPicked();
    syncOptionPrices();
    syncInterest();
    recompute();
  }

  initCalc();

  function initTestiVideos(): void {
    const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-testi-video]'));
    const onScreen = new Set<HTMLVideoElement>();
    const box = document.querySelector<HTMLElement>('[data-testi-lightbox]');
    const boxVideo = document.querySelector<HTMLVideoElement>('[data-testi-lightbox-video]');
    const boxLabel = document.querySelector<HTMLElement>('[data-testi-lightbox-label]');

    // Grid previews are silent ambient loops, and only run while actually visible.
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            onScreen.add(video);
            if (!box || box.hidden) void video.play().catch(() => {});
          } else {
            onScreen.delete(video);
            video.pause();
          }
        });
      },
      { threshold: 0.25 },
    );
    videos.forEach((video) => io.observe(video));

    if (!box || !boxVideo) return;

    let lastTrigger: HTMLElement | null = null;

    function openBox(trigger: HTMLElement): void {
      const src = trigger.dataset.videoSrc;
      if (!src || !box || !boxVideo) return;
      lastTrigger = trigger;
      videos.forEach((video) => video.pause());
      boxVideo.src = src;
      boxVideo.muted = false;
      if (boxLabel) boxLabel.textContent = trigger.dataset.videoLabel ?? '';
      box.hidden = false;
      document.body.style.overflow = 'hidden';
      void boxVideo.play().catch(() => {});
      box.querySelector<HTMLButtonElement>('.rc-lightbox__close')?.focus();
    }

    function closeBox(): void {
      if (!box || !boxVideo || box.hidden) return;
      boxVideo.pause();
      boxVideo.removeAttribute('src');
      boxVideo.load();
      box.hidden = true;
      document.body.style.overflow = '';
      lastTrigger?.focus();
      lastTrigger = null;
      onScreen.forEach((video) => void video.play().catch(() => {}));
    }

    document.querySelectorAll<HTMLElement>('[data-testi-open]').forEach((trigger) => {
      trigger.addEventListener('click', () => openBox(trigger));
    });
    box.querySelectorAll<HTMLElement>('[data-testi-close]').forEach((btn) => {
      btn.addEventListener('click', closeBox);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeBox();
    });
  }

  initTestiVideos();
</script>

