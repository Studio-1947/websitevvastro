---
/**
 * BaseLayout: the shell every page uses. Renders <head> (SEO), the shared
 * Header, the page's <main> (via <slot/>), the Footer, the ContactModal, and
 * the single bundled client entry. Matches the original page skeleton exactly,
 * componentized.
 */
import '../styles/global.css';
import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import type { SeoProps } from '../lib/seo';

interface Props extends SeoProps {
  /** Optional body class hook (e.g. "page-post", "page-case", "page-legal"). */
  bodyClass?: string;
  /** Exact Google Fonts href for this page (defaults to the 54-page common set). */
  fontHref?: string;
}

import { RELEASED_WORK } from '../lib/portfolioRelease';
import { RELEASED_PRODUCTS } from '../lib/productRelease';
import { RELEASED_INITIATIVES } from '../lib/initiativesRelease';
const { bodyClass, ...seo } = Astro.props;  // seo includes noindex
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Mark JS active so entrance animations apply; if this never runs, content stays visible. -->
    <script is:inline>document.documentElement.className += ' js';</script>
    {/* Google Tag Manager (GTM-MFBGSM2B), on every page. is:inline keeps it
        exactly as Google gives it instead of bundling it. */}
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-MFBGSM2B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    {/* A saved non-English language: hide translatable text until the
        dictionary has swapped it in, so the page never flashes English first.
        The i18n module clears the flag; a timeout clears it regardless. */}
    <script is:inline>
      (function () {
        try {
          var l = localStorage.getItem('site-language');
          if (l && l !== 'en') {
            document.documentElement.setAttribute('data-lang-pending', l);
            document.documentElement.lang = l;
            setTimeout(function () { document.documentElement.removeAttribute('data-lang-pending'); }, 2000);
          }
        } catch (e) {}
      })();
    </script>
    <BaseHead {...seo}>
      <slot name="head" />
    </BaseHead>
  </head>
  <body class={bodyClass} data-work-released={RELEASED_WORK.join(',')} data-products-released={RELEASED_PRODUCTS.join(',')} data-initiatives-released={RELEASED_INITIATIVES.join(',')}>
    {/* Skip link: first thing in the tab order, so keyboard and screen-reader
        users can jump the nav. Pages render their own <main> through the slot,
        so the target is this zero-size anchor rather than an id we cannot reach
        from here. */}
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />

    <span id="main-content" tabindex="-1"></span>
    <slot />

    <Footer />
    <ContactModal />

    <script>
      import '../scripts/main.ts';
    </script>

    {/* Vercel Web Analytics: cookieless and privacy-preserving, so it keeps the
        site's "no cookie banner needed" position. No-ops in local dev. */}
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </body>
</html>
