---
/**
 * BaseLayout — the shell every page uses. Renders <head> (SEO), the shared
 * Header, the page's <main> (via <slot/>), the Footer, the ContactModal, and
 * the single bundled client entry. Matches the original page skeleton exactly,
 * componentized.
 */
import '../styles/global.css';
import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import type { SeoProps } from '../lib/seo';

interface Props extends SeoProps {
  /** Optional body class hook (e.g. "page-post", "page-case", "page-legal"). */
  bodyClass?: string;
  /** Exact Google Fonts href for this page (defaults to the 54-page common set). */
  fontHref?: string;
}

const { bodyClass, ...seo } = Astro.props;  // seo includes noindex
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Mark JS active so entrance animations apply; if this never runs, content stays visible. -->
    <script is:inline>document.documentElement.className += ' js';</script>
    <BaseHead {...seo}>
      <slot name="head" />
    </BaseHead>
  </head>
  <body class={bodyClass}>
    <Header />

    <slot />

    <Footer />
    <ContactModal />

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
