---
/**
 * Layout for modular case studies (entries carrying `sections` rather than raw
 * `html`). Assembles hero → sections → credits → CTA and sets the per-brand
 * accent as --brand on the page root, which every case primitive derives from.
 */
import BaseLayout from './BaseLayout.astro';
import '../styles/work-case.css';
import CaseHero from '../components/work/CaseHero.astro';
import CaseSection from '../components/work/CaseSection.astro';
import Credits from '../components/work/Credits.astro';
import MoreWork from '../components/work/MoreWork.astro';

interface Props {
  data: {
    title: string;
    description?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogType?: 'website' | 'article' | 'product';
    brand?: string;
    client?: string;
    location?: string;
    year?: string;
    tags?: string[];
    hero?: {
      src: string;
      alt: string;
      style?: 'photo' | 'logo';
      poster?: string;
      scrim?: string;
      scrimOpacity?: number;
      background?: 'brand' | 'light';
    };
    sections?: any[];
    credits?: { role: string; members: string }[];
    creditsLayout?: 'grid' | 'stack';
    creditLinkStyle?: 'underline' | 'arrow';
    coordinator?: { name: string; role?: string };
    /** false = retired from the portfolio: no index, no sitemap entry. */
    active?: boolean;
    /** Public URL of the shipped product; renders the "View Live Project" button. */
    liveUrl?: string;
    /** The <h1>, when it should differ from the client name. */
    headline?: string;
    /** 'contained' keeps stacked media inside the text shell; 'full' bleeds it. */
    mediaStyle?: 'full' | 'contained';
  };
  jsonLd?: Record<string, unknown>[];
  /** Slug of this case, so the closing rail can leave it out of itself. */
  slug?: string;
}
const { data, jsonLd = [], slug } = Astro.props;
const { brand, hero, sections = [], credits = [], creditsLayout = 'grid', creditLinkStyle = 'underline', client, tags = [], title, location, year, coordinator, active = true, mediaStyle = 'full', liveUrl, headline: headlineOverride } = data;

// Hero headline: the <h1> text, independent of the SEO <title>.
const headline = headlineOverride ?? client ?? title;

/* ── Contrast-safe brand derivations ────────────────────────────────
   Brand colors are per-client and some are too light for white text or white
   surfaces (amber #FBBF24, lime #94c11f, bright green #00E357…), while a few
   mid-tone reds (#E52F1D) defeat both white and near-black ink on their own
   fill. Three derived vars are set on the page root and every case primitive
   uses them with the raw brand as fallback:
     --brand-ink: whichever of white / near-black reads better on the brand.
     --brand-fill: the brand (or a hair-darkened version) that lets
                    --brand-ink clear 4.5:1 on it: hero + CTA fills.
     --brand-text: the brand darkened just enough to clear 4.6:1 on the
                    lightest surface brand text sits on (the label tint).
*/
function relLum(hex: string): number {
  const v = (i: number) => {
    const c = parseInt(hex.slice(1 + i * 2, 3 + i * 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92: ((c + 0.055) / 1.055) ** 2.4;
  };
  return 0.2126 * v(0) + 0.7152 * v(1) + 0.0722 * v(2);
}
const contrast = (a: number, b: number) => (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
const INK = '#10240f';
const mixBrand = (t: number) =>
  '#' + [0, 1, 2].map((i) => Math.round(parseInt(brand!.slice(1 + i * 2, 3 + i * 2), 16) * t).toString(16).padStart(2, '0')).join('');

/* Darken the brand preserving its hue and saturation. Scaling RGB channels
   (mixBrand) drags light brands toward mud: amber #FBBF24 becomes olive
   #8c6a14 because saturation collapses as channels converge. Dropping only
   lightness keeps e.g. amber amber. */
function brandHsl(hex: string): [number, number, number] {
  const r = parseInt(hex.slice(1, 3), 16) / 255;
  const g = parseInt(hex.slice(3, 5), 16) / 255;
  const b = parseInt(hex.slice(5, 7), 16) / 255;
  const max = Math.max(r, g, b), min = Math.min(r, g, b);
  const l = (max + min) / 2;
  if (max === min) return [0, 0, l];
  const d = max - min;
  const s = l > 0.5 ? d / (2 - max - min): d / (max + min);
  let h = 0;
  if (max === r) h = (g - b) / d + (g < b ? 6: 0);
  else if (max === g) h = (b - r) / d + 2;
  else h = (r - g) / d + 4;
  return [(h * 60) % 360, s, l];
}
function hslToHex(h: number, s: number, l: number): string {
  const c = (1 - Math.abs(2 * l - 1)) * s;
  const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
  const m = l - c / 2;
  const [r, g, b] =
    h < 60 ? [c, x, 0]: h < 120 ? [x, c, 0]: h < 180 ? [0, c, x]: h < 240 ? [0, x, c]: h < 300 ? [x, 0, c]: [c, 0, x];
  return '#' + [r, g, b].map((v) => Math.round((v + m) * 255).toString(16).padStart(2, '0')).join('');
}

const brandL = brand ? relLum(brand): 0;
let brandInk = '#ffffff';
if (brand) brandInk = contrast(1, brandL) >= contrast(relLum(INK), brandL) ? '#ffffff': INK;

let brandFill = brand ?? '#e60000';
if (brand && contrast(relLum(brandInk), brandL) < 4.5) {
  // Largest mix ratio whose fill still lets --brand-ink clear 4.5:1.
  let lo = 0, hi = 1;
  for (let i = 0; i < 24; i++) {
    const mid = (lo + hi) / 2;
    if (contrast(relLum(brandInk), relLum(mixBrand(mid))) >= 4.5) lo = mid; else hi = mid;
  }
  brandFill = mixBrand(lo);
}

let brandText = brand ?? '#e60000';
if (brand) {
  // The label pill's own surface: brand 8% + white. Brand text must clear
  // 4.6:1 on it (the tightest surface brand text sits on).
  const tintHex =
    '#' + [0, 1, 2].map((i) => {
        const c = Math.round(parseInt(brand.slice(1 + i * 2, 3 + i * 2), 16) * 0.08 + 255 * 0.92);
        return c.toString(16).padStart(2, '0');
      }).join('');
  // Brand text also sits on --bg-alt (#f5f5f5): whichever of that and the
  // tint is darker is the binding surface.
  const worstL = Math.min(relLum('#f5f5f5'), relLum(tintHex));
  const need = (worstL + 0.05) / 4.6 - 0.05;
  if (brandL > need) {
    // Find the highest lightness that still clears 4.6:1: the closest the
    // text can stay to the brand while remaining readable. Hue + saturation
    // are untouched, so the darkening reads as "the brand, darker" rather
    // than a different colour.
    const [h, s] = brandHsl(brand);
    let lo = 0, hi = 1;
    for (let i = 0; i < 24; i++) {
      const mid = (lo + hi) / 2;
      if (relLum(hslToHex(h, s, mid)) <= need) lo = mid; else hi = mid;
    }
    brandText = hslToHex(h, s, lo);
  }
}
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogTitle={data.ogTitle}
  ogDescription={data.ogDescription}
  ogType={data.ogType ?? 'article'}
  noindex={active === false}
  bodyClass="page-case-modular"
  jsonLd={jsonLd}
>
  {/* The footer sits below <main>, so the per-case wash has to reach the body
      too or a grey band shows between the CTA and the footer. */}
  {brand && (
    <style
      is:inline
      set:html={`body.page-case-modular{background:color-mix(in srgb, ${brand} 5%, var(--bg-alt));}`}
    />
  )}

  <main
    class:list={['case-page', mediaStyle === 'contained' && 'case-page--contained']}
    style={brand ? `--brand: ${brand}; --brand-ink: ${brandInk}; --brand-fill: ${brandFill}; --brand-text: ${brandText};`: undefined}
  >
    {
      hero && (
        <CaseHero
          src={hero.src}
          alt={hero.alt}
          title={headline}
          tags={tags}
          style={hero.style}
          poster={hero.poster}
          scrim={hero.scrim}
          scrimOpacity={hero.scrimOpacity}
          background={hero.background}
          location={location}
          year={year}
          liveUrl={liveUrl}
        />
      )
    }

    <div class="case-body">
      {sections.map((s, i) => <CaseSection {...s} first={i === 0} i18nKey={slug ? `work.${slug}.s${i}` : undefined} />)}
      {client && (
        <Credits
          client={client}
          coordinator={coordinator}
          roles={credits}
          layout={creditsLayout}
          linkStyle={creditLinkStyle}
          location={location}
          year={year}
          slug={slug}
        />
      )}

      <MoreWork current={slug} />
    </div>
  </main>
</BaseLayout>
