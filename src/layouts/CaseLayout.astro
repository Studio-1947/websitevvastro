---
/**
 * Layout for modular case studies (entries carrying `sections` rather than raw
 * `html`). Assembles hero → sections → credits → CTA and sets the per-brand
 * accent as --brand on the page root, which every case primitive derives from.
 */
import BaseLayout from './BaseLayout.astro';
import '../styles/work-case.css';
import CaseHero from '../components/work/CaseHero.astro';
import CaseSection from '../components/work/CaseSection.astro';
import Credits from '../components/work/Credits.astro';
import PortfolioCTA from '../components/work/PortfolioCTA.astro';

interface Props {
  data: {
    title: string;
    description?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogType?: 'website' | 'article' | 'product';
    brand?: string;
    client?: string;
    location?: string;
    year?: string;
    tags?: string[];
    hero?: { src: string; alt: string; style?: 'photo' | 'logo' };
    sections?: any[];
    credits?: { role: string; members: string }[];
  };
  jsonLd?: Record<string, unknown>[];
}
const { data, jsonLd = [] } = Astro.props;
const { brand, hero, sections = [], credits = [], client, tags = [], title, location, year } = data;

// Hero headline: the <h1> text, independent of the SEO <title>.
const headline = client ?? title;

/* ── Contrast-safe brand derivations ────────────────────────────────
   Brand colors are per-client and some are too light for white text or white
   surfaces (amber #FBBF24, lime #94c11f, bright green #00E357…), while a few
   mid-tone reds (#E52F1D) defeat both white and near-black ink on their own
   fill. Three derived vars are set on the page root and every case primitive
   uses them with the raw brand as fallback:
     --brand-ink  — whichever of white / near-black reads better on the brand.
     --brand-fill — the brand (or a hair-darkened version) that lets
                    --brand-ink clear 4.5:1 on it — hero + CTA fills.
     --brand-text — the brand darkened just enough to clear 4.6:1 on the
                    lightest surface brand text sits on (the label tint).
*/
function relLum(hex: string): number {
  const v = (i: number) => {
    const c = parseInt(hex.slice(1 + i * 2, 3 + i * 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  };
  return 0.2126 * v(0) + 0.7152 * v(1) + 0.0722 * v(2);
}
const contrast = (a: number, b: number) => (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
const INK = '#10240f';
const mixBrand = (t: number) =>
  '#' + [0, 1, 2]
    .map((i) => Math.round(parseInt(brand!.slice(1 + i * 2, 3 + i * 2), 16) * t).toString(16).padStart(2, '0'))
    .join('');

const brandL = brand ? relLum(brand) : 0;
let brandInk = '#ffffff';
if (brand) brandInk = contrast(1, brandL) >= contrast(relLum(INK), brandL) ? '#ffffff' : INK;

let brandFill = brand ?? '#e60000';
if (brand && contrast(relLum(brandInk), brandL) < 4.5) {
  // Largest mix ratio whose fill still lets --brand-ink clear 4.5:1.
  let lo = 0, hi = 1;
  for (let i = 0; i < 24; i++) {
    const mid = (lo + hi) / 2;
    if (contrast(relLum(brandInk), relLum(mixBrand(mid))) >= 4.5) lo = mid; else hi = mid;
  }
  brandFill = mixBrand(lo);
}

let brandText = brand ?? '#e60000';
if (brand) {
  // The label pill's own surface: brand 8% + white. Brand text must clear
  // 4.6:1 on it (the tightest surface brand text sits on).
  const tintHex =
    '#' + [0, 1, 2]
      .map((i) => {
        const c = Math.round(parseInt(brand.slice(1 + i * 2, 3 + i * 2), 16) * 0.08 + 255 * 0.92);
        return c.toString(16).padStart(2, '0');
      })
      .join('');
  // Brand text also sits on --bg-alt (#f5f5f5) — whichever of that and the
  // tint is darker is the binding surface.
  const worstL = Math.min(relLum('#f5f5f5'), relLum(tintHex));
  const need = (worstL + 0.05) / 4.6 - 0.05;
  if (brandL > need) {
    let lo = 0, hi = 1;
    for (let i = 0; i < 24; i++) {
      const mid = (lo + hi) / 2;
      if (relLum(mixBrand(mid)) <= need) lo = mid; else hi = mid;
    }
    brandText = mixBrand(lo);
  }
}
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogTitle={data.ogTitle}
  ogDescription={data.ogDescription}
  ogType={data.ogType ?? 'article'}
  bodyClass="page-case-modular"
  jsonLd={jsonLd}
>
  <main
    class="case-page"
    style={brand ? `--brand: ${brand}; --brand-ink: ${brandInk}; --brand-fill: ${brandFill}; --brand-text: ${brandText};` : undefined}
  >
    {
      hero && (
        <CaseHero
          src={hero.src}
          alt={hero.alt}
          title={headline}
          tags={tags}
          style={hero.style}
          location={location}
          year={year}
        />
      )
    }

    <div class="case-body">
      {sections.map((s, i) => <CaseSection {...s} first={i === 0} />)}
      {client && <Credits client={client} roles={credits} />}

      <a class="case-back" href="/our-work/">
        <span class="arrow" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M11 6l-6 6 6 6" />
          </svg>
        </span>
        View all work
      </a>

      <PortfolioCTA />
    </div>
  </main>
</BaseLayout>
